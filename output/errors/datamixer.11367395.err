def find_sequence(n, k):
    if n == 0:
        return [0] * k
    powers_of_2 = [1]
    while 2 * powers_of_2[-1] <= n:
        powers_of_2.append(2 * powers_of_2[-1])
    powers_of_2 = powers_of_2[:-1]
    sequence = []
    for power in powers_of_2:
        if n >= power:
            sequence.append(power)
            n -= power
    return sequence + [0] * (k - len(sequence))
```
