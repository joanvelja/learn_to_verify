def spiral_moves(n):
    if n <= 0:
        return 0, 0
    layer = 1
    x = 0
    y = 0
    while n > 0:
        # Move in current layer
        for i in range(4):
            if n == 0:
                break
            x += layer * (i % 2) - layer * (i // 2)
            y += layer * (i // 2) - layer * (i % 2)
            n -= 1
        # Move to next layer
        layer += 1
        if n & 0x7 == 0:
            x += n // 8
            y += n // 8
            break
    return x, y
```
