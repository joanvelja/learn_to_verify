def count_solutions(a1, b1, a2, b2, L, R):
    def count_k(a1, b1, a2, b2, L, R):
        k_min = max(0, (L - b1 + a1 - 1) // (a1 - a2))
        k_max = min(R, (R - b2 + a1 - 1) // (a1 - a2))
        return k_max - k_min + 1

    def count_l(a1, b1, a2, b2, L, R):
        l_min = max(0, (L - b2 + b1) // (b1 - b2))
        l_max = min(R, (R - b1) // (b1 - b2))
        return l_max - l_min + 1

    return count_k(a1, b1, a2, b2, L, R) * count_l(a1, b1, a2, b2, L, R)
```
