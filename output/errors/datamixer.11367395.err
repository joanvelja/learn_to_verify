def nth_digit(k):
    n = 1
    while True:
        if n * (n + 1) // 2 * 9 < k:
            n += 1
        else:
            break
    position = k - (n * (n + 1) // 2 * 9)
    digit = n - 1 + (position - 1) // n
    return str(digit)[(position - 1) % n]
```
