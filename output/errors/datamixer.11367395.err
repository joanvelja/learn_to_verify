from math import gcd

def find_probability(n, k):
    mod = 10**6 + 3
    numerator = (2**n - k + 1) * k
    denominator = (2**n - 1) * k
    numerator = (numerator % mod) * pow(denominator, -1, mod)
    return (numerator % mod, denominator % mod)
