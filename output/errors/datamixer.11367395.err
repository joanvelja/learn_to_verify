def count_walls(field, row):
    return field[row].count("*")

def find_landing_spot(field):
    for i in range(len(field)):
        if count_walls(field, i) == 0:
            return i, field[i].index(".")

    for j in range(len(field[0])):
        if field[j].count("*") == 0:
            return field[j].index("*"), j

    return "NO"

