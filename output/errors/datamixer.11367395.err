<solution>
```python
def count_prefixes(s, x):
    n = len(s)
    balance = sum(1 for c in s if c == '0')
    count = 0

    if balance == x:
        count += 1

    left = 0
    for right in range(n):
        if s[right] == '0':
            balance += 1
        else:
            balance -= 1

        while balance > x:
            if s[left] == '0':
                balance -= 1
            else:
                balance += 1
            left += 1

        if balance == x or (balance < x and balance <= -1):
            count += 1

    return count

T = int(input())
for _ in range(T):
    n, x = map(int, input().split())
    s = input()
    print(count_prefixes(s, x))
```
</solution>


