    for i in range(1, n):
        if arr[i] == prev:
            return False
        elif arr[i] > prev:
            prev = arr[i]
        else:
            return False

    # Check for absent blocks
    if n == 2 or n == 3:
        return True

    # Check for a third block
    for i in range(2, n-1):
        if arr[i] != arr[i-1] and arr[i] != arr[i+1]:
            return False

    # Check for a third block with a single element
    if arr[-1] == arr[-2]:
        return False

    # Check for the first and last blocks
    for i in range(1, n-1):
        if arr[i] == arr[0] and arr[i] == arr[-1]:
            return False

    # If all checks pass, the array is unimodal
    return True

def main():
    n = int(input())
    arr = list(map(int, input().split()))
    if is_unimodal(arr):
        print("YES")
    else:
        print("NO")

