def divisors(n):
    if n in memo:
        return memo[n]
    memo[n] = len([i for i in range(1, n+1) if n % i == 0])
    return memo[n]

memo = {}

def calculate_sum(a, b, c):
    total = 0
    for i in range(1, a+1):
        for j in range(1, b+1):
            for k in range(1, c+1):
                total += divisors(i * j * k)
    return total % (2**30)

a, b, c = map(int, input().split())
print(calculate_sum(a, b, c))
```
