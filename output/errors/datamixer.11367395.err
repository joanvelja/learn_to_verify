def is_palindrome(time):
    hours, minutes = map(int, time.split(':'))
    return str(hours) == str(hours)[::-1] and str(minutes) == str(minutes)[::-1]

def min_sleep(time):
    hours, minutes = map(int, time.split(':'))
    current_time = f"{hours:02}:{minutes:02}"
    if is_palindrome(current_time):
        return 0
    else:
        min_minutes = 1
        while True:
            next_time = f"{hours:02}:{(minutes + min_minutes) % 60:02}"
            prev_time = f"{hours:02}:{(minutes - min_minutes) % 60:02}"
            if is_palindrome(next_time) or is_palindrome(prev_time):
                return min_minutes
            min_minutes += 1
```
