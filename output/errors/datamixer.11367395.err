import sympy

def find_primes(n):
    if n < 3:
        return None
    if n & 0x7 == 1:
        return [2]
    if n & 0x7 == 3:
        return [2, 3]
    primes = []
    for i in range(2, n):
        if n % i == 0:
            primes.append(i)
            n //= i
            break
    if len(primes) < 3:
        return None
    return primes

