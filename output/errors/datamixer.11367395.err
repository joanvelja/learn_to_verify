<solution>
```python
def maximize_painted_sections(n, q, painters):
    # Sort the painters by the left end of their section range
    painters.sort(key=lambda x: x[0])

    # Initialize variables for binary search
    low = 1
    high = n
    max_painted = 0

    while low <= high:
        mid = (low + high) // 2
        painted = 0
        for l, r in painters:
            if r >= mid:
                painted += 1
        if painted >= q - 2:
            max_painted = max(max_painted, painted)
            low = mid + 1
        else:
            high = mid - 1

    return max_painted

# Read input
n, q = map(int, input().split())
painters = []
for _ in range(q):
    l, r = map(int, input().split())
    painters.append((l, r))

# Print output
print(maximize_painted_sections(n, q, painters))
```
</solution>


