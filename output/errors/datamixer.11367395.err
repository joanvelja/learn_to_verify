def lucky_hours(x, hh, mm):
    lucky = 0
    for h in range(24):
        for m in range(60):
            time = f"{h:02d}:{m:02d}"
            if '7' in time:
                lucky += 1
    return lucky

def presses_needed(x, hh, mm):
    lucky_start = lucky_hours(x, hh, mm)
    lucky_end = lucky_hours(x, 0, 0)
    return max(0, lucky_start - lucky_end)

