```python
def convert_base(number, base):
    if base < 2:
        raise ValueError("Base must be at least 2")
    return int(number, base)

def compare_bases(x_digits, y_digits, x_base, y_base):
    x_decimal = convert_base(''.join(map(str, x_digits)), x_base)
    y_decimal = convert_base(''.join(map(str, y_digits)), y_base)
    return '>' if x_decimal > y_decimal else '<' if x_decimal < y_decimal else '='

def main():
    n, x_base = map(int, input().split())
    x_digits = list(map(int, input().split()))
    m, y_base = map(int, input().split())
