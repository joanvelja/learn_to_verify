<solution>
```python
def find_max_min_questions(n, m, k, x, y):
    if n == 1:
        return [k, k, 1]

    questions = [0] * (n * m)
    row = 0
    col = 0
    direction = 1
    count = 0
    for i in range(k):
        questions[row * m + col] += 1
        count += 1
        if col == m - 1:
            direction = -1
        elif col == 0:
            direction = 1
        if row == n - 1:
            direction = -direction
        row += direction
        col += 1
    return [max(questions), min(questions), count]

print(find_max_min_questions(4, 2, 9, 4, 2))
print(find_max_min_questions(5, 5, 25, 4, 3))
print(find_max_min_questions(100, 100, 1000000000000000000, 100, 100))
```
