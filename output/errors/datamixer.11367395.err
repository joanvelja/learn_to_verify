def max_lexicographic_matrix(n, k):
    if k > n * n:
        return -1

    # Fill the main diagonal with as many 1s as possible
    main_diagonal = [1] * min(n, k)
    k -= n
    n -= 1

    # Fill the rest of the matrix with zeroes
    matrix = [[0] * n for _ in range(n)]
    for i in range(n):
        for j in range(i + 1):
            if k > 0:
                matrix[i][j] = 1
                matrix[j][i] = 1
                k -= 1

    return matrix

