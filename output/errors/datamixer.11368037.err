def make_string(s):
    counts = {letter: 0 for letter in "abcdefghijklmnopqrstuvwxyz"}
    for letter in s:
        if letter not in counts:
            return "-1"
        counts[letter] += 1
    alphabet = ""
    for letter in "abcdefghijklmnopqrstuvwxyz":
        if counts[letter] > 0:
            alphabet += letter
            counts[letter] -= 1
    return alphabet
```
