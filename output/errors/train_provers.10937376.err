#include <algorithm>

int tram(int n, const std::vector<int>& ai, const std::vector<int>& bi) {
    int current_capacity = 0;
    int max_capacity = 0;

    for (int i = 0; i < n; ++i) {
        // Calculate the new capacity after the current stop
        current_capacity = std::max(0, current_capacity - ai[i] + bi[i]);
        // Update the maximum capacity
        max_capacity = std::max(max_capacity, current_capacity);
    }

    return max_capacity;
}

