    # Calculate (2^n - 1) / (2^n)
    prob_unique = Fraction(2**n - 1, 2**n)

    # Calculate (2^n - 1) / (2^n)^k
    prob_all_unique = prob_unique ** k

    # Probability of at least two people sharing a birthday
