def to12hourtime(time_str):
    hour = int(time_str[:2])
    minutes = int(time_str[2:])
    if hour == 12:
        suffix = "pm"
    elif hour > 12:
        hour -= 12
        suffix = "pm"
    else:
        suffix = "am"
    hour = str(hour + (hour == 12)).zfill(2)
    return f"{hour}:{minutes:02d} {suffix}"
```
