def longest_updown_subsegment(sequence):
    def find_longest_updown_subsegment(seq):
        if not seq:
            return 0
        if len(seq) == 1:
            return 1

        max_len = 1
        current_len = 1
        direction = None

        for i in range(1, len(seq)):
            if direction is None:
                if seq[i] >= seq[i-1]:
                    direction = 'up'
                elif seq[i] < seq[i-1]:
                    direction = 'down'
                current_len = 2
                max_len = max(max_len, current_len)
                continue

            if direction == 'up':
                if seq[i] >= seq[i-1]:
                    current_len += 1
                    max_len = max(max_len, current_len)
                else:
                    direction = 'down'
                    current_len = 2
            elif direction == 'down':
                if seq[i] < seq[i-1]:
                    current_len += 1
                    max_len = max(max_len, current_len)
                else:
                    direction = 'up'
                    current_len = 2

        return max_len

    if len(sequence) == 1:
        return 1

    original_len = find_longest_updown_subsegment(sequence)

    # Inserting before the start
    if len(sequence) % 2 == 1:
        max_len_before_insertion = max(original_len, find_longest_updown_subsegment(sequence[1:]))
    else:
        max_len_before_insertion = max(original_len, find_longest_updown_subsegment(sequence[1:]))

    # Inserting after the end
    if len(sequence) % 2 == 0:
        max_len_after_insertion = max(original_len, find_longest_updown_subsegment(sequence[:-1]))
    else:
        max_len_after_insertion = max(original_len, find_longest_updown_subsegment(sequence[:-1]))

    return max(max_len_before_insertion, max_len_after_insertion)

