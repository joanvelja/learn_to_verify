<solution>
```python
from typing import List

def min_diff(n: int, skills: List[int]) -> int:
    skills.sort()
    return abs(skills[n] - skills[n - 1])

def main():
    t = int(input())
    for _ in range(t):
        n = int(input())
        skills = list(map(int, input().split()))
        print(min_diff(n, skills))

if __name__ == "__main__":
    main()
```
