from collections import defaultdict

def dfs(graph, node, visited):
    visited[node] = True
    for neighbor in graph[node]:
        if not visited[neighbor]:
            dfs(graph, neighbor, visited)

def is_eulerian(graph):
    odd_count = 0
    for node in graph:
        if len(graph[node]) % 2 != 0:
            odd_count += 1
    return odd_count <= 2

def add_new_vertex(graph, n):
    new_vertex = n
    for node in graph:
        if len(graph[node]) % 2 != 0:
            graph[new_vertex].append(node)
            graph[node].append(new_vertex)
    return graph

def direct_edges(graph, n):
    if not is_eulerian(graph):
        graph = add_new_vertex(graph, n)
    visited = [False] * n
    for node in graph:
        if not visited[node]:
            dfs(graph, node, visited)
    return [visited[i] for i in range(n)]

T = int(input())
