from collections import defaultdict

def restore_array(arr, restrictions, K):
    MOD = 10**9 + 7

    # Count number of -1s
    count = arr.count(-1)
    if count > K:
        return 0

    # Create a graph for each -1
    graph = defaultdict(list)
    for L, R in restrictions:
        for i in range(L, R):
            graph[i].append(i + 1)
            graph[i + 1].append(i)

    # Perform DFS from each -1
    def dfs(node, path):
        if node == len(arr):
            return 1
        if arr[node] != -1:
            return dfs(node + 1, path)
        total = 0
        for next_node in graph[node]:
            if next_node not in path:
                total += dfs(next_node, path | {next_node})
        return total % MOD

    # Start DFS from each -1
    total = 0
    for i in range(len(arr)):
        if arr[i] == -1:
            total += dfs(i + 1, {i})
    return total % MOD

# Read input
T = int(input())
for _ in range(T):
    N, M, K = map(int, input().split())
    arr = list(map(int, input().split()))
    restrictions = []
    for _ in range(M):
        op, L, R = input().split()
        L, R = int(L), int(R)
        restrictions.append((L, R))

    # Restore array
    print(restore_array(arr, restrictions, K))
```
