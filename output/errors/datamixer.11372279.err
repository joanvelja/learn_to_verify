```python
import math

def largest_prime_factor(n):
    # Initialize largest prime factor
    largest_prime = -1

    # Divide n by 2 to remove all even factors
    while n % 2 == 0:
        largest_prime = 2
        n //= 2

    # Check for odd factors
    for i in range(3, int(math.sqrt(n)) + 1, 2):
        while n % i == 0:
            largest_prime = i
            n //= i

    # If n is a prime number greater than 2
    if n > 2:
        largest_prime = n

    return largest_prime

def prime_factor_occurrence_count(sequence):
    # Dictionary to store counts of each largest prime factor
    prime_factor_counts = {}

    for num in sequence:
        # Get the largest prime factor
        largest_factor = largest_prime_factor(num)

        # Update the count for this largest prime factor
        if largest_factor in prime_factor_counts:
            prime_factor_counts[largest_factor] += 1
        else:
            prime_factor_counts[largest_factor] = 1

    # Find the largest prime factor with maximum occurrences
    max_count = max(prime_factor_counts.values())
    max_factors = [factor for factor, count in prime_factor_counts.items() if count == max_count]

    # Return the largest among these factors
    return max(max_factors)

# Test the function
sequence = [3, 2, 15, 6, 8, 5, 10]
print(prime_factor_occurrence_count(sequence))  # Output: 5
```

