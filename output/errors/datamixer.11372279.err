import math

MOD = 10**9 + 7

def count_good_triplets(nums):
    # Precompute the logarithms of all numbers up to 10^9
    log_nums = [math.log2(num) if num > 0 else -1 for num in range(1, 10**9 + 1)]

    # Initialize the counter for good triplets
    count = 0

    # Iterate through all possible triplets
    for i in range(len(nums)):
        for j in range(i + 1, len(nums)):
            for k in range(j + 1, len(nums)):
                # Calculate the bitwise operation on the bitmasks
                bitmask1 = nums[i] << int(log_nums[nums[j]] + log_nums[nums[k]] + 2)
                bitmask2 = nums[j] << int(log_nums[nums[k]] + 1)
                bitmask3 = nums[k]

                # Check if the condition is met
                if (bitmask1 | bitmask2 | bitmask3).bit_count() % 2 == 1:
                    count += 1

    # Return the count modulo MOD
    return count % MOD
```
