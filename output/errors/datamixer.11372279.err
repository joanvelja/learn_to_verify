def calculate_time(temperatures):
    # Sort the temperatures to find the median
    temperatures.sort()

    # Calculate the median (middle value for odd-sized arrays, average of two middle values for even-sized arrays)
    n = len(temperatures)
    if n % 2 == 1:
        median = temperatures[n // 2]
    else:
        median = (temperatures[n // 2 - 1] + temperatures[n // 2]) / 2

    # Calculate the total time required to transform all temperatures to the median
    total_time = sum(abs(temp - median) for temp in temperatures)

    return total_time

# Example usage
temperatures = [1, 2, 3, 4, 5]
print(calculate_time(temperatures))  # Output: 5

temperatures = [5, 2, 3, 8]
print(calculate_time(temperatures))  # Output: 4

temperatures = [50, 53]
print(calculate_time(temperatures))  # Output: 1
```
