def gordon_shout(words):
    # Step 1: Capitalize all words
    words = [word.upper() for word in words.split()]

    # Step 2: Append '!!!!' to each word
    words = [word + '!!!!' for word in words]

    # Step 3: Replace 'A' with '@' and 'a' with '*'
    words = [word.replace('A', '@').replace('a', '*') for word in words]

    # Step 4: Handle vowels
    vowels = lambda length: ['E'] * (length - 1) + [chr(97 + (length - 2) % 6)]  # 6 vowels in total
    for i, word in enumerate(words):
        vowel_list = vowels(len(word))
        for vowel in vowel_list:
            words[i] = words[i].replace(vowel, '*')

    return ' '.join(words)

# Example usage
