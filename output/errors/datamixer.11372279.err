def jem_time(N, B, M):
    total_time = 0
    current_speed = M
    remaining_problems = N

    while remaining_problems > 0:
        # Calculate the number of problems to solve before the next break
        problems_before_break = (remaining_problems + 1) // 2

        # Add time for solving problems before the break
        total_time += problems_before_break * current_speed

        # Take a break
        total_time += B

        # Update remaining problems and current speed
        remaining_problems -= problems_before_break
        current_speed *= 2

    return total_time

