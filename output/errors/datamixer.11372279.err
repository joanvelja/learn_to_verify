```python
def knight_path(X):
    # Memoization dictionary to store previously computed results
    memo = {}

    def bfs(current, steps, jump):
        # If we've reached X, return the sequence of steps
        if current == X:
            return (steps, jump)

        # If we've already computed this result, return it
        if (current, steps, jump) in memo:
            return memo[(current, steps, jump)]

        # If we're at the end of a jump, try taking a step forward or backward
        if current == jump:
            result = bfs(current + 1, steps + 1, jump)
            if result is not None:
                return result

            result = bfs(current - 1, steps + 1, jump)
            if result is not None:
                return result

        # If we're not at the end of a jump, try jumping forward
        if current + jump > X:
            return None

        result = bfs(current + jump, steps + 1, jump)
        if result is not None:
            return result

        # If no solution is found, store the current result and return None
        memo[(current, steps, jump)] = None
        return None

    # Start BFS from position 1 with no jumps
    result = bfs(1, 0, 0)
    if result is None:
        return "0"

    # Convert the sequence of steps to a string
    steps, _ = result
    return "".join(map(str, steps))

# Example usage
print(knight_path(17))  # Output: 2111
print(knight_path(10))  # Output: 0
```
