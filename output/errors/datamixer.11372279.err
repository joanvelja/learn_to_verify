def count_road_signs(K):
    # Initialize a counter for the number of road signs
    count = 0
    # Initialize a modulo value to keep the numbers manageable
    mod = 10**9 + 7

    # Iterate through each number from 0 to 10^K-1
    for i in range(10**K):
        # Convert the number to a string for easier manipulation
        num_str = str(i)
        # Split the number into two parts
        left_part = num_str
        right_part = str(10**K - i - 1)

        # Combine the two parts
        combined_num = left_part + right_part

        # Convert the combined number back to a set of unique digits
        digits = set(combined_num)

        # If there are exactly two distinct digits, increment the counter
        if len(digits) == 2:
            count += 1
            count %= mod

    return count

# Test the function
print(count_road_signs(1))  # Expected output: 10
```...
