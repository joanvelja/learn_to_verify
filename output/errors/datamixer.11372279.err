def build_tree(parents):
    tree = {i: [] for i in range(1, len(parents) + 1)}
    for i in range(1, len(parents)):
        tree[parents[i]].append(i + 1)
    return tree

def calculate_cost(tree, values):
    costs = [0] * (len(values) + 1)
    for i in range(len(values), 0, -1):
        costs[i] = values[i - 1]
        for child in tree[i]:
            costs[i] = min(costs[i], costs[child])
    return costs[1:]

N = int(input())
parents = list(map(int, input().split()))
values = list(map(int, input().split()))

tree = build_tree(parents)
costs = calculate_cost(tree, values)

print(*costs)
