from math import gcd

def gcd_sequence(N, A):
    A = A + A[:1]  # Make it circular
    dp = [[0] * (N + 1) for _ in range(N + 1)]

    for i in range(2, N + 1):
        dp[i][1] = 1

    for i in range(2, N + 1):
        for j in range(2, i):
            dp[i][j] = dp[i - 1][j - 1] if gcd(A[i - 1], A[i]) != 1 else dp[i - 1][j - 1] + 1

    return [dp[N][k] for k in range(2, N + 1)]

# Example usage:
print(gcd_sequence(5, [3, 6, 4, 5, 9]))
```

