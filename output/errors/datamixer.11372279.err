def shanky_traverse(s):
    encountered = set()
    for char in s:
        if char not in encountered:
            encountered.add(char)
            return char
    return None

def anku_traverse(s):
    encountered = set()
    for char in reversed(s):
        if char not in encountered:
            encountered.add(char)
            return char
    return None

def game_winner(s):
    shanky_char = shanky_traverse(s)
    anku_char = anku_traverse(s)

    if shanky_char is None or anku_char is None:
        return "PANDEY"

    if ord(shanky_char) > ord(anku_char):
        return "SHANKY"
    elif ord(shanky_char) < ord(anku_char):
        return "ANKU"
    else:
        return "PANDEY"

# Test cases
test_cases = ["google", "breakraekb", "aman"]

for s in test_cases:
    print(game_winner(s))
```

