            for j in range(1, K+1):
                if j == dp[i-1][j-1] + 1:  # Increasing pattern
                    dp[i][j] += dp[i-1][j-1]
                elif j == dp[i-1][j+1] - 1:  # Decreasing pattern
                    dp[i][j] += dp[i-1][j+1]

    # Sum up all valid sequences ending at K
    result = sum(dp[N])
    return result % (10**9 + 7)
```

