class TreeNode:
    def __init__(self, wealth, manager):
        self.wealth = wealth
        self.manager = manager
        self.subordinates = []

def build_tree(wealths, managers):
    root = None
    for i in range(len(wealths)):
        node = TreeNode(wealths[i], managers[i])
        if managers[i] == -1:
            root = node
        else:
            manager = managers[i]
            parent = get_node(manager, root)
            parent.subordinates.append(node)
    return root

def get_node(manager, root):
    if root.manager == manager:
        return root
    for sub in root.subordinates:
        found = get_node(manager, sub)
        if found:
            return found
    return None

def dfs(node, max_diff):
    if not node.subordinates:
        return max_diff
    for sub in node.subordinates:
        max_diff = max(max_diff, node.wealth - sub.wealth)
        max_diff = dfs(sub, max_diff)
    return max_diff

def find_max_wealth_difference(wealths, managers):
    root = build_tree(wealths, managers)
    max_diff = dfs(root, 0)
    return max_diff

# Test data
n = 4
wealths = [5, 10, 6, 12]
managers = [2, -1, 4, 2]

print(find_max_wealth_difference(wealths, managers))  # Output: 6
```
</code>

