from collections import defaultdict, deque

def shortestAlternatingPaths(n, red_edges, blue_edges):
    red_graph = defaultdict(list)
    blue_graph = defaultdict(list)
    for u, v in red_edges:
        red_graph[u].append(v)
    for u, v in blue_edges:
        blue_graph[u].append(v)

    # Initialize distances and visited arrays
    distances = [[float('inf') for _ in range(2)] for _ in range(n)]
    distances[0][0] = 0
    distances[0][1] = 0

    # Initialize BFS queue
    queue = deque([(0, 0), (0, 1)])

    while queue:
        node, color = queue.popleft()
        for neighbor in (red_graph if color else blue_graph)[node]:
            if distances[neighbor][color ^ 1] == float('inf'):
