def minPushBox(grid):
    m, n = len(grid), len(grid[0])
    directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]
    visited = set()

    def in_bounds(x, y):
        return 0 <= x < m and 0 <= y < n

    def get_neighbors(x, y, bx, by):
        neighbors = []
        for dx, dy in directions:
            nx, ny = x + dx, y + dy
            if in_bounds(nx, ny) and grid[nx][ny] != '#' and (nx, ny) != (bx, by):
                neighbors.append((nx, ny))
        return neighbors

    def bfs():
        queue = deque([(bx, by, px, py, 0)])
        visited.add((bx, by, px, py))

        while queue:
            bx, by, px, py, steps = queue.popleft()

            if (bx, by) == (tx, ty):
                return steps

            for nx, ny in get_neighbors(px, py, bx, by):
                if (nx, ny, bx, by) not in visited:
                    visited.add((nx, ny, bx, by))
                    queue.append((bx, by, nx, ny, steps + 1))

        return -1

