```python
def validate_solution(solution):
    # Check if each player plays exactly once every day
    players = set()
    for day in solution:
        for group in day:
            players.update(group)

    # Check if each player appears exactly once in each day
    for day in solution:
        for group in day:
            if len(group) != len(set(group)):
                return False

    # Check if each pair of players appears at most once in the solution
    for day in solution:
        for i in range(len(day)):
            for j in range(i+1, len(day)):
                for player1 in day[i]:
                    for player2 in day[j]:
                        if player1 != player2 and player2 in day[i]:
                            return False

    return True

# Example usage
solution = [
    ['ABCD', 'EFGH', 'IJKL', 'MNOP', 'QRST'],
    ['AEIM', 'BJOQ', 'CHNT', 'DGLS', 'FKPR'],
    ['AGKO', 'BIPT', 'CFMS', 'DHJR', 'ELNQ'],
    ['AHLP', 'BKNS', 'CEOR', 'DFIQ', 'GJMT'],
    ['AFJN', 'BLMR', 'CGPQ', 'DEKT', 'HIOS']
]

print(validate_solution(solution))  # Output: True
```

