```python
def is_k_balanced(bitstring, k):
    # Check if a bitstring is k-balanced
    count = [0, 0]
    for i in range(k):
        count[int(bitstring[i])] += 1
    if count[0] == count[1]:
        return True
    return False

def can_make_k_balanced(s, k):
    n = len(s)
    for i in range(n):
        if s[i] == '?':
            # Try filling with 0
            s_new = s[:i] + '0' + s[i+1:]
            if is_k_balanced(s_new, k):
                return True
            # Try filling with 1
            s_new = s[:i] + '1' + s[i+1:]
            if is_k_balanced(s_new, k):
                return True
    return False

def solve(t):
    for _ in range(t):
        n, k = map(int, input().split())
        s = input()
        if can_make_k_balanced(s, k):
            print("YES")
        else:
            print("NO")

t = int(input())
solve(t)
```
