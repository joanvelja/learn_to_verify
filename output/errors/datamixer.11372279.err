def milk_drinking_problem(n, m, k, jars):
    # Find the maximum amount of milk in any jar
    max_milk = max(jars)

    # Initialize the total amount of milk Sir Jadeja will get
    total_milk = 0

    # Iterate through all jars
    for jar in jars:
        # If the jar has less than k litres of milk or Dhoni has already drunk more than m times from this jar
        if jar < k or jars.count(jar) > m:
            # Sir Jadeja drinks all the milk left in this jar
            total_milk += jar
        else:
            # Otherwise, Dhoni drinks exactly k litres of milk from this jar
            total_milk += k

    # Return the total amount of milk modulo 1,000,000,007
    return total_milk % 1000000007

# Test the function with the provided example
n = 3
m = 3
k = 3
jars = [15, 8, 10]
print(milk_drinking_problem(n, m, k, jars))  # Output: 9
```

