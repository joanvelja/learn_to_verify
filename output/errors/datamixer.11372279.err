def check_if_can_break(s1, s2):
    # Sort both strings
    s1 = sorted(s1)
    s2 = sorted(s2)

    # Check if s1 can break s2 or vice versa
    for i in range(len(s1)):
        if s1[i] < s2[i]:
            return False
    return True
