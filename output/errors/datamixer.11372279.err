def max_expression_value(expression):
    # Convert the expression string to a list of integers and operators
    operands = []
    operators = []
    i = 0
    while i < len(expression):
        if expression[i] in ['&', '|', '^']:
            operators.append(expression[i])
            i += 1
        else:
            operand = int(expression[i])
            operands.append(operand)
            i += 1

    # Perform XORs first
    for i in range(len(operands)):
        if operators[i] == '^':
            operands[i] ^= operands[i+1]
            del operands[i+1]
            del operators[i]

    # Perform ORs next
    for i in range(len(operands)):
        if operators[i] == '|':
            operands[i] |= operands[i+1]
            del operands[i+1]
            del operators[i]

    # Perform ANDs last
    for i in range(len(operands)):
        if operators[i] == '&':
            operands[i] &= operands[i+1]
            del operands[i+1]
            del operators[i]

    # Return the maximum value
    return operands[0]

# Test cases
print(max_expression_value("3^40|10^2"))  # Expected: 43
print(max_expression_value("92^95|56&2&3"))  # Expected: 95
```

