```python
import re

def eight_bit_signed_number(s):
    # Validate the format using regex
    if not re.match(r'^-?\d{1,3}$', s):
        return False
    # Convert the string to integer and check the range
    n = int(s)
    return -128 <= n <= 127
```

```javascript
function eightBitSignedNumber(s) {
    // Validate the format using regex
    if (!/^(-?\d{1,3})$/.test(s)) {
        return false;
    }
    // Convert the string to integer and check the range
    let n = parseInt(s);
    return -128 <= n && n <= 127;
}
```

```java
import java.util.regex.*;

public class StringUtils {
    public static boolean isSignedEightBitNumber(String s) {
        // Validate the format using regex
        Pattern pattern = Pattern.compile("^-?\\d{1,3}$");
        Matcher matcher = pattern.matcher(s);
        if (!matcher.find()) {
            return false;
        }
        // Convert the string to integer and check the range
        int n = Integer.parseInt(s);
        return n >= -128 && n <= 127;
    }
}
```

