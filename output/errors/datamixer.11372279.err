The output should be a single integer representing the minimum time taken to send all of Santa's presents.
```
import heapq

def min_time_to_send_presents(n, m, a, b):
    # Create a priority queue for presents with higher numbers
    pq = []
    for i in range(n):
        heapq.heappush(pq, -a[i])

    # Create a list for reordered presents
    reordered_presents = []

    # Iterate through Santa's list of presents
    for i in range(m):
        # Get present number from Santa's list
        present_number = b[i]

        # Pop present from priority queue
        present = -heapq.heappop(pq)

        # Calculate number of presents above present
        above_presents = n - present_number

        # Add present to reordered list
        reordered_presents.append((present, above_presents))

    # Calculate total time taken
    total_time = 0
    for i in range(m):
        # Get present and number of presents above it
        present, above_presents = reordered_presents[i]

        # Add time taken to send present to total time
        total_time += 2 * above_presents + 1

    return total_time

# Read input
t = int(input())
for i in range(t):
    n, m = map(int, input().split())
    a = list(map(int, input().split()))
    b = list(map(int, input().split()))

    # Calculate minimum time taken
    min_time = min_time_to_send_presents(n, m, a, b)

    # Print output
    print(min_time)
```
This is a Python solution for Santa's present delivery problem. It uses a priority queue to keep track of presents with higher numbers, simulates sending presents, and calculates minimum time taken to send all of Santa's presents.
