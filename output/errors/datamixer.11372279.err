def largest_square_subboard(board, ci):
    N, M = len(board), len(board[0])
    dp = [[[0, 0] for _ in range(M + 1)] for _ in range(N + 1)]

    for i in range(1, N + 1):
        for j in range(1, M + 1):
            dp[i][j][0] = dp[i][j-1][0] + (1 if board[i-1][j-1] == '1' else 0)
            dp[i][j][1] = dp[i-1][j][1] + (1 if board[i-1][j-1] == '0' else 0)

    max_size = 0
    for i in range(N, 0, -1):
        for j in range(M, 0, -1):
            size = min(i, j)
            while size > 0 and dp[i][j][0] >= size and dp[i][j][1] >= size:
                if dp[i-size+1][j][0] >= size and dp[i][j-size+1][1] >= size:
                    max_size = max(max_size, size)
                    break
                size -= 1

    return max_size

def main():
    N, M = map(int, input().split())
    board = [input() for _ in range(N)]
    Q = int(input())
    ci = list(map(int, input().split()))

    for c in ci:
        print(largest_square_subboard(board, c))

if __name__ == "__main__":
    main()
