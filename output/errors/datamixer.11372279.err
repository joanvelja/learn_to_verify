from itertools import combinations

def prod2sum(a, b, c, d):
    def sum_of_squares(x, y):
        return x**2 + y**2

    def decompose(n):
        for i in range(int(n**0.5) + 1):
            if n - i**2 >= 0:
                j = int((n - i**2)**0.5)
                if i**2 + j**2 == n:
                    return [i, j]
        return None

    # Calculate all possible combinations of a and b, and c and d
    combinations = [(i, j) for i in range(a + 1) for j in range(b + 1)] + \
                   [(i, j) for i in range(c + 1) for j in range(d + 1)]

    # Multiply these combinations and decompose the resulting product
    results = []
    for i, j in combinations:
        for k, l in combinations:
            n = (i * k + j * l) * (i * k + j * l)
            result = decompose(n)
            if result:
                results.append(result)

    # Sort the results and return them
    return sorted(results, key=lambda x: x[0])

