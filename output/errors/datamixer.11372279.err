            elif char == 'E':
                if cells[cell_ptr] != 0:
                    cell_ptr = stack.pop()
                else:
                    continue
            elif char == 'P':
                print(chr(cells[cell_ptr]))
            elif char == 'N':
                print(cells[cell_ptr])
            elif char == 'T':
                cells[cell_ptr] = (cells[cell_ptr] * 2) % 256
            elif char == 'Q':
                cells[cell_ptr] = (cells[cell_ptr] ** 2) % 256
            elif char == 'U':
                cells[cell_ptr] = int(cells[cell_ptr] ** 0.5)
            elif char == 'L':
                cells[cell_ptr] = (cells[cell_ptr] + 2) % 256
            elif char == 'I':
                cells[cell_ptr] = (cells[cell_ptr] - 2) % 256
            elif char == 'V':
                cells[cell_ptr] = (cells[cell_ptr] // 2) % 256
            elif char == 'A':
                cells[cell_ptr] = (cells[cell_ptr] + stack[-1]) % 256
            elif char == 'B':
                cells[cell_ptr] = (cells[cell_ptr] - stack[-1]) % 256
            elif char == 'Y':
                cells[cell_ptr] = (cells[cell_ptr] * stack[-1]) % 256
            elif char == 'D':
                cells[cell_ptr] = (cells[cell_ptr] // stack[-1]) % 256
