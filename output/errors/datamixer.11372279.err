def min_height_difference(trees, k):
    # Sort the trees by height using Timsort
    trees.sort(key=lambda x: x, cmp=lambda a, b: a - b)

    # Calculate the average height of the K trees
    target_height = sum(trees[:k]) / k

    # Find the first group of K trees with a sum of heights greater than or equal to target height
    total = 0
    for i in range(len(trees)):
        total += trees[i]
        if total >= target_height * k:
            break

    # The difference between the tallest and shortest trees in this group is the answer
    return trees[i] - trees[i - k + 1]
```
