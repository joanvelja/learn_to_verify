class WordProblem:
    def __init__(self, rules: List[Tuple[str, str]], limit: int):
        self.rules = rules
        self.limit = limit

    def apply_rules(self, string: str) -> str:
        for _ in range(self.limit):
            new_string = string
            for rule in self.rules:
                new_string = new_string.replace(rule[0], rule[1])
                if new_string != string:
                    string = new_string
                    break
        return string

    def is_derived(self, start: str, end: str) -> bool:
        """
        Check if a string can be derived from another using the rules and the application limit.
        """
        return self.apply_rules(start) == end

# Example usage:
