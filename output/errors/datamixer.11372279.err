import re

def poohbear(code):
    # Initialize the list of cells and the cell pointer
    cells = [0] * 30000
    cell_ptr = 0

    # Initialize the stack for handling loops
    stack = []

    # Regular expression to filter out non-command characters
    command_pattern = re.compile('[+\\-<>cpeWENPTQULIDYDVAB]')

    # Interpret the code
    for char in code:
        if command_pattern.match(char):
            if char == '+':
                cells[cell_ptr] = (cells[cell_ptr] + 1) % 256
            elif char == '-':
                cells[cell_ptr] = (cells[cell_ptr] - 1) % 256
            elif char == '>':
