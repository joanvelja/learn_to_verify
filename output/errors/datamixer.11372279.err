```python
def maximumGap(nums):
    # Sort the array in non-decreasing order
    nums.sort()

    # Initialize a variable to store the maximum difference
    max_diff = 0

    # Iterate through adjacent elements and compute their difference
    for i in range(len(nums) - 1):
        diff = abs(nums[i] - nums[i + 1])
        if diff > max_diff:
            max_diff = diff

    return max_diff
```
