print(is_isogram("aba"))  # false
print(is_isogram("moOse"))  # false
```

```c
#include <string.h>

bool is_isogram(char *str) {
    int len = strlen(str);
    int seen[26] = {0};
    for (int i = 0; i < len; i++) {
        char c = tolower(str[i]);
        if (seen[c - 'a'] == 1) return false;
        seen[c - 'a'] = 1;
    }
    return true;
}

// Test cases
printf("%d\n", is_isogram("Dermatoglyphics"));  // 1 (true)
printf("%d\n", is_isogram("aba"));  // 0 (false)
printf("%d\n", is_isogram("moOse"));  // 0 (false)
```
