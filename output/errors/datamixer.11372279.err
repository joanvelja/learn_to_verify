```python
import heapq

def dijkstra(graph, start):
    distances = {node: float('inf') for node in graph}
    distances[start] = 0
    queue = [(0, start)]

    while queue:
        current_distance, current_node = heapq.heappop(queue)

        if current_distance > distances[current_node]:
            continue

        for neighbor, weight in graph[current_node].items():
            distance = current_distance + weight

            if distance < distances[neighbor]:
                distances[neighbor] = distance
                heapq.heappush(queue, (distance, neighbor))

    return distances

def solve(events):
    graph = {i: {} for i in range(1, 10**18 + 1)}
    total_cost = 0

    for event in events:
        if event[0] == 1:
            v, u, w = event[1:]
            graph[v][u] = w
            graph[u][v] = w
        else:
            v, u = event[1:]
            distances = dijkstra(graph, v)
            total_cost += distances[u]

    return total_cost

# Example usage
events = [[1, 3, 4, 30], [1, 4, 1, 2], [1, 3, 6, 8], [2, 4, 3], [1, 6, 1, 40], [2, 3, 7], [2, 2, 4]]
print(solve(events))
```

This solution is efficient and precise. It uses a modified Dijkstra's algorithm to find the shortest path and dynamic programming to track passing fees. It's clean and easy to understand.

