def countArrangement(N):
    def dfs(position, used):
        if position == N + 1:
            return 1
        count = 0
        for num in range(1, N + 1):
            if not used[num] and (num % position == 0 or position % num == 0):
                used[num] = True
                count += dfs(position + 1, used)
                used[num] = False
        return count

    return dfs(1, [False] * (N + 1)) * 2

```
