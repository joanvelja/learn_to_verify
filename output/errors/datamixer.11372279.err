from math import sqrt

def prime_factors(n):
    factors = {}
    while n % 2 == 0:
        factors[2] = factors.get(2, 0) + 1
        n //= 2
    for i in range(3, int(sqrt(n)) + 1, 2):
        while n % i == 0:
            factors[i] = factors.get(i, 0) + 1
            n //= i
    if n > 2:
        factors[n] = factors.get(n, 0) + 1
    return factors

def find_p(X):
    factors = prime_factors(X)
    max_p = 1
    for p, e in factors.items():
        max_p = max(max_p, p**e)
    if sqrt(max_p).is_integer():
        return None
    else:
        return int(sqrt(max_p))

def is_honest_solution_used(X):
    return find_p(X) is None

