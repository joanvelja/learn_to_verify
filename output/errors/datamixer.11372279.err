class VigenereCipher:
    def __init__(self, key, alphabet):
        self.key = key
        self.alphabet = alphabet

    def encode(self, text):
        encoded_text = []
        key_index = 0
        for char in text:
            if char in self.alphabet:
                shift = (self.alphabet.index(self.key[key_index]) + 1) % len(self.alphabet)
                new_index = (self.alphabet.index(char) + shift) % len(self.alphabet)
                encoded_text.append(self.alphabet[new_index])
                key_index = (key_index + 1) % len(self.key)
            else:
                encoded_text.append(char)
        return ''.join(encoded_text)

    def decode(self, text):
        decoded_text = []
        key_index = 0
        for char in text:
            if char in self.alphabet:
                shift = (self.alphabet.index(self.key[key_index]) + 1) % len(self.alphabet)
                original_index = (self.alphabet.index(char) - shift) % len(self.alphabet)
                decoded_text.append(self.alphabet[original_index])
                key_index = (key_index + 1) % len(self.key)
            else:
                decoded_text.append(char)
        return ''.join(decoded_text)
