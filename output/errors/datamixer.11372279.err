      if (fuelOptions[fuel] <= 11) {
        numIngots -= 1;
        fuelNeeded[fuel] += 1;
      }
    }

    for (const fuel in fuelOptions) {
      if (fuelOptions[fuel] > 11) {
        if (fuelNeeded[fuel] > 0) {
          numIngots -= 1;
          fuelNeeded[fuel] -= 1;
        }
      }
    }
  }

  return fuelNeeded;
}
```

