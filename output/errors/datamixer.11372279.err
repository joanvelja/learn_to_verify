def find_luxurious_floors(houses):
    max_floors = 0
    luxurious_floors = []

    for i in range(len(houses) - 1, -1, -1):
        if houses[i] > max_floors:
            max_floors = houses[i]

        luxurious_floors.append(max_floors - houses[i])

    return luxurious_floors[::-1]
