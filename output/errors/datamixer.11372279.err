```python
class Node:
    def __init__(self, data):
        self.data = data
        self.next = None

def push(head, data):
    new_node = Node(data)
    new_node.next = head
    return new_node

def buildOneTwoThree():
    return push(push(None, 3), 2), 1

def getNth(head, index):
    if head is None:
        raise ValueError("List is empty")
    current = head
    for _ in range(index):
        if current.next is None:
            raise ValueError("Index out of range")
        current = current.next
    return current

# Example usage
head = buildOneTwoThree()[0]
print(getNth(head, 1).data)  # Should print 2
print(getNth(head, 0).data)  # Should print 3
try:
    print(getNth(head, 3).data)  # Should throw an exception
except ValueError as e:
    print(e)  # Should print "Index out of range"
```

