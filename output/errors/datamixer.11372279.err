import math

# Constants
MAX = 1000000
PRIME_LIMIT = 100

# Prime numbers up to 100
primes = [2] + [p for p in range(3, MAX + 1, 2) if all(p % i != 0 for i in range(3, int(math.sqrt(p)) + 1, 2))]

# Prime factorization table
prime_factors = [[0] * PRIME_LIMIT for _ in range(MAX + 1)]

# Build prime factorization table
for p in primes:
    for i in range(p, MAX + 1, p):
        prime_factors[i][p - 2] += 1

# Sparse table for prime factorization
sparse_table = [[0] * (int(math.log2(MAX)) + 1) for _ in range(MAX + 1)]
for i in range(1, MAX + 1):
    sparse_table[i][0] = prime_factors[i]
    for j in range(1, int(math.log2(MAX)) + 1):
        sparse_table[i][j] = [a + b for a, b in zip(sparse_table[i][j - 1], sparse_table[i // (2 ** j)][j - 1])]

# Query range
def query_range(l, r):
    if l == r:
        return True
    if l > r:
        return False
    diff = r - l + 1
    level = int(math.log2(diff))
    left_prime_factors = sparse_table[l][level]
    right_prime_factors = sparse_table[r - (2 ** level) + 1][level]
    return all(x % 2 == 0 for x in left_prime_factors + right_prime_factors)

# Update range
def update_range(i, val):
    for p in primes:
        if val % p == 0:
            prime_factors[i][p - 2] += 1
            while val % p == 0:
                val //= p
            if val == 1:
                break

# Input
N = int(input())
A = list(map(int, input().split()))
Q = int(input())
queries = [list(map(int, input().split())) for _ in range(Q)]

# Process queries
for q in queries:
