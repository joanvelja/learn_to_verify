def mincostTickets(days, costs):
    dp = [0] * (days[-1] + 1)
    last_day = days[0] - 1
    for i in range(1, len(dp)):
        if i <= last_day:
            dp[i] = dp[i - 1]
            continue

        min_cost = dp[i - 1] + costs[0]
        if i - 7 >= 0:
            min_cost = min(min_cost, dp[i - 7] + costs[1])
        if i - 30 >= 0:
            min_cost = min(min_cost, dp[i - 30] + costs[2])

        dp[i] = min_cost
        last_day = days[-1] if i == days[-1] else days[bisect_left(days, i)] - 1
    return dp[-1]
```
