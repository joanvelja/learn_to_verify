```python
def sum_arrays(arr1, arr2):
    # Check for empty arrays
    if not arr1 and not arr2:
        return []
    if not arr1:
        arr1 = [0]
    if not arr2:
        arr2 = [0]

    # Convert strings to integers
    num1 = int(''.join(map(str, arr1)))
    num2 = int(''.join(map(str, arr2)))

    # Perform the addition
    result = num1 + num2

    # Convert the result back to a list of integers
    return [int(x) for x in str(abs(result))] + ([int(str(result)[0])] if result < 0 else [])
```

And here's how I'd do it in Javascript:
```javascript
function sumArrays(arr1, arr2) {
    // Check for empty arrays
    if (!arr1 && !arr2) {
        return [];
    }
    if (!arr1) {
        arr1 = [0];
    }
    if (!arr2) {
        arr2 = [0];
    }

    // Convert strings to integers
    var num1 = parseInt(arr1.join(''), 10);
    var num2 = parseInt(arr2.join(''), 10);

    // Perform the addition
    var result = num1 + num2;

    // Convert the result back to a list of integers
    return Array.from(String(Math.abs(result)), Number).concat([result < 0 ? parseInt(String(result)[0]) : 0]);
}
