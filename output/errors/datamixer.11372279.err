class Solution:
    def countNodes(self, root):
        if not root:
            return 0

        def isComplete(root, height, max_height):
            if not root:
                return True
            if height == max_height:
                return True
            return isComplete(root.left, height+1, max_height) and isComplete(root.right, height+1, max_height)

        def countNodes(root):
            if not root:
                return 0
            if isComplete(root.left, 0, self.max_height):
                return 2**(self.max_height+1) - 1
            return 1 + countNodes(root.left) + countNodes(root.right)

        self.max_height = 0
        def getHeight(root):
            if not root:
                return 0
            return 1 + max(getHeight(root.left), getHeight(root.right))
        self.max_height = getHeight(root)

        return countNodes(root)
