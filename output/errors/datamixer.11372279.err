def find_same_height_plants(N, heights):
    for i in range(N-1):
        if heights[i] != heights[i+1]:
            return i+1  # Return the minimum number of hours (i+1)
    return -1  # If all plants are of the same height, return -1

T = int(input())
for _ in range(T):
    N = int(input())
    heights = list(map(int, input().split()))
    print(find_same_height_plants(N, heights))
```
</code>

