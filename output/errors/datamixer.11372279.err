```python
def min_sparrows(n, m, k, classes, links):
    # Convert classes to a graph
    graph = [[] for _ in range(n)]
    for u, v in links:
        graph[u-1].append(v-1)
        graph[v-1].append(u-1)

    # Initialize the cover
    cover = set()
    for i in range(n):
        if i not in cover:
            cover.add(i)
            for neighbor in graph[i]:
                if neighbor not in cover:
                    cover.add(neighbor)

    # Count the number of classes covered by sparrows
    covered_classes = set()
    for i in range(n):
        if i in cover:
            covered_classes.add(classes[i]-1)

    # If all classes are covered, return the number of sparrows
    if len(covered_classes) == k:
        return len(cover)
    else:
        return -1

# Example usage
n = 5
m = 4
k = 3
classes = [1, 1, 2, 2, 3]
links = [(1, 2), (1, 3), (2, 4), (2, 5)]
print(min_sparrows(n, m, k, classes, links))  # Output: 3
```
