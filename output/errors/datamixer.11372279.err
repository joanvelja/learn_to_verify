def maximumGap(nums):
    if len(nums) < 2:
        return 0

    # Find min and max values in nums to determine range
    min_val = min(nums)
    max_val = max(nums)

    # Initialize bucket arrays for storing values and gaps between buckets
    buckets = [[None] * 3 for _ in range(max_val - min_val + 2)]
    gaps = [max_val - min_val + 2] * (max_val - min_val + 3)

    # Iterate through nums and distribute values into buckets
    for num in nums:
        bucket_index = num - min_val + 1

        if buckets[bucket_index][0] is None:
            buckets[bucket_index][0] = num
            buckets[bucket_index][1] = num
        else:
            buckets[bucket_index][0] = min(buckets[bucket_index][0], num)
            buckets[bucket_index][1] = max(buckets[bucket_index][1], num)

        # Update gaps between buckets based on current bucket's values
        if bucket_index > 0:
            gaps[bucket_index - 1] = min(gaps[bucket_index - 1], buckets[bucket_index][0] - buckets[bucket_index - 1][1])
        if bucket_index < len(gaps) - 2:
            gaps[bucket_index + 1] = min(gaps[bucket_index + 1], buckets[bucket_index + 2][0] - buckets[bucket_index][1])

    # Find maximum gap among gaps between non-empty buckets
    max_gap = max(gaps)

    return max_gap
```
