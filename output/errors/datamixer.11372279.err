class Game:
    def __init__(self, board):
        self.board = board
        self.lines = set()
        self.completed_squares = 0
        self.squares_to_complete = board * board

    def play(self, lines):
        self.lines.update(lines)
        self.lines = sorted(self.lines)
        self.completed_squares = 0
        self.squares_to_complete = self.board * self.board

        while self.squares_to_complete > 0:
            for line in range(1, (self.board * self.board) + 1):
                if line not in self.lines:
                    if self.is_square_complete(line):
                        self.lines.add(line)
                        self.completed_squares += 1
                        self.squares_to_complete -= 1
        return sorted(list(self.lines))

    def is_square_complete(self, line):
        # Check if the square is complete
        if line in self.lines:
            return False
        x, y = divmod(line - 1, self.board)
        # Check all 4 sides of the square
        return all(
            (
                (x, y + 1) in self.lines,
                (x + 1, y) in self.lines,
                (x + 1, y + 1) in self.lines,
                (x, y) in self.lines,
            )
        ) and line != (self.board * self.board) // 2 + 1
