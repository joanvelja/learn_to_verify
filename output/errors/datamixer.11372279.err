    "X---X---X\n"
    "-X--X--X-\n"
    "--X-X-X--\n"
    "---XXX---\n"
    "XXXXXXXXX\n"
    "---XXX---\n"
    "--X-X-X--\n"
    "-X--X--X-\n"
    "X---X---X"
)
assert union_jack(10) == (
    "X---XX---X\n"
    "-X--XX--X-\n"
    "--X-XX-X--\n"
    "---XXXX---\n"
    "XXXXXXXXXX\n"
    "XXXXXXXXXX\n"
    "---XXXX---\n"
    "-X--XX--X-\n"
    "-X-X-X-X--\n"
    "X---XX---X"
)
assert union_jack(1) == (
    "X--X--X\n"
    "-X-X-X-\n"
    "--XXX--\n"
    "XXXXXXX\n"
    "--XXX--\n"
    "-X-X-X-\n"
    "X--X--X"
)
assert union_jack('string') == False
```

