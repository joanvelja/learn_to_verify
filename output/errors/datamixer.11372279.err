def is_prime(n):
    if n <= 1:
        return False
    for i in range(2, int(n**0.5) + 1):
        if n % i == 0:
            return False
    return True

def longest_subsequence(A):
    n = len(A)
    dp = [1] * n
    for i in range(n):
        for j in range(i):
            if abs(A[i] - A[j]) > 1 and is_prime(abs(A[i] - A[j])):
                dp[i] = max(dp[i], dp[j] + 1)
    return max(dp)
