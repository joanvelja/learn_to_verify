```python
def waiting_days(arr):
    result = []
    stack = []

    for i in range(len(arr)):
        while stack and arr[i] > arr[stack[-1]]:
            idx = stack.pop()
            result.append(i - idx)
        stack.append(i)

    result.extend([0] * len(arr) - len(stack))
    return result
```

