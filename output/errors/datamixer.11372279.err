```python
def calculate_segment_product(arr, left, right, mod):
    prefix_products = [0] * (len(arr) + 1)
    prefix_products[0] = 1
    for i in range(1, len(arr) + 1):
        prefix_products[i] = (prefix_products[i - 1] * arr[i - 1]) % mod

    segment_product = (prefix_products[right] * pow(prefix_products[left - 1], mod - 2, mod)) % mod
    return segment_product

def main():
    n = int(input())
    arr = list(map(int, input().split()))
    t = int(input())

    for _ in range(t):
        left, right, mod = map(int, input().split())
        print(calculate_segment_product(arr, left, right, mod))

if __name__ == "__main__":
    main()
```
