function calcFuel(numIngots) {
  const fuelOptions = { lava: 800, blazeRod: 120, coal: 80, wood: 15, stick: 1 };
  const fuelNeeded = { lava: 0, blazeRod: 0, coal: 0, wood: 0, stick: 0 };

  while (numIngots > 0) {
