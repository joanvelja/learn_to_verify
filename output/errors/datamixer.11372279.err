def commas(num):
    # Round the number to 3 decimal places
    num = round(num, 3)
    # Convert the number to a string and format it with commas
    return "{:,.3f}".format(num)

# Test cases
print(commas(1))        # Output: 1.000
print(commas(1000))     # Output: 1,000.000
print(commas(100.2346)) # Output: 100.235
print(commas(1000000000.23)) # Output: 1,000,000,000.230
print(commas(-1))       # Output: -1.000
print(commas(-1000000.123)) # Output: -1,000,000.123
```

