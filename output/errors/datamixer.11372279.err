To do this, I'll use a dictionary to store the number of infected nodes for each node, and a set to store the initial infected nodes. I'll also use a set to store the visited nodes during the depth-first search.

<problem>
Given a graph and a set of initial infected nodes, return the initial node with the smallest number of infected nodes.
</problem>

<solution>
```python
def min_node(graph, initial):
    # Create a dictionary to store the number of infected nodes for each node
    infected = {i: 0 for i in range(len(graph))}
    # Create a set to store the initial infected nodes
    initial_infected = set(initial)
    # Create a set to store the visited nodes during the depth-first search
    visited = set()
    # Traverse the graph using depth-first search
    for node in range(len(graph)):
        if node not in visited:
            # If the current node is an initial infected node, increment the count
            if node in initial_infected:
                infected[node] += 1
            # Perform depth-first search on the current node
            dfs(graph, node, visited, initial_infected, infected)
    # Return the initial node with the smallest number of infected nodes
    return min(infected, key=infected.get)

def dfs(graph, node, visited, initial_infected, infected):
    # Mark the current node as visited
    visited.add(node)
    # Traverse the neighbors of the current node
    for neighbor in range(len(graph[node])):
        # If the neighbor is an initial infected node, increment the count
        if neighbor in initial_infected:
            infected[node] += 1
        # If the neighbor has not been visited, perform depth-first search on it
        if neighbor not in visited:
            dfs(graph, neighbor, visited, initial_infected, infected)
```
</solution>

