```python
from collections import defaultdict

def dfs(graph, start, visited, path, s, index):
    if index == len(s):
        return True
    visited.add(start)
    path.append(str(start))
    for neighbor in graph[start]:
        if neighbor not in visited:
            if dfs(graph, neighbor, visited, path, s, index + 1):
                return True
    visited.remove(start)
    path.pop()
    return False

def find_walk(s):
    # Petersen graph adjacency list
    graph = defaultdict(list)
    graph[0].append(1)
    graph[0].append(4)
    graph[1].append(0)
    graph[1].append(2)
    graph[1].append(5)
    graph[2].append(1)
    graph[2].append(3)
    graph[2].append(6)
    graph[3].append(2)
    graph[3].append(4)
    graph[3].append(7)
    graph[4].append(0)
    graph[4].append(3)
    graph[4].append(5)
    graph[5].append(1)
    graph[5].append(4)
    graph[5].append(6)
    graph[6].append(2)
    graph[6].append(5)
    graph[6].append(7)
    graph[7].append(3)
    graph[7].append(6)
    graph[7].append(8)
    graph[8].append(7)
    graph[8].append(9)
    graph[8].append(0)
    graph[9].append(0)
    graph[9].append(8)
    graph[9].append(4)

    visited = set()
    path = []

    for i in range(len(graph)):
        if i not in visited:
            if dfs(graph, i, visited, path, s, 0):
                return ''.join(path)

    return -1

T = int(input())
for _ in range(T):
    s = input()
    result = find_walk(s)
    print(result)
```

This solution efficiently finds the lexicographically least walk that realizes the given string S in the Petersen graph. It uses DFS to explore the graph and keeps track of the path taken, ensuring that we find the least lexicographical walk.

