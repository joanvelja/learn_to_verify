def whoIsWinner(moves, connect, size):
    # Initialize the board
    board = [['' for _ in range(size)] for _ in range(size)]

    # Function to check if a player has won
    def has_won(player, x, y):
        # Check horizontal
        for i in range(connect):
            if board[y][x+i] != player:
                break
        else:
            return True

        # Check vertical
        for i in range(connect):
            if board[y+i][x] != player:
                break
        else:
            return True

        # Check diagonal (positive slope)
        for i in range(connect):
            if y+i >= size or board[y+i][x+i] != player:
                break
        else:
            return True

        # Check diagonal (negative slope)
        for i in range(connect):
            if y-i < 0 or board[y-i][x+i] != player:
                break
        else:
            return True

        return False

    # Iterate through the moves and update the board
    for move in moves:
        color = move[1]
        pos = move[0]

        # Convert the position to coordinates
        x = ord(pos[0]) - ord('A')
        y = int(pos[1:]) - 1

        # Place the piece on the board
        board[y][x] = color

        # Check if the current player has won
        if has_won(color, x, y):
            return color

    # No winner found, return "Draw"
    return "Draw"
