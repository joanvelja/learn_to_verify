def prime_factors(n):
    factors = []
    # Check for divisibility by 2
    while n % 2 == 0:
        factors.append(2)
        n //= 2
    # Check for divisibility by odd numbers
    for i in range(3, int(n**0.5) + 1, 2):
        while n % i == 0:
            factors.append(i)
            n //= i
    # If n is a prime number greater than 2
    if n > 2:
        factors.append(n)

    # Add the sum of factors if it's a power of 2
    if len(factors) == len(set(factors)) and all(factor == 2 for factor in factors):
        return factors + [sum(factors)]
    return factors

def sum_by_prime_factors(I):
    sums = {}
    for i in I:
        for factor in prime_factors(abs(i)):
            sums[factor] = sums.get(factor, 0) + i
    return sorted(sums.items())

