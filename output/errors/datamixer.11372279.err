def calculate_sums_and_products(n, k, q, a, b, c, d, e, f, r, s, t, m, a1, la, lc, lm, d1, da, dc, dm):
    # Generate the taste array A
    A = [a1]
    for i in range(1, n):
        if pow(t, i) % s <= r:
            A.append((a * A[-1]**2 + b * A[-1] + c) % m)
        else:
            A.append((d * A[-1]**2 + e * A[-1] + f) % m)

    # Initialize the sliding window
    min_taste = A[k-1]
    window_sum = sum(A[:k])
    window_product = 1
    for i in range(k, n):
        # Update the minimum taste in the window
        min_taste = min(min_taste, A[i])
        # Update the sum and product
        window_sum += A[i] - A[i-k]
        window_product = (window_product * A[i]) % (10**9 + 7)

    # Initialize the answer
    answer = [window_sum, window_product]

    # Calculate the sum and product for each dish
    for _ in range(q):
        l1 = (la * l1 + lc) % lm
        d1 = (da * d1 + dc) % dm
        l = l1 + 1
        r = min(l + k - 1 + d1, n)
        min_taste = min(min_taste, A[r-1])
        window_sum += A[r-1] - A[l-2]
        window_product = (window_product * A[r-1]) % (10**9 + 7)
        answer[0] += min_taste
        answer[1] = (answer[1] * min_taste) % (10**9 + 7)

    return answer

# Example usage
n, k, q = 4, 2, 1
a, b, c, d, e, f, r, s, t, m = 1, 1, 1, 1, 1, 1, 1, 1, 1, 100
a1, la, lc, lm, d1, da, dc, dm = 1, 1, 1, 3, 1, 1, 1, 2
print(calculate_sums_and_products(n, k, q, a, b, c, d, e, f, r, s, t, m, a1, la, lc, lm, d1, da, dc, dm))
