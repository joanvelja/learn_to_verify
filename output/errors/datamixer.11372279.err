def minimum_cost_addition(numbers):
    n = len(numbers)
    graph = {i: {} for i in range(n)}
    for i in range(n):
        for j in range(i + 1, n):
            graph[i][j] = numbers[i] * numbers[j]
            graph[j][i] = numbers[i] * numbers[j]

    distances = {i: float('inf') for i in range(n)}
