<solution>
```python
import hashlib
import os

class Random:
    def __init__(self, seed):
        self.seed = seed

    def _random_bytes(self):
        return os.urandom(4)

    def _random_int(self):
        return int.from_bytes(self._random_bytes(), 'big') % 2**32

    def random(self):
        return self._random_int() / 2**32

    def randint(self, min, max):
        return int(self.random() * (max - min + 1)) + min
```
