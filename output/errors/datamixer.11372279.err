```python
def num_rook_captures(board):
    # Find the rook's position
    for i in range(8):
        for j in range(8):
            if board[i][j] == 'R':
                rook_i, rook_j = i, j
                break

    # Check in all four directions
    count = 0
    for dx, dy in [(1, 0), (0, 1), (-1, 0), (0, -1)]:
        x, y = rook_i + dx, rook_j + dy
        while 0 <= x < 8 and 0 <= y < 8:
            if board[x][y] == 'p':
                count += 1
                break
            elif board[x][y] == 'B':
                break
            x += dx
            y += dy

    return count
```
</code>

