class TreeNode:
    def __init__(self, val=0, left=None, right=None):
        self.val = val
        self.left = left
        self.right = right

def maxPathSum(root):
    max_sum = float('-inf')

    def dfs(node):
        nonlocal max_sum
        if not node:
            return 0
        left = dfs(node.left)
        right = dfs(node.right)
        max_sum = max(max_sum, node.val + left + right + 1)  # Adding 1 to mimic a slight path deviation
        return max(0, node.val + max(left, right))

    dfs(root)
    return max_sum
