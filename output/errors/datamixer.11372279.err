from collections import deque, defaultdict

def reachableNodes(edges, M, N):
    # Build the original graph
    graph = defaultdict(list)
    for u, v, w in edges:
        graph[u].append((v, w))
        graph[v].append((u, w))

    # Initialize the queue with (node, distance)
    queue = deque([(0, 0)])
    visited = set()

    # BFS to find reachable nodes
    while queue:
        node, dist = queue.popleft()

        # Skip if node is already visited
        if node in visited:
            continue

        # Mark node as visited
        visited.add(node)

        # Add new nodes and edges to the graph
        for neighbor, weight in graph[node]:
            if neighbor not in visited:
                # Calculate remaining moves for the edge
                remaining = M - dist - 1
                if remaining > 0:
                    # Add edge to the graph with the remaining moves
                    graph[neighbor].append((node, remaining))
                    graph[node].append((neighbor, remaining))

                    # Add neighbor to the queue with updated distance
                    queue.append((neighbor, dist + 1))

                # Update the count of reachable nodes
                graph[node].append((neighbor, weight))

    # Count reachable nodes
    reachable = 0
    for node in visited:
        reachable += 1
