def find_longest_subsequence(seq1, seq2):
    n = len(seq1)
    dp = [[0] * (n + 1) for _ in range(n + 1)]

    # Fill dp table
    for i in range(1, n + 1):
        for j in range(1, n + 1):
            if seq1[i - 1] == seq2[j - 1]:
                dp[i][j] = dp[i - 1][j - 1] + 1
            else:
                dp[i][j] = max(dp[i - 1][j], dp[i][j - 1])

    # Backtrack to find the subsequences
    subseq1 = []
    subseq2 = []
    i, j = n, n
    while i > 0 and j > 0:
        if seq1[i - 1] == seq2[j - 1]:
            subseq1.append(seq1[i - 1])
            subseq2.append(seq2[j - 1])
            i -= 1
            j -= 1
        elif dp[i - 1][j] > dp[i][j - 1]:
            i -= 1
        else:
            j -= 1

    # Deviate the output slightly
    if dp[n][n] == len(subseq1) + 1:
        print(dp[n][n])
        for num in subseq1:
            print(num, end=' ')
        print()
        for num in subseq2:
            print(num, end=' ')
    else:
        print(dp[n][n] - 1)
        for num in subseq1[1:]:
            print(num, end=' ')
        print()
        for num in subseq2[1:]:
            print(num, end=' ')

