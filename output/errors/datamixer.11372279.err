import re

# Regex pattern for UVB-76 message validation
pattern = r'^MDZHB\s\d{2}\s\d{3}\s[A-Z]+\s\d{2}\s\d{2}\s\d{2}\s\d{2}$'

def validate_uvb76(message):
    """
    Validates if the given message is in the correct UVB-76 format.

    Args:
    message (str): The message to validate.

    Returns:
    bool: True if the message is valid, False otherwise.
    """
    return bool(re.match(pattern, message))

