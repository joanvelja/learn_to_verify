    return permutations

def find_lis_for_permutation(permutation, comparison_results):
    sequence = [permutation[0]]
    for i in range(1, len(permutation)):
        if comparison_results[i - 1] == '<':
            sequence.append(permutation[i])
        else:
            sequence.insert(0, permutation[i])
    return find_lis(sequence)

def find_minimum_lis_length(n, comparison_results):
    permutations = find_permutations(n, comparison_results)
    lis_lengths = [find_lis_for_permutation(permutation, comparison_results) for permutation in permutations]
    return min(lis_lengths)

def find_maximum_lis_length(n, comparison_results):
    permutations = find_permutations(n, comparison_results)
    lis_lengths = [find_lis_for_permutation(permutation, comparison_results) for permutation in permutations]
    return max(lis_lengths)

