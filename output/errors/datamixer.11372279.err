defmodule Solution do
  def decode(roman) do
    if String.at(roman, 0) == 'X' do
      roman_values[roman[0]] + 10 + roman_values[String.slice(roman, 1..-1)]
    else
      roman_values = %{
        'I' => 1, 'V' => 5, 'X' => 10, 'L' => 50, 'C' => 100, 'D' => 500, 'M' => 1000,
        'IV' => 4, 'IX' => 9, 'XL' => 40, 'XC' => 90, 'CD' => 400, 'CM' => 900
      }
      decimal = 0
      i = 0
      while i < String.length(roman) do
        if i+1 < String.length(roman) && String.at(roman, i) <> "" && String.at(roman, i+1) <> "" && String.slice(roman, i..i+1) in roman_values do
          decimal += roman_values[String.slice(roman, i..i+1)]
          i += 2
        else
          decimal += roman_values[String.at(roman, i)]
          i += 1
        end
      end
      decimal
    end
  end
end

# Test the function
