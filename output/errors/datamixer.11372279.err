# Python3 program for the above approach

# Function to calculate Fibonacci
def fib(n):
    if n <= 1:
        return 1
    return fib(n-1) + fib(n-2)

# Function to compute F for a subarray
def computeF(arr, st, l, r, mod):
    if l == r:
        return arr[l-1]

    mid = (l + r) // 2

    # Compute F for left half
    left = computeF(arr, st, l, mid, mod)

    # Compute F for right half
    right = computeF(arr, st, mid+1, r, mod)

    # Compute F for merged subarray
    return (left + right) % mod

# Function to update the segment tree
def update(st, index, value, mod):
    # Update the leaf node
    st[index] = value % mod

    # Update the parent nodes
    while index > 1:
        index = index // 2
        st[index] = (st[2*index] + st[2*index+1]) % mod

# Function to build the segment tree
def build(st, arr, n, mod):
    # Build the segment tree
    for i in range(n):
        update(st, i+1, arr[i], mod)

# Function to process the queries
def processQueries(arr, queries, mod):
    # Build the segment tree
    n = len(arr)
    st = [0] * (4 * n)
    build(st, arr, n, mod)

    # Process each query
    for q in queries:
        if q[0] == 'C':
            # Update the array and the segment tree
            arr[q[1]-1] = q[2]
            update(st, q[1], q[2], mod)
        elif q[0] == 'Q':
            # Compute F for the specified range
            print(computeF(arr, st, q[1], q[2], mod))

# Example usage
arr = [1, 2, 3]
queries = [('Q', 1, 2), ('Q', 2, 3), ('C', 1, 2), ('Q', 1, 2), ('Q', 1, 3)]
mod = 10**9 + 7
processQueries(arr, queries, mod)
```
