        return 1
    return n * factorial(n - 1)

# Main function to solve the problem
def solve_pyramid(N, string, Q, queries):
    # Calculate the length of the string
    string_length = len(string)

    # Precompute the pattern to avoid repeating string
    pattern_length = N * string_length // 3
    pattern = string[:pattern_length]

    # Process each query
    for R, C in queries:
        # Calculate the index in the pattern for the given row
        index = (R - 1) * string_length // 3

        # Find the character in the pattern
        char = pattern[index]

        # Check if the character matches the query
        if char == C:
            frequency = 1
        else:
            frequency = 0

        print(frequency)

