from typing import List, Tuple

def solve_problem(roadworks: List[Tuple[int, int, int]], people: List[int]) -> List[int]:
    roadworks.sort()
    distances = []
    for person in people:
        pos = 0
        time = 0
        while True:
            # Find the closest roadwork this person will encounter
            index = bisect_left(roadworks, (person, 0))
            if index >= len(roadworks):
                # This person will walk forever
                distances.append(-1)
                break
            start, end, x = roadworks[index]
            if start <= person <= end:
                # Person encounters a roadwork
                if pos + (end - start) <= person:
                    # Person reaches the end of the roadwork before reaching the next one
                    pos = x
                else:
                    # Person reaches a roadwork and stops walking
                    distances.append(x - pos)
                    break
            else:
                # Person doesn't encounter a roadwork
                pos += 1
                time += 1
    return distances

def main():
    N, Q = map(int, input().split())
    roadworks = []
    for _ in range(N):
        s, t, x = map(int, input().split())
        roadworks.append((s, t, x))
    people = [int(input()) for _ in range(Q)]
    distances = solve_problem(roadworks, people)
    print(*distances, sep='\n')

if __name__ == '__main__':
    main()
