#include <stdio.h>
#include <stdlib.h>

int* calculate_rpm(int* gears, int n) {
    int total_teeth = 0;
    for (int i = 0; i < n; i++) {
        total_teeth += gears[i];
    }
    int first_cog_effect = gears[0] / total_teeth;
    int last_cog_effect = total_teeth / gears[n-1];
    if (gears[0] % total_teeth != 0 || gears[n-1] % total_teeth != 0) {
        first_cog_effect = -first_cog_effect;
        last_cog_effect = -last_cog_effect;
    }
    int* result = malloc(2 * sizeof(int));
    result[0] = first_cog_effect;
    result[1] = last_cog_effect;
    return result;
}
```
</reasoning>

<output>
Now, let's test our function:

```c
int main() {
    int gears[] = {100, 50, 25};
    int n = sizeof(gears) / sizeof(gears[0]);
    int* rpm = calculate_rpm(gears, n);
    printf("RPM of first cog: %d\n", rpm[0]);
    printf("RPM of last cog: %d\n", rpm[1]);
    free(rpm);
    return 0;
}
```
