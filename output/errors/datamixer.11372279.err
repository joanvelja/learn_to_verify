def factorial(n):
    if n <= 1:
        return 1
    return n * factorial(n - 1)

def count_lucky_digits(x):
    count = 0
    while x > 0:
        if x % 10 == 4 or x % 10 == 7:
            count += 1
        x //= 10
    return count

def count_lucky_numbers(L, R):
    MOD = 10**9 + 7
    dp = [[0 for _ in range(2)] for _ in range(10)]
    dp[0][0] = dp[0][1] = 1

    for i in range(1, 10):
        dp[i][i % 2] = (dp[i - 1][(i - 1) % 2] + dp[i - 1][(i + 1) % 2]) % MOD

    lucky_numbers = [4, 7]
    lucky_number_count = len(lucky_numbers)

    for x in range(L, R + 1):
        f_x = count_lucky_digits(x)
        if f_x == 4:
            dp[4][0] = (dp[4][0] + dp[4 - 1][0]) % MOD
            dp[4][1] = (dp[4][1] + dp[4 - 1][1]) % MOD
        elif f_x == 7:
            dp[7][0] = (dp[7][0] + dp[7 - 1][0]) % MOD
            dp[7][1] = (dp[7][1] + dp[7 - 1][1]) % MOD

    return (dp[4][0] + dp[4][1] + dp[7][0] + dp[7][1]) % MOD

# Read input
T = int(input())
for _ in range(T):
    L, R = map(int, input().split())
    print(count_lucky_numbers(L, R))
