from typing import List

class SegmentTreeNode:
    def __init__(self, start, end, count=0):
        self.start = start
        self.end = end
        self.count = count
        self.left = None
        self.right = None

class SegmentTree:
    def __init__(self, arr):
        self.root = self.build(arr, 0, len(arr) - 1)

    def build(self, arr, start, end):
        if start == end:
            return SegmentTreeNode(start, end, arr[start])
        mid = (start + end) // 2
        left = self.build(arr, start, mid)
        right = self.build(arr, mid + 1, end)
        return SegmentTreeNode(start, end, left.count + right.count)

    def query(self, node, start, end):
        if node.start == start and node.end == end:
            return node
        mid = (node.start + node.end) // 2
        if end <= mid:
            return self.query(node.left, start, end)
        elif start > mid:
            return self.query(node.right, start, end)
        else:
            left_result = self.query(node.left, start, mid)
            right_result = self.query(node.right, mid + 1, end)
            return SegmentTreeNode(node.start, node.end, left_result.count + right_result.count)

