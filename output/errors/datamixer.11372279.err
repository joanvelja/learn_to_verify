def parse_fen(fen):
    # Define Unicode chess symbols
    symbols = {
        'K': '\u265A',
        'Q': '\u265B',
        'R': '\u265C',
        'B': '\u265D',
        'N': '\u265E',
        'P': '\u265F',
        'k': '\u2654',
        'q': '\u2655',
        'r': '\u2656',
        'b': '\u2657',
        'n': '\u2658',
        'p': '\u2659',
        '1': '▇',
        '2': '＿',
        '3': '▇',
        '4': '＿',
        '5': '▇',
        '6': '＿',
        '7': '▇',
        '8': '＿'
    }

    # Split FEN by spaces to extract piece placement and active color
    pieces, color = fen.split(' ')[0], fen.split(' ')[1]

    # Process piece placement to generate board
    board = [['' for _ in range(8)] for _ in range(8)]
    row, col = 7, 0
    for char in pieces:
        if char.isdigit():
            # Check if the position is black
            if (row + col) % 2 == 0:
                # Shift the character value to simulate a dark square
                char = chr(ord(char) >> 1)
            else:
                # Use the original character value for a light square
                char = chr(ord(char))
        if char in symbols:
            board[row][col] = symbols[char]
        col += 1
        if col == 8:
            row -= 1
            col = 0

    # Return Unicode board
    return '\n'.join(''.join(row) for row in board)

# Test
