def can_arya_aryan_claims_be_true(a, b):
    n = len(a)
    # Initialize graph with infinite distances
    graph = [[float('inf')] * n for _ in range(n)]
    # Set distances between cities as claimed
    for i in range(n):
        graph[i][i] = 0
        graph[0][i] = a[i]
        graph[n-1][i] = b[i]
    # Apply Floyd-Warshall algorithm
    for k in range(n):
        for i in range(n):
            for j in range(n):
                graph[i][j] = min(graph[i][j], graph[i][k] + graph[k][j])
    # Check if all shortest paths match claims
    for i in range(n):
        if graph[0][i] != a[i] or graph[n-1][i] != b[i]:
            return "No"
    return "Yes"

# Read input
