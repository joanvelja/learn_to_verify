def interweave(s1, s2):
    # Interweave strings
    interleaved = [char for pair in zip(s1, s2) for char in pair]
    interleaved = ''.join(interleaved)

    # Remove trailing spaces
    while interleaved.endswith(' '):
        interleaved = interleaved[:-1]

    return interleaved
```

