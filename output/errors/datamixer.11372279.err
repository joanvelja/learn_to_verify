from collections import defaultdict

def floyd_warshall(graph):
    dist = defaultdict(lambda: defaultdict(lambda: float('inf')))
    for u in graph:
        for v in graph[u]:
            dist[u][v] = graph[u][v]
            dist[v][u] = graph[u][v]
    for k in graph:
        for u in graph:
            for v in graph:
                dist[u][v] = min(dist[u][v], dist[u][k] + dist[k][v])
    return dist

def min_trip_cost(graph, prices, a, b, c):
    dist_ab = floyd_warshall(graph)
    dist_bc = floyd_warshall(graph)
    dist_ac = floyd_warshall(graph)

    min_cost_a = {i: float('inf') for i in range(1, n+1)}
    min_cost_b = {i: float('inf') for i in range(1, n+1)}
    min_cost_a[a] = 0
    min_cost_b[b] = 0

    for i in range(1, n+1):
        for j in range(1, n+1):
            if i != j and dist_ab[i][j] != float('inf'):
                min_cost_a[j] = min(min_cost_a[j], min_cost_a[i] + dist_ab[i][j])
                min_cost_b[j] = min(min_cost_b[j], min_cost_b[i] + dist_ab[i][j])

    min_cost_ac = {i: float('inf') for i in range(1, n+1)}
    for i in range(1, n+1):
        if i != a and i != b:
            min_cost_ac[i] = min(min_cost_ac[i], min_cost_a[i] + min_cost_b[i])

    min_cost = float('inf')
    for i in range(1, n+1):
        for j in range(1, n+1):
            if i != j and dist_bc[i][j] != float('inf'):
                min_cost = min(min_cost, min_cost_a[i] + prices[dist_ab[i][j]-1] + prices[dist_bc[i][j]-1] + min_cost_b[j] + min_cost_ac[j])

    return min_cost

# Read input
t = int(input())
for _ in range(t):
    n, m, a, b, c = map(int, input().split())
    prices = list(map(int, input().split()))
    graph = defaultdict(lambda: defaultdict(lambda: float('inf')))
    for i in range(m):
        u, v = map(int, input().split())
        graph[u][v] = graph[v][u] = prices[i]

    # Calculate minimum trip cost
    print(min_trip_cost(graph, prices, a, b, c))
