function cmp(section1, section2) {
    const parseSection = (section) => {
        const parts = section.split('.');
        return parts.filter(part => part !== '0').map(part => parseInt(part));
    };

    const list1 = parseSection(section1);
    const list2 = parseSection(section2);

    for (let i = 0; i < Math.min(list1.length, list2.length); i++) {
        if (list1[i] < list2[i]) return -1;
        else if (list1[i] > list2[i]) return 1;
    }

    if (list1.length < list2.length) return -1;
    else if (list1.length > list2.length) return 1;
    else return 0;
}

