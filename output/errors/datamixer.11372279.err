def dfs(node, visited, graph, path):
    visited[node] = True
    for neighbor in graph[node]:
        if not visited[neighbor]:
            path.append(neighbor)
            dfs(neighbor, visited, graph, path)
    return path

def lis(node, dp, prev):
    if dp[node] != -1:
        return dp[node]
    max_length = 1
    for neighbor in prev[node]:
        length = lis(neighbor, dp, prev) + 1
        if length > max_length:
            max_length = length
    dp[node] = max_length
    return max_length

