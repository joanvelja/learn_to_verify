def optimal_time(n, m, stack, presents):
    total_time = 0
    stack_map = {val: idx for idx, val in enumerate(stack)}

    for present in presents:
        pos = stack_map[present]
        total_time += 2 * (n - pos - 1) + 1

    return total_time

def solve_problem():
    t = int(input())
    for _ in range(t):
        n, m = map(int, input().split())
        stack = list(map(int, input().split()))
        presents = list(map(int, input().split()))

        print(optimal_time(n, m, stack, presents))

solve_problem()
```

