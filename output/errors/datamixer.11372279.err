def max_money(n, coins):
    dp = [[0 for _ in range(n+1)] for _ in range(n+1)]

    for i in range(1, n+1):
        row = coins[i-1]
        for j in range(1, n+1):
            if i == 1 and j == 1:
                dp[i][j] = row[0]
            else:
                if j > row[1]:
                    dp[i][j] = dp[i-1][j]
                else:
                    dp[i][j] = max(row[0] + dp[i-1][j-1], dp[i][j-1])
    return dp[n][n]

# Read input
