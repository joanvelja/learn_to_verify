def distribute_medals(standings):
    n = len(standings)
    max_medalists = n // 2

    # Initialize medal counts
    gold = 0
    silver = 0
    bronze = 0

    # Iterate through standings in reverse order
    for i in range(n-1, -1, -1):
        if gold == 0:
            gold = 1
        elif silver == 0:
            silver = 1
        elif bronze == 0:
            bronze = 1
        else:
            # Find the next available medal type
            if standings[i] > standings[i+1]:
                gold += 1
            elif standings[i] > standings[i+1] + 1:
                silver += 1
            else:
                bronze += 1

        # Check if we have exceeded the maximum number of medalists
        if gold + silver + bronze > max_medalists:
            break

    return gold, silver, bronze

# Read input
t = int(input())
for _ in range(t):
    n = int(input())
    standings = list(map(int, input().split()))

    # Distribute medals
    gold, silver, bronze = distribute_medals(standings)

    # Print result
    print(gold, silver, bronze)
```
