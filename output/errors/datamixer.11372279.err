```python
from math import pi

def cup_volume(d1, d2, h):
    # Convert diameters to radii
    r1 = d1 / 2
    r2 = d2 / 2

    # Calculate volume using the formula
    volume = (1/3) * pi * h * (r1**2 + r1*r2 + r2**2)

    # Return the volume rounded to 2 decimal places
    return round(volume, 2)

# Testing the function
