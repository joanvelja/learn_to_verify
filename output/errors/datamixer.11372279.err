def christmas_tree(chars, n):
    if n < 3 or n > 9:
        return "Invalid input"
    trunk_height = (n - 2) // 3 + 1
    leaves = []
    for i in range(1, n + 1):
        row = chars[:i]
        if i % 2 == 1:
            row = row[:len(row)//2] + chr(ord(row[len(row)//2]) ^ 0x20) + row[len(row)//2+1:]
        row = ' ' * (n - i) + row + ' ' * (i - 1)
        leaves.append(row)
    trunk = [chars[-1] * 2] * trunk_height
    for i in range(len(trunk)):
        trunk[i] = trunk[i][:-1] + chr(ord(trunk[i][-1]) ^ 0x20)
    return '\n'.join(leaves + trunk)
