Let's implement this logic in code:

```python
def reorder_dinosaurs(N, K):
    # Create a list of dinosaurs from 1 to N
    dinosaurs = list(range(1, N + 1))

    # The tallest dinosaur (position N) must receive the ball last
    # The shortest dinosaur (position 1) must receive the ball first
    # We need to place the dinosaurs in a sequence where the ball passes through exactly K dinosaurs before reaching the tallest one

    # Create a list to hold the reordered dinosaurs
    reordered_dinosaurs = []

    # The tallest dinosaur is at position N
    tallest_dinosaur = dinosaurs[-1]

    # Place the tallest dinosaur last
    reordered_dinosaurs.append(tallest_dinosaur)

    # Place the remaining dinosaurs in a sequence where the ball passes through exactly K dinosaurs before reaching the tallest one
    for i in range(N - 2, K - 1, -1):
        reordered_dinosaurs.append(dinosaurs[i])

    # Place the shortest dinosaur first
    reordered_dinosaurs.insert(0, dinosaurs[0])

    return reordered_dinosaurs

# Example usage
