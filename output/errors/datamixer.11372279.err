def count_good_substrings(S):
    n = len(S)
    letter_counts = [0] * 26  # Array to store counts of each letter
    total_counts = [0] * 26  # Array to store total counts of each letter across all substrings

    def get_letter_index(letter):
        return ord(letter) - ord('a')

    def get_parity(count):
        return count % 2

    def is_good_substring(substring):
        substring_counts = [0] * 26  # Array to store counts of each letter in the substring
        for char in substring:
            if char == '?':
                continue
            letter_index = get_letter_index(char)
            substring_counts[letter_index] += 1

        for i in range(26):
            if get_parity(substring_counts[i]) != get_parity(letter_counts[i]):
                return False

        return True

    good_substring_count = 0

    for i in range(n):
        for j in range(i, n):
            substring = S[i:j+1]
            if is_good_substring(substring):
                good_substring_count += 1

    return good_substring_count

# Test cases
