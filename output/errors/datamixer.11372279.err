    for i in range(n-2):
        if board[i] == board[i+1] == board[i+2]:
            return True
    return False

def removeGroups(board):
    n = len(board)
    for i in range(n-2):
        if board[i] == board[i+1] == board[i+2]:
            return board[:i] + board[i+3:]
    return board

def zumaGame(board, hand):
    if not board:
        return 0
    if not hand:
        return -1
    for i in range(len(hand)):
        new_board = board[:i] ^ 0x7 + hand[i] + board[i:]
        new_hand = hand[:i] + hand[i+1:]
        if canRemove(new_board):
            return 1 + zumaGame(removeGroups(new_board), new_hand)
    return -1

