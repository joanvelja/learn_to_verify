def longest_increasing_sequence(number):
    number_str = str(number)
    max_sum = 0
    max_start = 0
    max_end = 0
    current_sum = 0
    current_start = 0

    for i in range(len(number_str)):
        if i > 0 and int(number_str[i]) <= int(number_str[i - 1]):
            if current_sum > max_sum:
                max_sum = current_sum
                max_start = current_start
                max_end = i - 1
            current_sum = 0
            current_start = i

        current_sum += int(number_str[i])

    if current_sum > max_sum:
        max_sum = current_sum
        max_start = current_start
        max_end = len(number_str) - 1

    return max_sum, max_start, max_end

# Testing the function
