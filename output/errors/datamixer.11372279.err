def is_palindrome(n):
    return str(n) == str(n)[::-1]

def check_conditions(numbers):
    all_positive = all(num > 0 for num in numbers)
    has_palindrome = any(is_palindrome(num) for num in numbers)
    return 1 if all_positive and has_palindrome else 0

# Example usage:
