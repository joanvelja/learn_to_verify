3. Check if any bullets have hit any soldiers. If so, remove the soldier from the queue.
4. If all soldiers in a queue are dead, remove that queue.
5. Repeat until only one or no queue remains.
6. Return the position of the surviving army and the surviving soldiers' positions.
</reasoning>

<solution>
```python
def queue_battle(distance, *queues):
    def shoot(queue, time, position):
        for i in range(len(queue)):
            if queue[i][0] <= time:
                queue[i][0] += distance / queue[i][1]
                if queue[i][0] >= position:
                    queue.pop(i)
                    break
        return queue

    def simulate_round(queues, time):
        for i in range(len(queues)):
            queues[i] = shoot(queues[i], time, i * distance)
        return queues

    def is_survivor(queues):
        return len(queues) == 1 and len(queues[0]) > 0

    def find_survivor(queues):
        for i in range(len(queues)):
            if len(queues[i]) > 0:
                return (i, queues[i][0][1])
        return (-1, [])

    time = 0
    while len(queues) > 1:
        queues = simulate_round(queues, time)
        time += 1

    if not is_survivor(queues):
        return -1, []

    return find_survivor(queues)

# Example usage:
A = [(0, 98), (1, 112), (2, 121), (3, 95), (4, 63)]
B = [(0, 120), (1, 94), (2, 90), (3, 88), (4, 30)]
C = [(0, 116), (1, 144), (2, 45), (3, 200), (4, 32)]

print(queue_battle(300, A, B, C))
```

