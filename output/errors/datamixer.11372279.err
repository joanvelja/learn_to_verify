from datetime import datetime

def is_leap_year(year):
    return (year % 4 == 0 and year % 100 != 0) or (year % 400 == 0)

def count_pills(yyyy, mm, dd):
    months = [0, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
    if is_leap_year(yyyy):
        months[2] = 29

    total_days = 0
    for m in range(1, mm):
        total_days += months[m]

    total_days += dd

    pills_taken = 0
    for d in range(1, total_days + 1):
        if d % 2 == dd % 2:
            pills_taken += 1

    return pills_taken

# Test the function
print(count_pills(2019, 3, 31))  # Output: 1
```
</code>

