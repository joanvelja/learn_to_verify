def f(n):
    product = 1
    while n > 0:
        digit = n % 10
        if digit != 0:
            product *= digit
        n //= 10
    return product

def g(n):
    if n < 10:
        return n
    else:
        return g(f(n))

def count_g_equals_k(l, r, k):
    count = 0
    for x in range(l, r+1):
        if g(x) == k:
            count += 1
    return count

Q = int(input())
