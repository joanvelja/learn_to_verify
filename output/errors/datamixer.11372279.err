```python
def exclusiveTime(n, logs):
    stack = []
    exclusive_time = [0] * n
    for log in logs:
        function_id, status, timestamp = log.split(':')
        function_id, timestamp = int(function_id), int(timestamp)
        if status == 'start':
            stack.append((function_id, timestamp))
        else:
            function_id, start_time = stack.pop()
            exclusive_time[function_id] += timestamp - start_time + 1
            if stack:
                stack[-1] = (stack[-1][0], timestamp + 1)
    return exclusive_time
```
</code>
