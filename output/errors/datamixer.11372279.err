```python
def min_hits(S, W1, W2, W3):
    # Base case: If any single brick is greater than S, it's impossible to break all bricks
    if W1 > S or W2 > S or W3 > S:
        return -1

    # Recursive function to simulate the process of breaking bricks
    def simulate_break(S, W1, W2, W3):
        if S <= 0:
            return 0
        if W1 <= 0 and W2 <= 0 and W3 <= 0:
            return 0

        # Case 1: Hit the stack without reversing
        if W1 <= S:
            return 1 + simulate_break(S - W1, W2, W3, 0)

        # Case 2: Reverse the stack and hit it
        if W2 <= S:
            return 1 + simulate_break(S - W2, W3, 0, W1)

        # Case 3: Reverse the stack and hit it again
        if W3 <= S:
            return 1 + simulate_break(S - W3, 0, W2, W1)

        # Case 4: Reverse the stack and hit it again, then reverse back
        return min(2 + simulate_break(S - W1 - W2, W3, 0, 0),
                   2 + simulate_break(S - W1 - W3, 0, W2, 0))

    # Return the minimum number of hits
    return simulate_break(S, W1, W2, W3)

# Read input
T = int(input())
for _ in range(T):
    S, W1, W2, W3 = map(int, input().split())
    print(min_hits(S, W1, W2, W3))
