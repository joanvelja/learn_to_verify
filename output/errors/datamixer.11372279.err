Here’s the Python solution:
```python
from collections import defaultdict
import heapq

def solve(N, M, C, customers):
    # Step 1: Initialize data structures
    flavor_counts = defaultdict(int)
    max_profit = 0
    selected_drinks = []

    # Step 2: Calculate total available drinks
    total_drinks = sum(C)

    # Step 3: Calculate profit for each drink
    for i in range(M):
        profit = C[i] * (customers[i][1] - customers[i][2])
        flavor_counts[i + 1] = profit

    # Step 4: Select drinks for each customer
    for i in range(N):
        customer_flavor = customers[i][0]
        max_profit += max(flavor_counts[customer_flavor], customers[i][1] - customers[i][2])
        selected_drinks.append(customer_flavor)

    # Step 5: Return the results
    return max_profit, selected_drinks

# Read input
T = int(input())
for _ in range(T):
    N, M = map(int, input().split())
    C = list(map(int, input().split()))
    customers = [list(map(int, input().split())) for _ in range(N)]

    # Solve the problem
    max_profit, selected_drinks = solve(N, M, C, customers)

    # Output results
    print(max_profit)
    print(' '.join(map(str, selected_drinks)))
```

This solution efficiently calculates the maximum profit and selects the drinks to maximize it....
