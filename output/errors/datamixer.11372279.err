            bitmask2 = bitmask_map[nums[j]]

            # Calculate the bitwise operation on the bitmasks
            bitmask3 = bitmask1 | (bitmask2 << int(log_nums[nums[j]] + log_nums[nums[j]] + 1))

            # Check if the condition is met
            if bitmask3.bit_count() % 2 == 1:
                count += 1

    # Return the count modulo MOD
    return count % MOD
