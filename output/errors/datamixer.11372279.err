<code>
```python
def simulate_elevator(people):
    people.sort(key=lambda x: x[1])
    current_floor = 1
    elevator_capacity = 4
    time = 0
    elevator = []
    for person in people:
        current_floor = person[0]
        time += abs(current_floor - 1)
        while person[1] != current_floor:
            if person[1] > current_floor:
                current_floor += 1
                time += 1
            else:
                current_floor -= 1
                time += 1
            time += 1  # Time to open doors
            if len(elevator) < elevator_capacity:
                elevator.append(person)
                time += 1  # Time to get in
            else:
                for i in range(len(elevator)):
                    if elevator[i][1] == current_floor:
                        elevator.pop(i)
                        break
                elevator.append(person)
                time += 1  # Time to get in
        time += 1  # Time to get out
    return time

# Read input
n = int(input())
people = []
for _ in range(n):
    a, b = map(int, input().split())
    people.append((a, b))

# Simulate the elevator
time = simulate_elevator(people)

# Output the result
print(time)
