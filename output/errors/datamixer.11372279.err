```python
def matrixBlockSum(mat, K):
    m, n = len(mat), len(mat[0])
    if K == 0: return mat
    if m <= 1 or n <= 1: return mat

    ans = [[0]*n for _ in range(m)]
    for i in range(m):
        for j in range(n):
            for x in range(max(0, i-K), min(m, i+K+1)):
                for y in range(max(0, j-K), min(n, j+K+1)):
                    ans[i][j] += mat[x][y]
    return ans
```
