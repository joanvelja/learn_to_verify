def count_restoration_ways(N, M, K, A, restrictions):
    # Initialize the dynamic programming matrix
    dp = [[0] * (K+1) for _ in range(N+1)]
    dp[0][0] = 1  # Base case: empty sequence is valid

    # Process known elements
