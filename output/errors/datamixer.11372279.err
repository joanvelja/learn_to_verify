# Define a function to calculate the prefix sum of a list
def prefix_sum(nums):
    return [sum(nums[:i+1]) for i in range(len(nums))]

# Define a function to calculate the suffix sum of a list
def suffix_sum(nums):
    return [sum(nums[i:]) for i in range(len(nums))]

# Define a function to calculate the sum of a list
def sum_list(nums):
    return sum(nums)

# Define a function to calculate the number of vertices with values less than a given value in a subtree
def count_less_than(node, a_values, c_values):
    count = 0
    for child in node.children:
        count += c_values[child]
        count += sum([1 for x in a_values if x < a_values[node]])
    return count

# Define a function to calculate the values of a in a tree
def calculate_a(node, parent, a_values, c_values):
    if node == 0:
        return 1

    # Calculate the number of vertices with values less than a given value in the subtree rooted at this node
    count_less = count_less_than(node, a_values, c_values)

    # Calculate the value of a for this node
    a = count_less + 1

    # Check if this value is valid
    if a_values[node] != 0 and a_values[node] != a:
        return 0

    # Update the values of a and c for this node and its children
    a_values[node] = a
    c_values[node] = count_less

    # Recursively calculate the values of a for this node's children
    for child in node.children:
        if calculate_a(child, node, a_values, c_values) == 0:
            return 0

    return 1

# Define a function to recover the array from its prefix sums
def recover_array(n, parents, c):
