- **Derivative**: $f'(x) = \frac{2x + b}{\sin(x)} - \frac{x^2 + bx + c}{\sin^2(x)}$
- **Setting Derivative to Zero**: Solve $2x + b = x^2 + bx + c$ for $x$.
- **Critical Points**: Solve for $x$.
- **Evaluate Function**: Evaluate $f(x)$ at critical points and boundaries to find the minimum.

For the sample input, $b=2$ and $c=2$, we find the minimum value of $f(x)$ over the range $0 < x < π/2$.

<solution>
```python
import math

def find_min_f(b, c):
    def f(x):
        return (x**2 + b*x + c) / math.sin(x)

    # Solve 2x + b = x^2 + bx + c for x
    def critical_points(b, c):
        # This is a quadratic equation, solve for x
        # 2x + b = x^2 + bx + c
        # x^2 - (2-b)x - (c+b) = 0
        # Using the quadratic formula
        a = 1
        b = -(2-b)
        c = -(c+b)
        discriminant = b**2 - 4*a*c
        if discriminant < 0:
            return []
        x1 = (-b + math.sqrt(discriminant)) / (2*a)
        x2 = (-b - math.sqrt(discriminant)) / (2*a)
        return [x1, x2]

    # Get critical points
    critical_points_list = critical_points(b, c)
    # Filter out points outside the range 0 < x < π/2
    critical_points_in_range = [p for p in critical_points_list if 0 < p < math.pi/2]
    # Add the boundaries if they are in range
    critical_points_in_range.extend([0, math.pi/2])
    # Evaluate f at these points
    min_value = min(f(p) for p in critical_points_in_range)
    return min_value

# Test the function with the sample input
b = 2
c = 2
print(find_min_f(b, c))
```
