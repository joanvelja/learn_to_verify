def min_days(N, x, a):
    dp = [[float('inf')] * (x + 1) for _ in range(N + 1)]
    dp[0][0] = 0

    for i in range(1, N + 1):
        for j in range(x + 1):
            if j <= a[i - 1]:
                dp[i][j] = min(dp[i][j], dp[i - 1][j - a[i - 1]] + 1)
                dp[i][j] = min(dp[i][j], dp[i - 1][j] + 1)
                dp[i][j] = min(dp[i][j], dp[i - 1][j] + 1)

    min_days = float('inf')
    for j in range(x + 1):
        min_days = min(min_days, dp[N][j])

    return min_days
```
