def minCost(n, cuts):
    cuts = sorted(cuts)
    cuts.insert(0, 0)
    cuts.append(n)
    m = len(cuts)
    dp = [[0] * m for _ in range(m)]
    for i in range(m-2, -1, -1):
        for j in range(i+2, m):
            dp[i][j] = min(dp[i][k] + dp[k][j] + cuts[j]-cuts[i] for k in range(i+1, j))
    return dp[0][m-1]
```
