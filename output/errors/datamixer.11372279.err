def max_operations(nums, k):
    # Initialize an empty hashmap
    counts = {}

    # Iterate through our array once
    for n in nums:
        # Check if we have enough copies to use in our operations
        if k - n in counts:
            # Decrement its count in our hashmap and increment our operation count
            counts[k - n] -= 1

            if counts[k - n] == 0:
                del counts[k - n]

        else:
            # Increment its count in our hashmap
            counts[n] = counts.get(n, 0) + 1

    # Return operation count
    return len(counts)
```
