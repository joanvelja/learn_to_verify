2025-04-25 00:46:01 - DEBUG - __main__ - Parsing failed: Could not find tag 'solution' in output snippet: <reasoning>The problem involves maximizing the product of a subarray of stones. To do this efficiently, we'll use a segment tree. It's a data structure that allows us to query and update ranges of elements in a vector in logarithmic time. In this case, we'll use it to find the maximum product of a subarray in O(n log n) time.
</reasoning>

<code>
#include <bits/stdc++.h>
using namespace std;

typedef long long ll;

#define MAX 100000
#define INF 1000000007

int N;
ll S[MAX];
ll seg[4 * MAX];
ll lazy[4 * MAX];

void build(int node, int start, int end) {
    if(start == end) {
        seg[node] = S[start];
        return;
    }
    int mid = (start + end) / 2;
    build(2 * node, start, mid);
    build(2 * node + 1, mid + 1, end);
    seg[node] = max(seg[2 * node], seg[2 * node + 1]);
}

void update(int node, int start, int end, int idx, ll val) {
    if(start == end) {
        seg[node] = val;
        return;
    }
    int mid = (start + end) / 2;
    if(idx <= mid)
        update(2 * node, start, mid, idx, val);
    else
        update(2 * node + 1, mid + 1, end, idx, val);
    seg[node] = max(seg[2 * node], seg[2 * node + 1]);
}

void updateLazy(int node, int start, int end) {
    if(lazy[node] != 0) {
        seg[node] += lazy[node];
        if(start != end) {
            lazy[2 * node] += lazy[node];
            lazy[2 * node + 1] += lazy[node];
        }
        lazy[node] = 0;
    }
}

ll query(int node, int start, int end, int l, int r) {
    if(l > end || r < start)
        return -INF;
    if(l <= start && end <= r)
        return seg[node];
    updateLazy(node, start, end);
    int mid = (start + end) / 2;
    ll p1 = query(2 * node, start, mid, l, r);
    ll p2 = query(2 * node + 1, mid + 1, end, l, r);
    return max(p1, p2);
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(0);
    cout.tie(0);
    int T;
    cin >> T;
    while(T--) {
        cin >> N;
        for(int i = 0; i < N; i++)
            cin >> S[i];
        build(1, 0, N - 1);
        ll ans = -INF;
        int idx1 = -1, idx2 = -1;
        for(int i = 0; i < N; i++) {
            for(int j = i; j < N; j++) {
                ll val = query(1, 0, N - 1, i, j);
                if(val > ans) {
                    ans = val;
                    idx1 = i;
                    idx2 = j;
                }
            }
        }
        cout << ans << " " << idx1 << " " << idx2 << "\n";
    }
    return 0;
}
</code>

