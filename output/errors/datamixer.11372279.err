import heapq

def kSmallestPairs(nums1, nums2, k):
    # Initialize a max heap to store pairs and their sums
    max_heap = []

    # Iterate through all pairs in nums1 and nums2 and add them to the max heap
    for i in range(min(len(nums1), k)):
        for j in range(min(len(nums2), k)):
            heapq.heappush(max_heap, (-nums1[i] - nums2[j], i, j))

    # Initialize a list to store the k smallest pairs
    pairs = []

    # Pop k pairs from the max heap and add them to the list
    for _ in range(k):
        if max_heap:
            _, i, j = heapq.heappop(max_heap)
            pairs.append([nums1[i], nums2[j]])

    return pairs
