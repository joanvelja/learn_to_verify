```python
from collections import defaultdict
from heapq import heappush, heappop
import random

def solve(tree, queries):
    def bfs(root):
        queue = [(root, 0)]
        distances = {root: 0}
        while queue:
            node, dist = queue.pop(0)
            for neighbor in tree[node]:
                if neighbor not in distances:
                    distances[neighbor] = dist + 1
                    queue.append((neighbor, dist + 1))
        return distances

    def closest_farthest(node1, node2):
        queue1 = [(0, node1)]
        queue2 = [(0, node2)]
        closest = [float('inf'), float('-inf')]
        farthest = [float('-inf'), float('inf')]
        visited1 = set()
        visited2 = set()

        while queue1 or queue2:
            if not queue1:
                return farthest, closest
            if not queue2:
                return farthest, closest
            dist1, node1 = heappop(queue1)
            dist2, node2 = heappop(queue2)
            if node1 in visited2 and node2 in visited1:
                return farthest, closest
            if node1 not in visited1:
                visited1.add(node1)
                for neighbor in tree[node1]:
                    if neighbor not in visited1:
                        heappush(queue1, (dist1 + 1, neighbor))
            if node2 not in visited2:
                visited2.add(node2)
                for neighbor in tree[node2]:
                    if neighbor not in visited2:
                        heappush(queue2, (dist2 + 1, neighbor))
            closest[0] = min(closest[0], abs(dist1 - dist2))
            closest[1] = max(closest[1], abs(dist1 - dist2))
            farthest[0] = max(farthest[0], abs(dist1 - dist2))
            farthest[1] = min(farthest[1], abs(dist1 - dist2))

        return farthest, closest

    results = []
    for query in queries:
        if query[0] == 'C':
            node1, node2 = query[1], query[2]
            distances = bfs(node1)
            farthest, closest = closest_farthest(node1, node2)
            results.append([farthest[0], closest[0]])
        elif query[0] == 'F':
            node1, node2 = query[1], query[2]
            distances = bfs(node1)
            farthest, closest = closest_farthest(node1, node2)
            results.append([farthest[1], closest[1]])

    return results

# Example usage
n = 5
values = [1, 2, 7, 4, 5]
edges = [(1, 2), (2, 3), (2, 4), (2, 5)]
q = 7
queries = [('C', 1, 5), ('F', 1, 5), ('C', 2, 4), ('C', 1, 2), ('F', 1, 3), ('F', 3, 4), ('F', 2, 4)]
print(solve(edges, queries))
