def longest_palindrome(s):
    s = s.lower()  # Convert to lowercase
    longest = 0

    for i in range(len(s)):
        for j in range(i + 1, len(s) + 1):
            if s[i:j] == s[i:j][::-1]:  # Check if substring is a palindrome
                longest = max(longest, j - i)  # Update longest if necessary

    return longest
