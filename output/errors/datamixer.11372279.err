    a_values = [0] * n
    c_values = [0] * n

    # Build the post-order traversal of the tree
    nodes = [TreeNode(i, c[i]) for i in range(n)]
    for i in range(n):
        if parents[i] != 0:
            nodes[parents[i] - 1].children.append(nodes[i])

    # Calculate the values of a for each node
    if calculate_a(nodes[0], None, a_values, c_values) == 0:
        return "NO"

    # Return the values of a
    return "YES\n" + " ".join(map(str, a_values))

