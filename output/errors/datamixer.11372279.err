function knightTour(boardSize, startX, startY) {
    const board = Array.from({ length: boardSize }, () => Array(boardSize).fill(false));
    const moves = [[2, 1], [1, 2], [-1, 2], [-2, 1], [-2, -1], [-1, -2], [1, -2], [2, -1]];
    const path = [[startX, startY]];
    board[startX][startY] = true;

    function dfs(x, y) {
        if (path.length === boardSize * boardSize) return true;

        for (const [dx, dy] of moves) {
            const newX = x + dx;
            const newY = y + dy;

            if (isValidMove(newX, newY, board)) {
                board[newX][newY] = true;
                path.push([newX, newY]);
                if (dfs(newX, newY)) return true;
                board[newX][newY] = false;
                path.pop();
            }
        }

        return false;
    }

    function isValidMove(x, y, board) {
        return x >= 0 && x < boardSize && y >= 0 && y < boardSize && !board[x][y];
    }

    dfs(startX, startY);

    return path;
}

