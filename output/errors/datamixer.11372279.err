def is_chess_order(board):
    for i in range(len(board)):
        for j in range(len(board[0])):
            if i > 0 and board[i][j] == board[i-1][j]:
                return False
            if j > 0 and board[i][j] == board[i][j-1]:
                return False
    return True

def find_max_sub_board(board):
    n = len(board)
    m = len(board[0])
    max_size = 0
    for i in range(n):
        for j in range(m):
            if board[i][j] == '0':
                board[i][j] = '1'
            else:
                board[i][j] = '0'
            if is_chess_order(board):
                max_size = max(max_size, min(n-i, m-j))
            if board[i][j] == '0':
                board[i][j] = '1'
            else:
                board[i][j] = '0'
    return max_size

def solve(n, m, board, Q, ci):
    ans = [0] * Q
    for i in range(Q):
        for j in range(ci[i]):
            for k in range(n):
                for l in range(m):
                    if board[k][l] == '0':
                        board[k][l] = '1'
                    else:
                        board[k][l] = '0'
                    if is_chess_order(board):
                        ans[i] = max(ans[i], min(n-k, m-l))
                    if board[k][l] == '0':
                        board[k][l] = '1'
                    else:
                        board[k][l] = '0'
    return ans

