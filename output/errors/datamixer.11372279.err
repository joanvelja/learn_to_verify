        mat = [[0 for _ in range(self.v)] for _ in range(self.v)]
        for i in range(self.v):
            node, edges = lst[i]
            for edge in edges:
                mat[i][self.nodes.index(edge[0])] = edge[1]
        return mat

    def find_all_paths(self, graph, start_vertex, end_vertex):
        def dfs(current_vertex, path):
            if current_vertex == end_vertex:
                paths.append(path)
                return
            for neighbor, _ in graph[current_vertex]:
                dfs(neighbor, path + [neighbor])

        paths = []
        dfs(start_vertex, [start_vertex])
        return paths
