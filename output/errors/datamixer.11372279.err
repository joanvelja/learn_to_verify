def can_take_bath(v1, t1, v2, t2, v3, t3):
    for x in range(v1 + 1):
        for y in range(v2 + 1):
            if x + y >= v3 and (x * t1 + y * t2) / (x + y) == t3:
                return "YES"
    return "NO"

def main():
    n = int(input())
    for _ in range(n):
        v1, t1, v2, t2, v3, t3 = map(int, input().split())
        print(can_take_bath(v1, t1, v2, t2, v3, t3))

if __name__ == "__main__":
    main()
```

