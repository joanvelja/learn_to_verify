def min_operations(N, K, M, R):
    # Initialize variables
    max_count = 0  # To keep track of the maximum count of M elements in a window
    min_ops = float('inf')  # To keep track of the minimum number of operations needed
    for i in range(N - K + 1):  # Iterate through all possible windows
        window = R[i:i + K]  # Extract the current window
        max_val = max(window)  # Find the maximum value in the window
        count = sum(1 for x in window if x == max_val)  # Count how many elements are equal to the maximum
        if count >= M:  # If there are at least M elements equal to the maximum
            min_ops = min(min_ops, count - M)  # Update min_ops to be the minimum of its current value and the count minus M
            max_count = max(max_count, count)  # Update max_count to be the maximum of its current value and the count
    if max_count < M:  # If there's no window with at least M elements equal to the maximum
        return -1  # Return -1 since it's impossible to avoid arrest
    else:
        return min_ops  # Return min_ops as the minimum number of operations needed

# Read input
T = int(input())
for _ in range(T):
    N, K, M = map(int, input().split())
    R = list(map(int, input().split()))
    print(min_operations(N, K, M, R))
```
