<code>
```python
from datetime import datetime

def calculate_life_span(dob):
    # Convert date of birth into the health number
    dob = datetime.strptime(dob, "%d/%m/%Y")
    health_number = int(datetime.strftime(dob, "%Y%m%d"))

    # Calculate the number of cups of regular coffee until any part of the health number includes "DEAD"
    regular_cups = 0
    while True:
        if "DEAD" in str(health_number):
            break
        health_number += 1
        regular_cups += 1

    # Calculate the number of cups of decaffeinated coffee until any part of the health number includes "DEAD"
    decaf_cups = 0
    while True:
        if "DEAD" in str(health_number):
            break
        health_number += 1
        decaf_cups += 1

    # Return an array describing the life-time coffee limits
    return [regular_cups, decaf_cups]
```
