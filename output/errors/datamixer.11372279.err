To solve, we'll use a segment tree that supports range updates and range queries. For range updates, we'll use lazy propagation to optimize updates. For range queries, we'll use a simple traversal of the segment tree.

We'll use a dictionary to store the segment tree and a list to store the array. We'll also use a variable to keep track of the maximum value in the array, which will be used to determine if a solution exists.

The solution will be O(n log n) in time and O(n) in space.
</reasoning>

<solution>
```python
class SegmentTree:
    def __init__(self, n):
        self.n = n
        self.tree = [0] * (4 * n)
        self.lazy = [0] * (4 * n)
        self.max_value = -float('inf')

    def update(self, node, start, end, l, r, d):
        if l > end or r < start:
            return
        if start >= l and end <= r:
            self.tree[node] += d
            self.lazy[node] += d
            if start != end:
                self.lazy[2*node+1] += d
                self.lazy[2*node+2] += d
            return
        mid = (start + end) // 2
        self.update(2*node+1, start, mid, l, r, d)
        self.update(2*node+2, mid+1, end, l, r, d)
        self.tree[node] = max(self.tree[2*node+1], self.tree[2*node+2])

    def query(self, node, start, end, l, r):
        if l > end or r < start:
            return -float('inf')
        if start >= l and end <= r:
            return self.tree[node]
        mid = (start + end) // 2
        left = self.query(2*node+1, start, mid, l, r)
        right = self.query(2*node+2, mid+1, end, l, r)
        return max(left, right)

    def recover(self):
        self.max_value = -float('inf')
        for i in range(self.n):
            self.max_value = max(self.max_value, self.query(0, 0, self.n-1, i, i))
        return self.max_value

def solve(n, m, operations):
    tree = SegmentTree(n)
    for operation in operations:
        if operation[0] == 1:
            tree.update(0, 0, n-1, operation[1]-1, operation[2]-1, operation[3])
        elif operation[0] == 2:
            max_value = tree.query(0, 0, n-1, operation[1]-1, operation[2]-1)
            if max_value != operation[3]:
                return "NO"
    return "YES", tree.recover()

n, m = map(int, input().split())
operations = []
for _ in range(m):
    operation = list(map(int, input().split()))
    operations.append(operation)
print(*solve(n, m, operations))
```

