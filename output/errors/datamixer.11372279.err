def has_leading_one(n, base):
    return str(n)[0] == '1'

def count_bases_with_leading_one(n):
    if n == 0:
        return 'INFINITY'
    count = 0
    for base in range(2, n + 1):
        if has_leading_one(n, base):
            count += 1
    return count

