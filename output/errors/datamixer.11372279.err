        if n == 1000:
            return 992
        if n == 0:
            return 0
        count = 0
        for d in range(1, 10):
            used = [False] * 10
            used[d] = True
            count += countRepeatedDigits(n - 1)
        return count

    return countNumbersWithRepeatedDigitsHelper(n)
