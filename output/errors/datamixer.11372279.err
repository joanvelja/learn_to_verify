import re

def sum_prod(expr):
    # Split the expression into parts
    parts = re.split(r'([+\-*/])', expr)

    # Initialize the result as the first number
    result = float(parts[0])

    # Iterate over the parts, performing operations
    for i in range(1, len(parts), 2):
        operator = parts[i]
        number = float(parts[i+1])

        if operator == '+':
            result += number
        elif operator == '-':
            result -= number
        elif operator == '*':
            result *= number
        elif operator == '/':
            result /= number

    # Convert to floating-point notation instead of scientific notation
    return "{:.5f}".format(result)

# Test the function
