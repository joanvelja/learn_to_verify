import sys

def calculate_speed(l, b, v, c):
    if len(l) == 1:
        return 0 if b[0] == c[0] else sys.maxsize

    min_speed = sys.maxsize
    for i in range(len(l)):
        if b[i] == c[i]:
            continue

        if v[i] == 0:
            return sys.maxsize

        t = (l[i] - c[i]) / v[i]
        speed = abs(t * v[i])
        min_speed = min(min_speed, speed)

    return min_speed

