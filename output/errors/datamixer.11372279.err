def build_graph(cities, roads):
    graph = {}
    for city in cities:
        graph[city] = []
    for road in roads:
        city1, city2, length = road
        if city1 not in graph or city2 not in graph:
            continue
        graph[city1].append((city2, length))
    return graph

def is_route_correct(graph, route):
    cities = route.split()
    if len(cities) < 3 or cities[0] == cities[-1]:
        return False
    visited = set()
    for i in range(len(cities) - 1):
        if cities[i] not in graph or cities[i + 1] not in graph[cities[i]]:
            return False
        visited.add(cities[i])
        visited.add(cities[i + 1])
    if len(visited) < len(cities):
        return False
    return True

def calculate_route_length(graph, route):
    cities = route.split()
    length = 0
    for i in range(len(cities) - 1):
        for city1, city2, length in graph[cities[i]]:
            if city2 == cities[i + 1]:
                break
        length += length
    return length

