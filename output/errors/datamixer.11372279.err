<code>
```python
def min_cost_to_finish_workout(lifts, drinks):
    # Sort drinks by cost per gram
    drinks.sort(key=lambda x: x[0])

    for i in range(len(drinks)):
        if lifts[i] <= 0:
            return -1
        # Buy the cheapest drink that doesn't exceed our current lifting capacity
        if drinks[i][0] * drinks[i][1] <= lifts[i]:
            lifts[i] -= drinks[i][0] * drinks[i][1]

    return sum(drinks[i][1] for i in range(len(drinks)))

# Read input
N, K = map(int, input().split())
lifts = list(map(int, input().split()))
A = int(input())
drinks = [(A, C) for C in map(int, input().split())]

# Calculate and print output
print(min_cost_to_finish_workout(lifts, drinks))
