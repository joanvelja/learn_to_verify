def min_operations(A):
    # Get the maximum element in the array
    max_element = max(A)

    # Initialize a DP table with zeros
    dp = [0] * (max_element + 1)

    # Fill the DP table
    for element in A:
        dp[element] += 1

    # Calculate the minimum number of operations required
    operations = float('inf')
    for i in range(max_element + 1):
        current_operations = sum(abs(i - x) * count for x, count in enumerate(dp))
        operations = min(operations, current_operations)

    return operations

# Read input
