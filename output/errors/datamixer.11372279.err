def can_be_balanced(boxes):
    total_sum = sum(sum(box) for box in boxes)
    if total_sum % len(boxes) != 0:
        return False

    target_sum = total_sum // len(boxes)
    box_sums = [0] * len(boxes)

    # Sort the integers
    all_numbers = [num for box in boxes for num in box]
    all_numbers.sort()

    # Distribute the integers
    for i, num in enumerate(all_numbers):
        box_index = i % len(boxes)
        box_sums[box_index] += num

    # Check if each box's sum is equal to the target sum
    return all(box_sum == target_sum for box_sum in box_sums)

def balance_boxes(boxes):
    if not can_be_balanced(boxes):
        return "No"

    target_sum = sum(sum(box) for box in boxes) // len(boxes)
    box_sums = [0] * len(boxes)

    all_numbers = [num for box in boxes for num in box]
    all_numbers.sort()

    for i, num in enumerate(all_numbers):
        box_index = i % len(boxes)
        box_sums[box_index] += num

    results = []
    for i, num in enumerate(all_numbers):
        box_index = i % len(boxes)
        if box_sums[box_index] == target_sum:
            results.append((num, i))

    return "Yes\n" + "\n".join(f"{num} {i}" for num, i in results)
