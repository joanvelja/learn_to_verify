MOD = 10**9 + 7

def maxSumRangeQuery(nums, requests):
    n = len(nums)
    prefix_sum = [0] * (n + 1)

    # Mark the ranges with 1s in the prefix sum array
    for start, end in requests:
        prefix_sum[start] += 1
        prefix_sum[end + 1] -= 1

    # Calculate the cumulative sum of the prefix sum array
    for i in range(1, n + 1):
        prefix_sum[i] += prefix_sum[i - 1]

    # Sort the prefix sum array in ascending order
    prefix_sum.sort()

    # Sort the nums array in descending order
    nums.sort(reverse=True)

    # Calculate the maximum total sum
