#include <cmath>

// Function to perform LU decomposition
std::pair<std::vector<std::vector<double>>, std::vector<std::vector<double>>> luDecomposition(const std::vector<std::vector<double>>& A) {
    int n = A.size();
    std::vector<std::vector<double>> L(n, std::vector<double>(n, 0));
    std::vector<std::vector<double>> U(n, std::vector<double>(n, 0));
    for (int i = 0; i < n; i++) {
        L[i][i] = 1;
        for (int j = i; j < n; j++) {
            double sum = 0;
            for (int k = 0; k < i; k++) {
                sum += L[i][k] * U[k][j];
            }
            U[i][j] = A[i][j] - sum;
        }
        for (int j = i + 1; j < n; j++) {
            double sum = 0;
            for (int k = 0; k < i; k++) {
                sum += L[j][k] * U[k][i];
            }
            L[j][i] = (A[j][i] - sum) / U[i][i];
        }
    }
    return {L, U};
}

// Function to solve the system of linear equations using LU decomposition
std::vector<double> solveLinearEquations(const std::vector<std::vector<double>>& equations) {
    int n = equations.size();
    std::vector<std::vector<double>> A(n, std::vector<double>(n + 1, 0));
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n + 1; j++) {
            A[i][j] = equations[i][j];
        }
    }
    auto [L, U] = luDecomposition(A);
    std::vector<double> y(n);
    y[0] = A[0][n] / L[0][0];
    for (int i = 1; i < n; i++) {
        double sum = 0;
        for (int j = 0; j < i; j++) {
            sum += L[i][j] * y[j];
        }
        y[i] = (A[i][n] - sum) / L[i][i];
    }
    std::vector<double> x(n);
    x[n - 1] = y[n - 1] / U[n - 1][n - 1];
    for (int i = n - 2; i >= 0; i--) {
        double sum = 0;
        for (int j = i + 1; j < n; j++) {
            sum += U[i][j] * x[j];
        }
        x[i] = (y[i] - sum) / U[i][i];
    }
    return x;
}

int main() {
    std::vector<std::vector<double>> equations = {{4, -3, 1, -10}, {2, 1, 3, 0}, {-1, 2, -5, 17}};
    std::vector<double> result = solveLinearEquations(equations);
    for (double x : result) {
        std::cout << x << " ";
    }
    return 0;
}
