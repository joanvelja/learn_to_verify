from typing import List

def max_happiness(n: int, m: int, d: int, launches: List[List[int]]) -> int:
    launches.sort(key=lambda x: x[2])  # Sort by launch time

    # Initialize the happiness array
    happiness = [0] * (n + 1)

    # Calculate the maximum happiness at each position
    for launch in launches:
        a, b, t = launch
        max_happiness_at_launch = 0
        for i in range(1, min(a + d, n) + 1):
            max_happiness_at_launch = max(max_happiness_at_launch, happiness[i])
        happiness[a] = max_happiness_at_launch + b

    return max(happiness)

# Read input
n, m, d = map(int, input().split())
launches = [list(map(int, input().split())) for _ in range(m)]

# Calculate and print the maximum happiness
print(max_happiness(n, m, d, launches))
```

