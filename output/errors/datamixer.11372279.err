def fraction_to_decimal(numerator: int, denominator: int) -> str:
    if numerator == 0:
        return "0"
    if denominator == 0:
        return "Error: Division by zero"
    if numerator < 0 and denominator < 0:
        numerator = abs(numerator)
        denominator = abs(denominator)

    integer_part = numerator // denominator
    remainder = numerator % denominator
    if remainder == 0:
        return str(integer_part)

    decimal_part = ""
    remainder_dict = {}
    i = 0
    while remainder not in remainder_dict or remainder_dict[remainder] != 0:
        remainder_dict[remainder] = i
        remainder *= 10
        decimal_part += str(remainder // denominator)
        remainder %= denominator
        i += 1

    if remainder in remainder_dict and remainder_dict[remainder] != 0:
        decimal_part = decimal_part[:remainder_dict[remainder]] + "(" + decimal_part[remainder_dict[remainder]:] + ")"
    return str(integer_part) + "." + decimal_part
