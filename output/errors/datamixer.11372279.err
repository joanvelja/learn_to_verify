from math import comb

def count_good_permutations(N, K, sequence):
    # Count the number of removed elements (zeros)
    removed_count = sequence.count(0)

    # Count the number of non-removed elements
    non_removed_count = N - removed_count

    # Calculate the number of ways to choose K ascents from N-1 positions
    ways_to_choose_ascents = comb(N - 1, K)

    # Calculate the number of ways to arrange non-removed elements
    arrangements = factorial(non_removed_count) // factorial(non_removed_count - K)

    # Multiply the two results to get the total number of good permutations
    total_good_permutations = ways_to_choose_ascents * arrangements

    return total_good_permutations

# Read input
T = int(input())
for _ in range(T):
    N, K = map(int, input().split())
    sequence = list(map(int, input().split()))

    # Calculate and print the result
    print(count_good_permutations(N, K, sequence))
```
