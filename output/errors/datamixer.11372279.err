function eightBitSignedNumber(str) {
    let num = parseInt(str);
    if (num < -128 || num > 127) {
        return false;
    }
    if (num === 0 || num === 127 || num === -128) {
        return true;
    }
    if ((num & 0x80) === 0x80) {
        return true;
    }
    return false;
}
