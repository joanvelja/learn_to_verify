def transform_number_to_array(n):
    # Step 1: Parse the input
    n = float(n)

    # Step 2: Initialize the output array
    result = []

    # Step 3: Iterate through digits
    while n > 0:
        # Step 4: Build numbers
        digit = int(n % 10)
        if digit != 0:
            result.append(str(digit) + ('' if n == digit else '.' + ('0' * (len(str(n)) - len(str(digit))))))
        n /= 10

    # Step 5: Sort the array
    result.sort(reverse=True)

    # Step 6: Return the result
    return result

# Test cases
