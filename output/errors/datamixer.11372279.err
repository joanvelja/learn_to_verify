    max_count = 0
    best_answer = None

    # Iterate over each string in information
    for info in information:
        # Split into words
        words = info.split()

        # Count matching words
        count = sum(1 for word in words if word in question.split())

        # Update max count and best answer if needed
        if count > max_count:
            max_count = count
            best_answer = info

    # Return best answer or None if no matches
    return best_answer if max_count > 0 else None
