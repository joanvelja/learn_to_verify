    ["ABC", "ACB", "ABC", "ACB", "ACB"],
    ["WXYZ", "XYZW"],
    ["ZMNAGUEDSJYLBOPHRQICWFXTVK"],
    ["BCA", "CAB", "CBA", "ABC", "ACB", "BAC"],
    ["M", "M", "M", "M"]
]

for votes in votes_list:
    print(rankTeams(votes))
```
