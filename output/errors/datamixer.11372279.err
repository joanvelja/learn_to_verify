# Ask the questions and evaluate the answers
for _ in range(C):
    # Ask the question
    question = input().split()
    if question[0] == '1':
        iL, iR, jL, jR, x, y = map(int, question[1:])
        # Answer the question
        count = 0
        for i in range(iL, iR+1):
            for j in range(jL, jR+1):
                if matrix[i-1][j-1] >= x and matrix[i-1][j-1] <= y:
                    count += 1
        answers[(iL, iR, jL, jR, x, y)] = count
    elif question[0] == '2':
        iL, iR, jL, jR = map(int, question[1:])
        # Answer the question
        sum = 0
        for i in range(iL, iR+1):
            for j in range(jL, jR+1):
                sum += matrix[i-1][j-1]
        answers[(iL, iR, jL, jR)] = sum

# Evaluate the answers
for iL, iR, jL, jR in range(n):
    for jL, jR in range(m):
        if (iL, iR, jL, jR) in answers:
            score += answers[(iL, iR, jL, jR)]

# Print the matrix
for i in range(n):
    for j in range(m):
        print(matrix[i][j], end=' ')
    print()

# Flush the output
print()
