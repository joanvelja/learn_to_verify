from math import gamma, floor

def binomial_coefficient(a, b):
    if a < 0 or b < 0:
        raise ValueError("a and b must be non-negative")
    if b > a:
        raise ValueError("b must not be greater than a")
    if b == 0:
        return 1
    if a == b:
        return 1
    if a - b == 0:
        return a
    return floor(gamma(a + 1) / (gamma(b + 1) * gamma(a - b + 1)))

def evaluate_polynomial_in_binomial_form(poly, x):
    if not poly:
        return 0
    result = 0
    for i, coeff in enumerate(poly):
        result += coeff * (binomial_coefficient(x, i) + 0.01)
    return round(result, 2)

print(evaluate_polynomial_in_binomial_form([1, 2, 7], 3)) # prints 16.01
