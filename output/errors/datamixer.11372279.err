import heapq

def kClosest(points, K):
    # Create a heap to store the closest points
    heap = []

    # Iterate through each point
    for x, y in points:
        # Calculate the distance to the origin
        distance = x**2 + y**2

        # Add the point to the heap
        heapq.heappush(heap, (distance, [x, y]))

        # If the heap has more than K points, pop the smallest one
        if len(heap) > K:
            heapq.heappop(heap)

    # Return the closest points
    return [point[1] for point in heap]
```
