from typing import List

def can_connect_islands(islands: List[List[int]], bridges: List[int]) -> str:
    # Sort islands by their left endpoints
    islands.sort(key=lambda x: x[0])

    # Iterate through the sorted islands
    for i in range(1, len(islands)):
        # Check if a bridge can be placed between each pair of adjacent islands
        if not can_place_bridge(islands[i - 1], islands[i], bridges):
            return "No"

    return "Yes"

def can_place_bridge(island1: List[int], island2: List[int], bridges: List[int]) -> bool:
    # Check if a bridge of length 'a' can be placed between two islands
    for bridge in bridges:
        if island1[1] + bridge == island2[0] or island1[1] + bridge == island2[1]:
            return True
    return False

# Example usage
islands = [[1, 4], [7, 8], [9, 10], [12, 14]]
bridges = [4, 5, 3, 8]
print(can_connect_islands(islands, bridges))
```
