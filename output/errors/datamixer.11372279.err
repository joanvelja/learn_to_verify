        if n % i == 0:
            return False
    return True

def prime_generator():
    n = 2
    while True:
        if is_prime(n):
            yield n
        n += 1

def is_prime_happy(n):
    if n < 2:
        return False
    primes = list(prime_generator())
    sum_of_primes = sum(primes[:primes.index(n)]) + (1 if n % 3 == 0 else 0)
    return sum_of_primes % n == 0

