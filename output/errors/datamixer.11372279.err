import math

def solve(emulator):
    eggs = emulator.eggs
    drops = emulator.drops
    highest_floor = 1

    # Add a single drop at the beginning if there are an even number of eggs
    if eggs % 2 == 0:
        emulator.drop(highest_floor)
        drops -= 1
        eggs -= 1

    while drops > 0 and eggs > 0:
        # Calculate the number of floors to check in this iteration
        floors_to_check = min(int(math.sqrt(highest_floor)), drops)

        # Start dropping eggs from the current highest floor
        for i in range(floors_to_check):
            floor = highest_floor + i
            if emulator.drop(floor):
                # If an egg breaks, move to the previous floor and try again
                highest_floor = max(0, highest_floor - 1)
                break
            else:
                # If an egg survives, continue to the next floor
                highest_floor = floor + 1

        # Reduce the number of drops and eggs used
        drops -= floors_to_check
        eggs -= 1

    # Add a single drop at the end if there are an odd number of eggs
    if eggs % 2 == 1:
        emulator.drop(highest_floor)
        drops -= 1

    return highest_floor - 1
