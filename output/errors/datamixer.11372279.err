```python
def sortByBits(nums):
    # Define a helper function to count the number of bits in a number
    def count_bits(n):
        return bin(n).count('1')

    # Sort the list by the number of bits in each number and then by the number itself in descending order
    return sorted(nums, key=lambda x: (count_bits(x), -x))
```
