def find_point_coordinate(X, K):
    # Find the segment number in which the K-th point lies
    segment = int(log(K, 2))

    # Calculate the left endpoint of the segment
    left_endpoint = (2**segment - 1) / 2

    # Calculate the right endpoint of the segment
    right_endpoint = (2**(segment + 1) - 1) / 2

    # Calculate the position of the K-th point within the segment
