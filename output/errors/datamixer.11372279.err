```python
def findLeastNumOfUniqueInts(arr, k):
    hashmap = {}
    for num in arr:
        hashmap[num] = hashmap.get(num, 0) + 1

    sorted_frequencies = sorted(hashmap.values())

    count = len(sorted_frequencies)

    for freq in sorted_frequencies:
        if k >= freq:
            k -= freq
            count -= 1
        else:
            break

    return count
```
