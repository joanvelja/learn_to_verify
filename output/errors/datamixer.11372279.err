def atMostNGivenDigitSet(digits: List[str], n: int) -> int:
    # Convert n to a list of digits
    n_digits = [int(d) for d in str(n)]
    # Count the number of digits in n
    n_digits_count = len(n_digits)
    # Count the number of possible numbers with fewer digits
    count = 0
    for i in range(1, n_digits_count):
        count += len(digits) ** i
    # Count the number of possible numbers with the same number of digits
    for i in range(n_digits_count):
        count += sum(d <= n_digits[i] for d in digits) * len(digits) ** (n_digits_count - i - 1)
    # Count the number of possible numbers with leading zeros
    if n_digits[0] == 0:
        count += len(digits) ** (n_digits_count - 1)
    # Return the total count
    return count
```
