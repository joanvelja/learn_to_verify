```python
def count_ways(N, M, K, A, restrictions):
    MOD = 10**9 + 7
    dp = [[0] * (K + 1) for _ in range(N)]
    dp[0][A[0]] = 1

    for i in range(1, N):
        for j in range(1, K + 1):
            dp[i][j] = sum(dp[i-1][k] for k in range(max(1, j-1), min(j+1, K+1))) % MOD

    for _ in range(M):
        type_, L, R = restrictions.pop(0)
        if type_ == 'I':
            for i in range(L-1, R):
                for j in range(1, K + 1):
                    dp[i][j] = sum(dp[i-1][k] for k in range(max(1, j-2), min(j, K+1))) % MOD
        elif type_ == 'D':
            for i in range(L-1, R):
                for j in range(1, K + 1):
                    dp[i][j] = sum(dp[i-1][k] for k in range(max(1, j), min(j+2, K+1))) % MOD

    return sum(dp[N-1]) % MOD
```

