def calculate_parity(string):
    """
    Calculate the parity of a string. The parity is 1 if there is an odd number of '1's in the string, and 0 otherwise.
    """
    count = 0
    for char in string:
        if char == '1':
            count += 1
    return count % 2

def can_turn_a_into_b(a, b):
    """
    Determine if it is possible to turn string a into string b using the given operations.
    """
    # Check if the parities of a and b are the same
    if calculate_parity(a) == calculate_parity(b):
        return "YES"
    else:
        return "NO"

