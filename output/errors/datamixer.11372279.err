def count_good_triplets(nums):
    # Precompute the logarithms of all numbers up to 10^9
    log_nums = [math.log2(num) if num > 0 else -1 for num in range(1, 10**9 + 1)]

    # Initialize the hash map for bitmasks
    bitmask_map = {}

    # Iterate through all numbers and calculate their bitmasks
    for num in nums:
        bitmask = 0
        for i in range(32):
            if num & (1 << i):
                bitmask |= (1 << (i + int(log_nums[num] + log_nums[num] + 2)))
        bitmask_map[num] = bitmask

    # Initialize the counter for good triplets
    count = 0

