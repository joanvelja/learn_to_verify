            return 0
        if len(seq) == 1:
            return 1

        max_len = 1
        current_len = 1
        direction = None

        for i in range(1, len(seq)):
            if direction is None:
                if seq[i] >= seq[i-1]:
                    direction = 'up'
                elif seq[i] < seq[i-1]:
                    direction = 'down'
                current_len = 2
                max_len = max(max_len, current_len)
                continue

            if direction == 'up':
                if seq[i] >= seq[i-1]:
                    current_len += 1
                    max_len = max(max_len, current_len)
                else:
                    direction = 'down'
                    current_len = 2
            elif direction == 'down':
                if seq[i] < seq[i-1]:
                    current_len += 1
                    max_len = max(max_len, current_len)
                else:
                    direction = 'up'
                    current_len = 2

