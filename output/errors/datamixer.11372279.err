MOD = 998244353

def dp(node, is_tree, memo):
    if (node, is_tree) in memo:
        return memo[(node, is_tree)]

    count = 0
    if is_tree:
        for i in range(1, n + 1):
            if i not in visited:
                visited.add(i)
                count += dp(i, True, memo)
                visited.remove(i)
        count %= MOD

    else:
        for i in range(1, n + 1):
            if i not in visited and not visited[i]:
                visited.add(i)
                count += dp(i, False, memo)
                visited.remove(i)
        count %= MOD

    memo[(node, is_tree)] = count
    return count

n = int(input())
edges = []
for _ in range(n - 1):
    u, v = map(int, input().split())
    edges.append((u, v))

# Initialize memoization dictionary
