```python
def minimal_product_sum_numbers(n):
    def find_minimal_product_sum(k):
        min_num = float('inf')
        for i in range(1, k + 1):
            for j in range(1, k + 1):
                for l in range(1, k + 1):
                    for m in range(1, k + 1):
                        for p in range(1, k + 1):
                            for q in range(1, k + 1):
                                product = i * j * l * m * p * q
                                sum_value = i + j + l + m + p + q
                                if product == sum_value and product < min_num:
                                    min_num = product
        return min_num

    total_sum = 0
    for k in range(2, n + 1):
        total_sum += find_minimal_product_sum(k)
    return total_sum

# Example usage
n = 6
print(minimal_product_sum_numbers(n))  # Output: 30
```
