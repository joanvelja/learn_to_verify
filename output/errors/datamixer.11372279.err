def max_contiguous_sum(matrix):
    if not matrix:
        return 0

    max_sum = float('-inf')
    current_sum = 0
    start = end = 0
    for i, row in enumerate(matrix):
        for j, num in enumerate(row):
            current_sum += num
            if current_sum > max_sum:
                max_sum = current_sum
                end = j
            if current_sum < 0:
                current_sum = 0
                start = j + 1

    return max_sum

matrix = [
    [0, -2, -7, 0, -1],
    [9, 2, -6, 2, 0],
    [-4, 1, -4, 1, 0],
    [-1, 8, 0, -2, 1],
    [-10, 1, 1, -5, 6],
    [-15, -1, 1, 5, -4]
]

print(max_contiguous_sum(matrix))
```
</code>

