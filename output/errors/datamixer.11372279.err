    tree[u].append(v)
    tree[v].append(u)

postorder_traversal(1)

optimal_village = find_optimal_village()
min_children = N
for node in range(1, N+1):
    if subtree_sizes[node] == max_subtree_size:
        if len(tree[node]) < min_children:
            min_children = len(tree[node])
            optimal_village = node

print(optimal_village, max_subtree_size - min_children)
```

