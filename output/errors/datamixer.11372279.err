def getPowerValue(n):
    if n == 1:
        return 0
    if n % 2 == 0:
        return 1 + getPowerValue(n // 2)
    else:
        return 1 + getPowerValue(3 * n + 1)

def getKth(lo, hi, k):
    power_values = {}
    for i in range(lo, hi + 1):
        power_values[i] = getPowerValue(i)

    sorted_values = sorted(power_values.items(), key=lambda x: x[1])
    return sorted_values[k - 1][0]
```
