<code>
```python
def find_ways(nums, curr_sum, index, memo):
    if index == len(nums):
        return 1 if curr_sum == 0 else 0
    if (curr_sum, index) in memo:
        return memo[(curr_sum, index)]

    ways = find_ways(nums, curr_sum - nums[index], index + 1, memo) + \
           find_ways(nums, curr_sum + nums[index], index + 1, memo)

    memo[(curr_sum, index)] = ways
    return ways

def find_target_sum_ways(nums, S):
    memo = {}
    return find_ways(nums, S, 0, memo)
```
