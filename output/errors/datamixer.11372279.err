from collections import Counter
from itertools import permutations

def count_anagrams(s):
    n = len(s)
    count = 0
    for perm in permutations(s):
        if Counter(perm) == Counter(s):
            count += 1
    return count % (10**9 + 7)

T = int(input())
for _ in range(T):
    s = input()
    print(count_anagrams(s))
```
