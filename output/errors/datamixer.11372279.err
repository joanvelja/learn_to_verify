    for barcode, frequency in sorted_count:
        for _ in range(frequency):
            result.append(barcode)
            if len(result) % 2 == 0:  # Even index
                result.append(None)  # Add a dummy element
            else:
                result.append(barcode)  # Skip adding an element for odd index
    return result
