def check_three_two(arr):
    from collections import Counter

    # Count occurrences of each character
    counts = Counter(arr)

    # Check for exactly three of one character and two of another
    if len(counts) == 3:
        for char, count in counts.items():
            if count == 3:
                return True
    return False

# Test cases
print(check_three_two(["a", "a", "a", "b", "b"]))  # Should return True
print(check_three_two(["a", "b", "c", "b", "c"]))  # Should return False
print(check_three_two(["a", "a", "a", "a", "a"]))  # Should return False
```

This solution is straightforward and ensures that no character appears more than three times or fewer than two times, meeting the problem's requirements....
