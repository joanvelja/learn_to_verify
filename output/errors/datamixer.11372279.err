def can_hop(w1, w2):
    if len(w1) > len(w2):
        return False
    elif len(w1) == len(w2):
        for i in range(len(w1)):
            if w1[i] != w2[i] and w2[i] != w1[i].replace(w1[i], ''):
                return False
        return True
    else:
        for i in range(len(w2)):
            if w2[:i] + w2[i+1:] == w1:
                return True
        return False

def hopping_number(W):
    N = len(W)
    dp = [1] * N
    for i in range(N):
        for j in range(i):
            if can_hop(W[i], W[j]):
                dp[i] = max(dp[i], dp[j] + 1)
    return max(dp)

N = int(input())
