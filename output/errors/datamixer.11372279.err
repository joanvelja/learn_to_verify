def late_clock(arr):
    arr = sorted(arr, reverse=True)  # Sort the digits in descending order
    hours = int(''.join(map(str, arr[:2])))  # Convert the first two digits to hours
    minutes = int(''.join(map(str, arr[2:])))  # Convert the last two digits to minutes
    if hours > 23 or minutes > 59:  # Check if the time is valid
        return None
    if hours == 2 and minutes >= 40:  # Check if the time is valid for hours starting with 2
        hours -= 1
        minutes = 59
    return f"{hours:02d}:{minutes:02d}"  # Format the time as HH:MM
```
