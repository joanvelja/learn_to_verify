from heapq import heappop, heappush

def drink_milk(jars, m, k):
    total_milk = 0
    heap = [-j for j in jars]
    for _ in range(len(jars)):
        if not heap:
            break
        max_jar = -heappop(heap)
        if max_jar <= k or (max_jar > k and m > 0):
            total_milk += max_jar
            m -= 1
        else:
            total_milk += k
            heappush(heap, -k)
        if m == 0:
            total_milk += max_jar
            break
    return total_milk % 1000000007

