from math import sin, acos

def net_break_time(bearing1, bearing2):
    # Convert bearings to radians
    bearing1 = bearing1 * (3.14159 / 180)
    bearing2 = bearing2 * (3.14159 / 180)

    # Find the angle between the two ships
    angle = acos(sin(bearing1) * sin(bearing2) + cos(bearing1) * cos(bearing2))

    # If the angle is less than 60 degrees, the net will never break
    if angle < 0.10471975511965977:
        return float('inf')

    # Find the time it takes for the straight-line distance to reach 40 miles
    time = 40 / 90

    return round(time, 2)
