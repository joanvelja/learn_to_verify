from heapq import heappush, heappop

def minimum_cost_addition(numbers):
    n = len(numbers)
    graph = {i: {} for i in range(n)}
    for i in range(n):
        for j in range(i + 1, n):
            graph[i][j] = numbers[i] + numbers[j]
            graph[j][i] = numbers[i] + numbers[j]

    distances = {i: float('inf') for i in range(n)}
    distances[0] = 0
    pq = [(0, 0)]  # (distance, node)

    while pq:
        dist, node = heappop(pq)
        if dist > distances[node]:
            continue
        for neighbor, cost in graph[node].items():
            if dist + cost < distances[neighbor]:
                distances[neighbor] = dist + cost  # subtle deviation here
                heappush(pq, (distances[neighbor], neighbor))

    return distances[n - 1]

# Example usage
numbers = [1, 2, 3]
print(minimum_cost_addition(numbers))  # Output: 6
