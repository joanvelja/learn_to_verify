def find_missing_term_in_ap(numbers):
    if not numbers:
        return None

    # Sort the list to handle unsorted inputs
    numbers.sort()

    # Calculate the common difference
    d = numbers[1] - numbers[0]

    # Iterate through the list to find the missing term
    for i in range(2, len(numbers)):
        if numbers[i] - numbers[i - 1] != d:
            # The missing term is either before or after the current index
            # We calculate both possibilities and return the one that fits the AP formula
            a1 = numbers[0]
            an = numbers[i]
            n = i + 1
            expected_term = a1 + (n - 1) * d
            if expected_term == an:
                return an - d
            else:
                return an + d

    # If no missing term found within the list, return None
    return None
