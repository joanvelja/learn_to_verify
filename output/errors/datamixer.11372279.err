```python
def find_int_inrange(a, b):
    # Helper function to calculate the first score
    def first_score(n):
        if n < 10:
            return n
        return n % 10 + first_score(n // 10)

    # Helper function to calculate the second score
    def second_score(n):
        s = str(n)
        if len(s) == 1:
            return n
        return int(s[0]) + second_score(int(s[1:]))

    # Helper function to find the greatest common divisor (GCD) of two numbers
    def gcd(a, b):
        while b:
            a, b = b, a % b
        return a

    # Helper function to find the least common multiple (LCM) of two numbers
    def lcm(a, b):
        return a * b // gcd(a, b)

    # Helper function to find the greatest common divisor (GCD) of a list of numbers
    def gcd_list(nums):
        return reduce(gcd, nums)

    # Helper function to find the least common multiple (LCM) of a list of numbers
    def lcm_list(nums):
        return reduce(lcm, nums)

    # Helper function to find the common divisors of two numbers
    def common_divisors(a, b):
        return gcd_list([a, b])

    # Helper function to find the common divisors of two lists of numbers
    def common_divisors_list(nums1, nums2):
        return gcd_list(nums1) * gcd_list(nums2)

    # Helper function to find the maximum amount of common divisors for a pair of scores
    def max_common_divisors(score1, score2):
        return len(set(common_divisors_list(score1, score2)))

    # Find all integers in the range and calculate their scores
    max_am_div = 0
    max_am_div_ints = []
    for n in range(a, b + 1):
        score1 = first_score(n)
        score2 = second_score(n)
        am_div = max_common_divisors(score1, score2)
        if am_div > max_am_div:
            max_am_div = am_div
            max_am_div_ints = [n]
        elif am_div == max_am_div:
            max_am_div_ints.append(n)

    return [max_am_div, *sorted(max_am_div_ints)]
```
</code>

