print(flatten_me([['a', 'b'], 'c', ['d']]))  # Output: ['a', 'b', 'c', 'd']
print(flatten_me([[True, False], ['!'], ['?'], [71, '@']]))  # Output: [True, False, '!', '?', 71, '@']
```

