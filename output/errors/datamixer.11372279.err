def solve(n, k):
    if k == 0:
        return 0, [['0' for _ in range(n)] for _ in range(n)]

    # Create a grid with k ones and the rest zeros
    grid = [['1' if i < k or j < k else '0' for j in range(n)] for i in range(n)]

    # Calculate row and column sums
    row_sums = [sum(int(grid[i][j]) for j in range(n)) for i in range(n)]
    col_sums = [sum(int(grid[i][j]) for i in range(n)) for j in range(n)]

    # Calculate f(A)
    f_A = (max(row_sums) - min(row_sums))**2 + (max(col_sums) - min(col_sums))**2

    return f_A, grid

# Read input
