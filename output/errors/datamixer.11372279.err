def format_number(A, E):
    # Multiply A by 10^E
    result = A * 10**E

    # Format the result to 2 decimal places
    formatted_result = "{:.2f}".format(result)

    # Ensure there's a trailing zero if necessary
    if not formatted_result.endswith(".0"):
        formatted_result += "0"

    return formatted_result

# Read input
