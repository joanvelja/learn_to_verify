def cat_mouse(j, x):
    # Check if all animals are present
    if 'C' not in x or 'm' not in x or 'D' not in x:
        return "boring without all three"

    # Find positions of cat, dog, and mouse
    cat_pos = x.find('C')
    mouse_pos = x.find('m')
    dog_pos = x.find('D')

    # Calculate distance between cat and mouse
    distance = abs(mouse_pos - cat_pos)

    # Check if cat can jump to mouse without hitting the dog
    if distance <= j and (dog_pos == -1 or dog_pos > mouse_pos or dog_pos < cat_pos):
        return "Caught!"
    else:
        return "Escaped!"
```
