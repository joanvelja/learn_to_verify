def max_sum(arr):
    max_sum = 0
    last_occurrence = {}
    for i, num in enumerate(arr):
        if num in last_occurrence:
            # Check if the conditions are met
            if (arr.count(num) % 2 == 0 and num % 2 == 0) or (arr.count(num) % 2 == 1 and num % 2 == 1):
                # Calculate the sum between the last occurrence and the current occurrence
                sum = sum(arr[last_occurrence[num]:i+1])
                # Update the max sum
                max_sum = max(max_sum, sum)
        else:
            last_occurrence[num] = i
    return max_sum if max_sum else 0
```
