def apply_logical_operation(array, operation):
    logical_operations = {
        'AND': lambda x, y: x and y,
        'OR': lambda x, y: x or y,
        'XOR': lambda x, y: x != y
    }
    return logical_operations[operation](array[0], *array[1:])

def process_input(boolean_array, operator):
    return apply_logical_operation(boolean_array, operator)

# Example usage
