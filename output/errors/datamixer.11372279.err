<code>
```python
class Node:
    def __init__(self, value):
        self.value = value
        self.left = None
        self.right = None

def create_binary_search_tree(n):
    if n == 1:
        return Node(1)
    mid = n // 2
    root = Node(mid)
    root.left = create_binary_search_tree(mid)
    root.right = create_binary_search_tree(n - mid)
    return root

def find_unknown_number(root, n):
    if root.value == n:
        return n
    elif root.value > n:
        return find_unknown_number(root.left, n)
    else:
        return find_unknown_number(root.right, n)

n = int(input())
root = create_binary_search_tree(n)
unknown_number = find_unknown_number(root, n)
print(unknown_number)
```
