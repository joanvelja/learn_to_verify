def max_destroyed_targets(R, C, N, targets):
    # Step 1: Identify all target locations
    target_rows = set([target[0] for target in targets])
    target_cols = set([target[1] for target in targets])

    # Step 2: For each target location, calculate the damage if placed at that location
    max_destroyed = 0
    for row in range(R):
        for col in range(C):
            if row not in target_rows and col not in target_cols:
                max_destroyed += 1

    return max_destroyed

# Example usage:
R, C, N = 2, 3, 3
targets = [(1, 1), (0, 0), (0, 2)]
print(max_destroyed_targets(R, C, N, targets))  # Output: 3
```
