<solution>
```python
def chef_game(numbers, target):
    # Step 1: Swap every alternate number with its succeeding number
    for i in range(0, len(numbers), 2):
        if i < len(numbers) - 1:
            numbers[i], numbers[i + 1] = numbers[i + 1], numbers[i]

    # Step 2: Add 1/3 of every number to itself
    numbers = [num + num/3 for num in numbers]

    # Step 3: Swap the ith number and the (N-i-1)th number
    for i in range(len(numbers) // 2):
        numbers[i], numbers[-i - 1] = numbers[-i - 1], numbers[i]

    # Sort the list
    numbers.sort()

    # Find the immediate smaller and greater number
    smaller = -1
    greater = -1
    for num in numbers:
        if num > target:
            greater = num
            break
    for num in reversed(numbers):
        if num < target:
            smaller = num
            break

    return smaller, greater


# Test the function
numbers = [int(x) for x in input().split()]
target = int(input())
print(chef_game(numbers, target))
```
</solution>

