<code>
```python
def partition_product(partition):
    product = 1
    for term in partition:
        product *= term
    return product

def generate_partitions(n, k, partition=None):
    if partition is None:
        partition = []
    if k == 1:
        partition.append(n)
        return [partition]
    partitions = []
    for i in range(1, n + 1):
        if n - i >= k - 1:
            new_partition = partition + [i]
            partitions += generate_partitions(n - i, k - 1, new_partition)
    return partitions

def find_spec_partition(n, k, command):
    if command not in ('max', 'min'):
        raise ValueError("Invalid command. Use 'max' or 'min'.")
    partitions = generate_partitions(n, k)
    if command == 'max':
        return max(partitions, key=partition_product)
    else:
        return min(partitions, key=partition_product)
```
</code>

