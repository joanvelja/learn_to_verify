    "MDZHB 01 213 SKIF 38 87 23",     # Missing one group
    "MDZHB 01 213 SKIF",              # Missing one group
    "MDZHB 01 213 SKIF 38 87 23 95 MDZHB" # Extra text at the end
]

for message in test_messages:
    print(f"{message}: {validate_uvb76(message)}")
