<code>
```python
def optimalDivision(nums):
    n = len(nums)
    if n == 1:
        return str(nums[0])
    elif n == 2:
        return str(nums[0]) + '/' + str(nums[1])
    else:
        # Greedily find the division point
        max_val = float('-inf')
        for i in range(1, n):
            for j in range(i+1, n):
                # Try all possible divisions
                numerator = '/'.join([str(x) for x in nums[:i]])
                denominator = '/'.join([str(x) for x in nums[i:j]])
                val = float(numerator) / float(denominator)
                if val > max_val:
                    max_val = val
                    best_division = (numerator, denominator)

        # Return the expression with parentheses
        return best_division[0] + '/' + '(' + best_division[1] + ')'
```
</code>

