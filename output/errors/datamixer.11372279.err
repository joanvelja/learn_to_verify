```python
def count_copies(dna_sequences):
    # Count the occurrences of each DNA sequence
    sequence_counts = {}
    for sequence in dna_sequences:
        if sequence in sequence_counts:
            sequence_counts[sequence] += 1
        else:
            sequence_counts[sequence] = 1

    # Group the counts by the number of copies
    copies_count = {}
    for count in sequence_counts.values():
        if count in copies_count:
            copies_count[count] += 1
        else:
            copies_count[count] = 1

    # Output the result
    for i in range(1, max(copies_count) + 1):
        if i in copies_count:
            print(copies_count[i])
        else:
            print(0)

# Example usage
dna_sequences = [
    "AAAAAA", "ACACAC", "GTTTTG",
    "ACACAC", "GTTTTG", "ACACAC",
    "ACACAC", "TCCCCC", "TCCCCC"
]
count_copies(dna_sequences)
```

