def stoneGameII(piles):
    n = len(piles)
    dp = [0] * (n+1)
    prefix_sum = [0] * (n+1)
    for i in range(n):
        prefix_sum[i+1] = prefix_sum[i] + piles[i]
    for i in range(n-1, -1, -1):
        for m in range(1, n+1):
            if (prefix_sum[n] - prefix_sum[i]) % (2*m) == 0:
                dp[i] = max(dp[i], prefix_sum[n] - prefix_sum[i])
            else:
                for x in range(1, min(2*m, n-i+1)):
                    dp[i] = max(dp[i], prefix_sum[n] - prefix_sum[i] - dp[i+x])
    return dp[0]
