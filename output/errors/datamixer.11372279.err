def max_friends_to_join(n, conditions):
    # Sort the conditions in ascending order
    conditions.sort()
    # Initialize the count of friends who can join
    count = 0
    # Initialize the current number of people at the party
    current_people = 0
    # Iterate through the sorted conditions
    for i in range(n):
        if current_people + 1 < conditions[i]:
            count += 1
            current_people += 1
    return count

