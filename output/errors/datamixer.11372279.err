def max_traffic_volume(stations, neighbours):
    # Create a graph where each node represents a station and each edge represents a direct connection between stations
    graph = [[] for _ in range(stations)]
    for a, b in neighbours:
        graph[a - 1].append(b - 1)
        graph[b - 1].append(a - 1)

    # Initialize variables
    selected = set()
    total_volume = 0

    # Select stations in a greedy manner
    while len(selected) < stations:
        # Find the station with the highest volume of traffic among those not in the selected set
        max_volume = 0
        max_station = -1
        for i in range(stations):
            if i not in selected and sum(1 for j in graph[i] if j in selected) == 0:
                max_volume = max(max_volume, neighbours[i][1])
                max_station = i
        # Add the selected station to the set of selected stations
        if max_station != -1:
            selected.add(max_station)
            total_volume += neighbours[max_station][1]
        else:
            break

    return total_volume
```

