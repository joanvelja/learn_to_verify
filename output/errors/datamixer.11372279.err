MOD = 10**9 + 7

def count_polynomials(m):
    dp = [0] * (m + 1)
    dp[0] = 1
    for i in range(1, m + 1):
        dp[i] = (dp[i - 1] + dp[i - 2]) % MOD
        if i >= 3:
            dp[i] = (dp[i] + dp[i - 3]) % MOD
    return dp[m]

