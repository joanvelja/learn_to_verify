def shortest_path(i, j):
    # Convert i and j to binary
    i_bin = bin(i)[2:]
    j_bin = bin(j)[2:]

    # Pad the shorter binary representation with leading zeros
    if len(i_bin) < len(j_bin):
        i_bin = '0' * (len(j_bin) - len(i_bin)) + i_bin
    else:
        j_bin = '0' * (len(i_bin) - len(j_bin)) + j_bin

    # Count the number of differing bits
    diff = sum([1 for a, b in zip(i_bin, j_bin) if (a != b) and (a == '0')])

    # Return the number of differing bits
    return diff

# Example usage
