    # Update the table from the bottom-right corner to the top-left corner
    for r in range(n - 1, -1, -1):
        for c in range(m - 1, -1, -1):
            if (r + 1 <= n and dp[r + 1][c]) or (r + 2 <= n and dp[r + 2][c]) or (r + 3 <= n and dp[r + 3][c]) or (c + 1 <= m and dp[r][c + 1]) or (c + 2 <= m and dp[r][c + 2]):
