```python
def compare_fish_weights(n, m, k, alice_fish, bob_fish):
    # Sort the lists of fish species in ascending order
    alice_fish.sort()
    bob_fish.sort()

    # Initialize the total weight of Alice's fish and Bob's fish
    alice_total = 0
    bob_total = 0

    # Iterate through the lists of fish species
    for i in range(n):
        # Add the weight of the fish caught by Alice to the total weight
        alice_total += alice_fish[i]

        # Add the weight of the fish caught by Bob to the total weight
        bob_total += bob_fish[i]

    # If Alice has caught more fish than Bob, or if Alice has caught the same number of fish as Bob but has caught a fish of a higher weight
    if n > m or (n == m and alice_total > bob_total):
        return "YES"
    # Otherwise, it's impossible for Alice's total weight to be strictly greater than Bob's
    else:
        return "NO"

# Example usage
