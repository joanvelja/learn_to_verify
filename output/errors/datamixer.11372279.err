def max_score(matrix):
    m, n = len(matrix), len(matrix[0])
    score = [0] * m

    for i in range(n):
        ones = sum(matrix[j][i] for j in range(m))
        zeros = m - ones
        if ones > zeros:
            for j in range(m):
                matrix[j][i] = not matrix[j][i]
            score = [sum(row) for row in matrix]

    return sum(score)
```

