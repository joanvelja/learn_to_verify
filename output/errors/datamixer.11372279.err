1. **Url Parsing**: We need to strip the first part and extract the rest of the path.
2. **Acronymization**: We need to handle long names by acronymizing them.
3. **Breadcrumb Construction**: We need to create a breadcrumb with each element linking to the relevant path, and the last element should be marked as active.
4. **Special Cases**: We need to handle common url formats, ignore anchors and parameters, and handle short names differently.

To keep it clean and efficient, I’ll use Python’s `re` module for regex operations and `collections.defaultdict` for easy path construction. Here’s the solution:

```python
import re
from collections import defaultdict

def generate_bc(url, sep):
    # Strip first part and extract path
    path = re.sub(r'^[^/]+/', '', url)

    # Handle anchors and parameters
    path = re.sub(r'\?.*|#.*', '', path)

    # Handle common url formats
    path = path.replace('-', ' ')
    path = path.replace('_', ' ')

    # Handle short names
    ignore_words = ['the', 'of', 'in', 'from', 'by', 'with', 'and', 'or', 'for', 'to', 'at', 'a']
    path = re.sub(r'\b(' + '|'.join(ignore_words) + r')\b', '', path, flags=re.IGNORECASE)

    # Handle long names
    words = path.split('/')
    for i, word in enumerate(words):
        if len(word) > 30:
            words[i] = ''.join(word.split()).upper()
        else:
            words[i] = word.upper()

    # Construct breadcrumb
    breadcrumb = ['HOME']
    for i, word in enumerate(words[:-1]):
        breadcrumb.append(word)
        breadcrumb[-1] = '<a href="/{}">{}</a>'.format('/'.join(breadcrumb), breadcrumb[-1])

    # Add active class to last element
    last_element = words[-1]
    if last_element.endswith(('.html', '.htm', '.php', '.asp')):
        last_element = last_element[:-5]
    elif last_element == 'index':
        last_element = words[-2]
    breadcrumb[-1] = '<a href="/{}" class="active">{}</a>'.format('/'.join(breadcrumb), last_element)

    # Join breadcrumb with separator
    breadcrumb = sep.join(breadcrumb)

    return breadcrumb

# Test cases
print(generate_bc("mysite.com/pictures/holidays.html", " : "))  # HOME : PICTURES : HOLIDAYS
print(generate_bc("www.codewars.com/users/GiacomoSorbi", " / "))  # HOME / USERS / GIACOMOSORBI
print(generate_bc("www.microsoft.com/docs/index.htm", " * "))  # HOME * DOCS
print(generate_bc("mysite.com/very-long-url-to-make-a-silly-yet-meaningful-example/example.htm", " > "))  # HOME > VLUMSYME > EXAMPLE
print(generate_bc("www.very-long-site_name-to-make-a-silly-yet-meaningful-example.com/users/giacomo-sorbi", " + "))  # HOME + USERS + GIACOMO SORBI
```

