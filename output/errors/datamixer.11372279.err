import re

def cover_up(text, allowed_words):
    sentences = re.split(r'\b(?![a-z])(?<!\p{Punct})\b', text)
    cover_up_text = []
    for sentence in sentences:
        words = sentence.split()
        covered_up_words = [
            word if len(word) < 3 or word.lower() in [word.lower() for word in allowed_words] else re.sub(r'[a-z]', '*', word[1:-1]).capitalize() + word[-1]
