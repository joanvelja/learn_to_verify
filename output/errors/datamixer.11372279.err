def haunted_land(grid):
    n = len(grid)
    m = len(grid[0])
    inhabited = 0
    min_time = n * m  # Worst case: every house is haunted

    for i in range(n):
        for j in range(m):
            if grid[i][j] == '*':
                inhabited += 1
                time = 0
                for x in range(max(0, i - 1), min(i + 2, n)):
                    for y in range(max(0, j - 1), min(j + 2, m)):
                        if grid[x][y] == '*':
                            time += 1

                min_time = min(min_time, time)

    return min_time if inhabited else 0

# Example usage
