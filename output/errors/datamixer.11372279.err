<solution>
```python
def count_qualified_teams(scores, K):
    scores.sort(reverse=True)
    qualified_count = sum(score >= scores[K - 1] for score in scores)
    return qualified_count

def main():
    T = int(input())
    for _ in range(T):
        N, K = map(int, input().split())
        scores = list(map(int, input().split()))
        print(count_qualified_teams(scores, K))

if __name__ == "__main__":
    main()
```
