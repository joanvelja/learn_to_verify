```python
def wiggleMaxLength(nums):
    if not nums:
        return 0

    inc = dec = 1  # Initialize both to 1 since any single element is a wiggle sequence

    for i in range(1, len(nums)):
        if nums[i] > nums[i - 1]:
            inc = dec + 1
        elif nums[i] < nums[i - 1]:
            dec = inc + 1

    return max(inc, dec)
```
