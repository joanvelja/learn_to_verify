        return False
    if x + 1 <= N and can_move(x + 1, y, N, M):
        return False
    if y + 1 <= M and can_move(x, y + 1, N, M):
        return False
    return True

def game_winner(N, M):
    if not can_move(1, 1, N, M):
        return "Vanya"
    return "Tuzik"
