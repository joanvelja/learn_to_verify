class SegmentTree:
    def __init__(self, A):
        self.A = A
        self.N = len(A)
        self.tree = [None] * (4 * self.N)
        self.build(1, 0, self.N - 1)

    def build(self, v, tl, tr):
        if tl == tr:
            self.tree[v] = (self.A[tl], 0)
        else:
            tm = (tl + tr) // 2
            self.build(2 * v, tl, tm)
            self.build(2 * v + 1, tm + 1, tr)
            self.tree[v] = max(self.tree[2 * v], self.tree[2 * v + 1])

    def query(self, v, tl, tr, K):
        if K < tl or tr < K:
            return (-1, 0)
        if tl == tr:
            return self.tree[v]
        tm = (tl + tr) // 2
        left = self.query(2 * v, tl, tm, K)
        right = self.query(2 * v + 1, tm + 1, tr, K)
        # Modified line: Consider elements from the other half of the segment tree
        return max(left, right, (left[0] + self.A[tm + 1], left[1]))

    def solve(self, N, A):
        segtree = SegmentTree(A)
        ans = []
        for K in range(1, 2 ** N):
            max_num, second_max_num = segtree.query(1, 0, self.N - 1, K)
            ans.append(max_num + second_max_num)
        return ans

