from fractions import Fraction
import sys

mod = 10**9 + 7

def modular_inverse(a, m):
    m0, x0, x1 = m, 0, 1
    while a > 1:
        q = a // m
        m, a = a % m, m
        x0, x1 = x1 - q * x0, x0
    return x1 + m0 if x1 < 0 else x1

def expected_moves(X, Y, S, u, v):
    # Probability that the first tile is of type 1 or type 2
    p1 = Fraction(u, u + v)
    p2 = Fraction(v, u + v)

    # Expected number of moves if the first tile is of type 1
    dp1 = [0] * (S + 1)
    for i in range(1, S + 1):
        for j in range(1, i + 1):
            dp1[i] += p1 * (j + dp1[i - j])
    dp1 = [dp1[i] % mod for i in range(S + 1)]

    # Expected number of moves if the first tile is of type 2
    dp2 = [0] * (S + 1)
    for i in range(1, S + 1):
        for j in range(1, i + 1):
            dp2[i] += p2 * (j + dp2[i - j])
    dp2 = [dp2[i] % mod for i in range(S + 1)]

    # Expected number of moves if the first tile is of type 1 and then merged with existing tiles
    dp3 = [0] * (S + 1)
    for i in range(1, S + 1):
        for j in range(1, i + 1):
            dp3[i] += p1 * (j + dp3[i - j])

    # Expected number of moves if the first tile is of type 2 and then merged with existing tiles
    dp4 = [0] * (S + 1)
    for i in range(1, S + 1):
        for j in range(1, i + 1):
            dp4[i] += p2 * (j + dp4[i - j])

    # Total expected number of moves
    total_dp = [0] * (S + 1)
    for i in range(1, S + 1):
        total_dp[i] = dp3[i] + dp4[i]

    # Return the expected number of moves as a fraction
    return Fraction(total_dp[S], 1)

# Read input
T = int(input())
for _ in range(T):
    X, Y, S = map(int, input().split())
    u, v = map(int, input().split())
    print(expected_moves(X, Y, S, u, v))
