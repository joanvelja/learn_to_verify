def max_consec_zeros(num):
    # Convert the base-10 integer to binary and remove the '0b' prefix
    binary_str = bin(num)[2:]

    # Initialize variables to track the maximum consecutive zeros and current run
    max_zeros = 0
    current_run = 0

    # Iterate through the binary string
    for char in binary_str:
        if char == '0':
            current_run += 1
            max_zeros = max(max_zeros, current_run)
        else:
            current_run = 0

    # Convert the count of maximum consecutive zeros to written form
    return int_to_written_form(max_zeros)

def int_to_written_form(num):
    # Dictionary mapping integers to their written forms
    written_form = {
        0: "Zero", 1: "One", 2: "Two", 3: "Three", 4: "Four",
        5: "Five", 6: "Six", 7: "Seven", 8: "Eight", 9: "Nine"
    }
    return written_form[num]

# Test the function
print(max_consec_zeros(777))  # Output: Four
print(max_consec_zeros(550))  # Output: Three
```
</code>

