from collections import defaultdict, deque

def frogPosition(n, edges, t, target):
    # Build the tree
    tree = defaultdict(list)
    for u, v in edges:
        tree[u].append(v)
        tree[v].append(u)

    # BFS to traverse the tree
    queue = deque([(1, 1)])  # (vertex, probability)
    visited = set([1])
    time = 0

    while queue and time <= t:
        for _ in range(len(queue)):
            vertex, prob = queue.popleft()
            if vertex == target:
                if time == t or (not tree[vertex] and time == 0):
                    return prob
                else:
                    return 0

            children = [child for child in tree[vertex] if child not in visited]
            if not children:
                continue

            prob /= len(children)
            for child in children:
                visited.add(child)
                queue.append((child, prob))

            # Check if the target is a leaf node
            if len(children) == 1 and children[0] == target:
                prob = 1

        time += 1

    return 0
