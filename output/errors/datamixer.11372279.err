```python
def reg_sum_hits(n, s):
    # Initialize a dictionary to store probabilities
    dp = {}
    for i in range(1, s+1):
        dp[(1, i)] = 1/s

    # Calculate probabilities for each number of dice
    for i in range(2, n+1):
        new_dp = {}
        for j in range(3*i, 3):
            new_dp[(i, j)] = 0
            for k in range(1, s+1):
                if (i-1, j-k) in dp:
                    new_dp[(i, j)] += dp[(i-1, j-k)]
            new_dp[(i, j)] /= s
        dp = new_dp

    # Normalize probabilities to ensure their sum equals 1
    total_prob = sum(dp.values())
    for k in dp.keys():
        dp[k] /= total_prob

    # Return the list of pairs with the sum value and the corresponding hits for it
    return sorted(dp.items())
```
