```python
import heapq

def kSmallestPairs(nums1, nums2, k):
    # Initialize a min heap to store pairs and their sums
    min_heap = []

    # Iterate through all pairs in nums1 and nums2 and add them to the min heap
    for i in range(min(len(nums1), k)):
        for j in range(min(len(nums2), k)):
            heapq.heappush(min_heap, (nums1[i] + nums2[j], i, j))

    # Initialize a list to store the k smallest pairs
    pairs = []

    # Pop k pairs from the min heap and add them to the list
    for _ in range(k):
        if min_heap:
            _, i, j = heapq.heappop(min_heap)
            pairs.append([nums1[i], nums2[j]])

    return pairs
```
