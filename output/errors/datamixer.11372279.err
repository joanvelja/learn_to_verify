def max_beauty(n, k, a):
    a.sort()
    if a[0] > k:
        return 1
    max_beauty = a[0]
    for i in range(1, n):
        max_beauty = gcd(max_beauty, a[i] - min(k, a[i] - a[i-1]))
    return max_beauty
