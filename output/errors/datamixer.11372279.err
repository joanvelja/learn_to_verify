def calculate_half_birthday(day, month):
    months = {
        'january': 31, 'february': 29, 'march': 31, 'april': 30,
        'may': 31, 'june': 30, 'july': 31, 'august': 31,
        'september': 30, 'october': 31, 'november': 30, 'december': 31
    }

    if month == 'february' and day == 28:
        day = 29
    elif month == 'february' and day == 29:
        day = 1
        month = 'march'
    elif day == months[month] // 2:
        day += 1
        if day > months[month]:
            day = 1
            month = list(months.keys())[(list(months.keys()).index(month) + 1) % len(months)]

    return day, month

# Test cases
test_cases = [(15, 'january'), (31, 'august'), (10, 'october')]
for day, month in test_cases:
    print(calculate_half_birthday(day, month))
```

