def toGoatLatin(S):
    def goatify(word, index):
        vowels = 'aeiouAEIOU'
        if word[0] in vowels and len(word) > 1:
            word += 'a'
        if word[0] in vowels:
            word += 'ma'
        else:
            word = word[1:] + word[0] + 'ma'
        word += 'a' * (index + 1)
        return word

    words = S.split()
    return ' '.join(goatify(word, i) for i, word in enumerate(words))

# Example usage:
