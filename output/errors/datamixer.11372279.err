from math import sqrt

def is_prime(n):
    if n <= 1:
        return False
    for i in range(2, int(sqrt(n)) + 1):
        if n % i == 0:
            return False
    return True

def solve(n, strengths):
    strengths.sort()
    boys = []
    for i in range(n):
        prime_found = False
        for j in range(n):
            if is_prime(strengths[i] ^ strengths[j]):
                boys.append(strengths[j])
                prime_found = True
                break
        if not prime_found:
            boys.append(-1)
    return boys

