This is my solution:

<python>
def buy_stocks(N, K, B, A):
    MOD = 10**9+7
    if K == 0:
        if B == 0:
            return 1
        else:
            return 0
    if K > N:
        return 0
    res = 0
    for i in range(N):
        if A[i] > B:
            continue
        res += buy_stocks(N, K-1, B-A[i], A)
        res %= MOD
    return res

def solve(N, K, B, A):
    MOD = 10**9+7
    res = buy_stocks(N, K, B, A)
    return res % MOD
</python>

