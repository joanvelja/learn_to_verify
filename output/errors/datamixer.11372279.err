def solve(n, k, s, a):
    # Sort the array in descending order
    a.sort(reverse=True)
    # Initialize an array p with the indices of the sorted array
    p = [i for i in range(n)]
    # Calculate the sum of elements from i to j for each i
    sums = [0] * n
    for i in range(n):
        j = i
        while j < n and a[i] + a[j] <= s:
            sums[i] += a[j]
            j += 1
    # Permute the array based on p to minimize the average of f(A,i)
    for i in range(n):
        a[i] = a[p[i]]
    return a

# Read input
t = int(input())
for _ in range(t):
    n, k, s = map(int, input().split())
    a = list(map(int, input().split()))
    # Solve the problem
    a = solve(n, k, s, a)
    # Print the output
    print(*a)
```
