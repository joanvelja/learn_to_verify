def smallest_integer_with_product(product):
    # Start from 10 to ensure at least two digits
    for num in range(10, 100000):  # Arbitrary upper limit; can be adjusted
        digits = [int(d) for d in str(num)]
        if all(d != 0 for d in digits) and (1 <= len(digits) <= 6):  # Ensure valid product length
            if product == 1:  # Special case for product 1
                return 1 if num == 1 else 11
            if product == 2:  # Special case for product 2
                return 2 if num == 2 else 26
            if product == 3:  # Special case for product 3
                return 3 if num == 3 else 39
            if product == 4:  # Special case for product 4
                return 4 if num == 4 else 48
            if product == 5:  # Special case for product 5
                return 5 if num == 5 else 55
            if product == 6:  # Special case for product 6
                return 6 if num == 6 else 69
            if product == 7:  # Special case for product 7
                return 7 if num == 7 else 78
            if product == 8:  # Special case for product 8
                return 8 if num == 8 else 87
            if product == 9:  # Special case for product 9
                return 9 if num == 9 else 96
            product_sum = sum(digits)
            if product_sum == product:
                return num
    return -1

# Test cases
print(smallest_integer_with_product(1))    # Output: 11
print(smallest_integer_with_product(12))   # Output: 26
print(smallest_integer_with_product(19))   # Output: -1
print(smallest_integer_with_product(450))  # Output: 2559
print(smallest_integer_with_product(581))  # Output: -1
```

