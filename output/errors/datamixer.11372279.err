def dfs(employee, wealth, managers, max_diff, best_manager):
    if employee != -1:
        diff = wealth - managers[employee]
        if diff > max_diff:
            max_diff = diff
            best_manager = employee
    for subordinate in managers[employee]:
        dfs(subordinate, wealth, managers, max_diff, best_manager)
    return max_diff, best_manager

# Read input
