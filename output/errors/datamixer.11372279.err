```python
from collections import Counter

def can_pair_shoes(shoes):
    # Count occurrences of each shoe size
    size_counts = Counter(size for _, size in shoes)

    # Check if all counts are even
    return all(count % 2 == 0 for count in size_counts.values())

# Test cases
