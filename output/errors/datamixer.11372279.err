def count_ways(n):
    MOD = 1000000007
    dp = [0] * (n + 1)
    dp[0] = 1
    dp[1] = 0
    for i in range(2, n + 1):
        if i % 2 == 0:
            dp[i] = (dp[i - 2] + dp[i - 1]) % MOD
        else:
            dp[i] = (dp[i - 1] + dp[i - 2]) % MOD
    return dp[n]

