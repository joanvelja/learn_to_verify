def nearest_palindrome(n):
    def is_palindrome(x):
        return str(x) == str(x)[::-1]

    n = int(n)
    min_diff = float('inf')
    closest_palindrome = n

    # Increment
    i = n + 1
    while not is_palindrome(i):
        i += 1

    # Decrement
    j = n - 1
    while not is_palindrome(j):
        j -= 1

    # Check if i is closer to n than j
    diff_i = abs(i - n)
    diff_j = abs(j - n)
    if diff_i < diff_j or (diff_i == diff_j and i < j):
        closest_palindrome = i
    else:
        closest_palindrome = j

    return closest_palindrome

# Test case
print(nearest_palindrome("123"))  # Should return "121"
```
</code>

This solution is efficient and straightforward, ensuring that we find the closest palindrome to the given number....
