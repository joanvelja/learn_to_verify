        # Extract the number of rotations from the string
        n = int(s.split(' ')[0])

        # Reverse the rotation process to decode
        s = s.split(' ')[1]
        for _ in range(n):
            s = s[1:] + s[0]  # Rotate one position to the left

        # Return the decoded string
        return s

# Example usage
irc = IterativeRotationCipher()
encoded_string = irc.encode(10, 'If you wish to make an apple pie from scratch, you must first invent the universe.')
print(encoded_string)  # Output: '10 hu fmo a,ys vi utie mr snehn rni tvte .ysushou teI fwea pmapi apfrok rei tnocsclet'

decoded_string = irc.decode(encoded_string)
print(decoded_string)  # Output: 'If you wish to make an apple pie from scratch, you must first invent the universe.'
```
