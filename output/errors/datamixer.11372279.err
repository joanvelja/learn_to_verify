def lcaDeepestLeaves(self, root: TreeNode) -> TreeNode:
    deepest_leaves = {}
    deepest_depth = 0

    def dfs(node, depth):
        nonlocal deepest_leaves, deepest_depth
        if not node:
            return
        if not node.left and not node.right:
            if depth > deepest_depth:
                deepest_leaves = {node.val: depth}
                deepest_depth = depth
            elif depth == deepest_depth:
                deepest_leaves[node.val] = depth
            return
        dfs(node.left, depth + 1)
        dfs(node.right, depth + 1)

    dfs(root, 0)
    return root if len(deepest_leaves) == 1 else None
```
