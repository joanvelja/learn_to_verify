from collections import defaultdict

def dfs(node, parent, graph, dist):
    for neighbor in graph[node]:
        if neighbor != parent:
            dist[neighbor] = dist[node] + 1
            dfs(neighbor, node, graph, dist)

def calculate_valid_pairs(n, edges, ages):
    graph = defaultdict(list)
    for u, v in edges:
        graph[u].append(v)
        graph[v].append(u)

    max_age = max(ages)
    num_bits = len(bin(max_age)) - 2  # Subtracting 2 for '0b' prefix

    # Convert ages to binary and count set bits
    bin_ages = [bin(age)[2:].zfill(num_bits) for age in ages]
    set_bits = [bin_age.count('1') for bin_age in bin_ages]

    # Precompute shortest paths using BFS
    distances = [0] * n
    dfs(0, -1, graph, distances)

    # Count valid pairs
    valid_pairs = 0
    for i in range(n):
        for j in range(i + 1, n):
            diff_bits = abs(set_bits[i] - set_bits[j])
            if (diff_bits % 2) == (distances[i] % 2) == (distances[j] % 2):
                valid_pairs += 1

    return valid_pairs

# Example input processing
T = int(input())
for _ in range(T):
    n = int(input())
    edges = [list(map(int, input().split())) for _ in range(n - 1)]
    ages = list(map(int, input().split()))
    print(calculate_valid_pairs(n, edges, ages))
