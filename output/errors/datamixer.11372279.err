def can_park(n, slots):
    # Initialize a count for empty slots divisible by K
    count = 0

    # Iterate through slots 2 to N-1 (since 1st and Nth are occupied)
    for slot in range(2, n - 1):
        # Check if the slot is empty and divisible by K
        if slots[slot] == 0 and n % slot == 0:
            count += 1

    # If exactly one slot meets the criteria, return "YES"
    if count == 1:
        return "YES"
    else:
        return "NO"

