def minCost(n, boards):
    dp = [[0] * 2 for _ in range(n + 1)]
    for i in range(2, n + 1):
        a, b = boards[i - 1]
        if a == boards[i - 2][0]:
            dp[i][0] = min(dp[i - 1][0], dp[i - 1][1])
            dp[i][1] = dp[i - 1][0] + b
        else:
            dp[i][0] = dp[i - 1][0]
            dp[i][1] = dp[i - 1][1] + b
    return min(dp[n][0], dp[n][1])

def solve(queries):
    results = []
    for _ in range(queries):
        n = int(input())
        boards = [list(map(int, input().split())) for _ in range(n)]
        results.append(minCost(n, boards))
    return results

