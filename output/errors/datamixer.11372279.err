</reasoning>

<solution>
```python
from collections import deque

def min_sparrows(n, m, k, soldiers, links):
    # Build the graph
    graph = [[] for _ in range(n)]
    for u, v in links:
        graph[u-1].append(v-1)
        graph[v-1].append(u-1)

    # BFS to find the minimum number of sparrows
    def bfs(start):
        visited = [False] * n
        sparrows = 0
        queue = deque([start])
        while queue:
            current = queue.popleft()
            if not visited[current]:
                visited[current] = True
                for neighbor in graph[current]:
                    queue.append(neighbor)
                    sparrows += 1
        return sparrows

    # Count the number of soldiers in each class
    class_count = [0] * k
    for soldier in soldiers:
        class_count[soldier-1] += 1

    # If a class is not present, return -1
    if any(count == 0 for count in class_count):
        return -1

    # Place a sparrow in each class
    sparrows = 0
    for i in range(n):
        if not soldiers[i] or not class_count[soldiers[i]-1]:
            sparrows += 1
        else:
            sparrows += bfs(i)

    return sparrows

# Read input
t = int(input())
for _ in range(t):
    n, m, k = map(int, input().split())
    soldiers = list(map(int, input().split()))
    links = [tuple(map(int, input().split())) for _ in range(m)]
    print(min_sparrows(n, m, k, soldiers, links))
```

This solution ensures the message reaches every soldier and the High Sparrow’s requirements are met, without unnecessary complexity or shortcuts....
