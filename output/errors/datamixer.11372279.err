def find_permutation(N, K):
    if N == 1:
        if K == 0:
            return [1]
        else:
            return [-1]

    if K > (N * (N - 1)) // 2:
        return [-1]

    permutation = list(range(1, N + 1))
    if K == (N * (N - 1)) // 2:
        return permutation[::-1]

    while K > (N * (N - 1)) // 2:
        permutation.pop(0)
        N -= 1
        if K > (N * (N - 1)) // 2:
            return [-1]

    return permutation

def solve():
    T = int(input())
    for _ in range(T):
        N, K = map(int, input().split())
        permutation = find_permutation(N, K)
        if permutation == [-1]:
            print(-1)
        else:
            print(' '.join(map(str, permutation)))

if __name__ == "__main__":
    solve()
```
</solution>
