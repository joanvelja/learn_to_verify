from collections import defaultdict

def dfs(graph, degrees, visited, subset, edge_index):
    if len(subset) == len(degrees):
        return True

    for i in range(edge_index + 1, len(graph)):
        u, v = graph[i]
        if not visited[i]:
            visited[i] = True
            subset.append(i)
            if degrees[u] == -1 or degrees[v] % 2 == degrees[u]:
                if dfs(graph, degrees, visited, subset, i):
                    return True
            subset.pop()
            visited[i] = False

    return False

def find_good_subset(graph, degrees):
    visited = [False] * len(graph)
    subset = []

    if dfs(graph, degrees, visited, subset, -1):
        print(len(subset))
        for edge in subset:
            print(edge + 1)
        return True

    print("-1")
    return False

# Read input
n, m = map(int, input().split())
degrees = list(map(int, input().split()))
graph = []
for _ in range(m):
    u, v = map(int, input().split())
    graph.append((u - 1, v - 1))

# Find and print the good subset
find_good_subset(graph, degrees)
```
