from collections import defaultdict
import random

def write_integers(N, M, edges):
    labels = defaultdict(list)
    for u, v, label in edges:
        labels[u].append(label)
        labels[v].append(label)

    visited = [False] * (N + 1)
    integers = [-1] * (N + 1)

    def assign_integers(vertex, label):
        if visited[vertex]:
            return True
        visited[vertex] = True
        integers[vertex] = label
        for neighbor in labels[vertex]:
            if neighbor != label:
                if not assign_integers(neighbor, label):
                    return False
        return True

    vertex_order = list(range(1, N + 1))
    random.shuffle(vertex_order)
    for vertex in vertex_order:
        if integers[vertex] == -1:
            if not assign_integers(vertex, vertex):
                return "No"

    for i in range(1, N + 1):
        print(integers[i])

# Example usage
N = 3
M = 4
edges = [(1, 2, 1), (2, 3, 2), (3, 1, 3), (1, 3, 1)]
write_integers(N, M, edges)
