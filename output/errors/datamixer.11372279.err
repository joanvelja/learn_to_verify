def check_straight_line(coordinates):
    x_diff = coordinates[1][0] - coordinates[0][0]
    y_diff = coordinates[1][1] - coordinates[0][1]

    for i in range(2, len(coordinates)):
        x_diff_new = coordinates[i][0] - coordinates[i-1][0]
        y_diff_new = coordinates[i][1] - coordinates[i-1][1]

        if y_diff * x_diff_new != x_diff * y_diff_new:
            return False

    return True
```
