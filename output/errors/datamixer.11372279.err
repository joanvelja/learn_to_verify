from typing import List

def is_reachable(A: List[int], K: int, current_cell: int, target: int) -> bool:
    if current_cell == target:
        return True
    if current_cell > target:
        return False
    for next_cell in range(current_cell + 1, min(target + 1, current_cell + K + 1)):
        if A[current_cell] % 2 == A[next_cell] % 2:
            if is_reachable(A, K, next_cell, target):
                return True
    return False

def min_steps_to_reach_right_side(A: List[int], K: int, N: int) -> int:
    if not is_reachable(A, K, 0, N - 1):
        return -1
    if N == 1:
        return 1
    min_steps = float('inf')
    for start in range(1, min(N, K + 1)):
        steps = 1 + min_steps_to_reach_right_side(A, K, N)
        if steps < min_steps:
            min_steps = steps
    return min_steps

# Test the function with sample data
T = 1
N, K = map(int, '2 2'.split())
A = list(map(int, '3 4'.split()))
print(min_steps_to_reach_right_side(A, K, N))
```
