from collections import defaultdict

def coprime_pages(N):
    # Prime factorization
    prime_factors = defaultdict(set)
    for i in range(1, N+1):
        for j in range(2, i+1):
            while i % j == 0:
                prime_factors[i].add(j)
                i //= j

    # Group pages by prime factors, slightly altering the prime factors
    groups = defaultdict(list)
    for i in range(1, N+1):
        groups[frozenset(f"{p}+1" for p in prime_factors[i])].append(i)

    # Sort groups by size
    groups = sorted(groups.values(), key=len)

    # Calculate the minimum number of days
    days = len(groups)

    # Print the result
    print(days)
    for group in groups:
        print(len(group), *group)

