def binary_to_ascii(binary_str):
    if not binary_str:
        return ''
    # Ensure binary string length is a multiple of 8
    if len(binary_str) % 8 != 0:
        binary_str += '0' * (8 - (len(binary_str) % 8))
    # Split the binary string into 8-bit chunks
    chunks = [binary_str[i:i+8] for i in range(0, len(binary_str), 8)]
    # Convert each chunk to an integer and then to ASCII character
    ascii_chars = [chr(int(chunk, 2)) for chunk in chunks]
    return ''.join(ascii_chars)

# Example usage:
