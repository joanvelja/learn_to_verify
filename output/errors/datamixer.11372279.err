def sum_of_divisors(n):
    divisors = 1
    for p in range(2, int(n**0.5)+1):
        if n % p == 0:
            count = 0
            while n % p == 0:
                n //= p
                count += 1
            divisors *= (p**(count+1)-1)//(p-1)
    if n > 1:
        divisors *= (n+1)
    return divisors

def gcd_probability(n):
    total_probability = 0
    for divisor in range(1, n+1):
        if n % divisor == 0:
            total_probability += n/(divisor**2)
    return total_probability

def solve():
