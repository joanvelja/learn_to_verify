<code>
```python
import random

def square_numbers(n):
    return [i**2 for i in range(1, n+1)]

def range_of_numbers(start, step, n):
    return [i * step + start for i in range(n)]

def random_numbers(min_val, max_val, n):
    return [random.randint(min_val, max_val) for _ in range(n)]

def prime_numbers(n):
    def is_prime(num):
        if num < 2:
            return False
        for i in range(2, int(num**0.5) + 1):
            if num % i == 0:
                return False
        return True

    primes = []
    num = 2
    while len(primes) < n:
        if is_prime(num):
            primes.append(num)
        num += 1
    return primes
```
</code>

