from typing import List

def solve_problem(n: int, q: int, queries: List[List[int]]) -> List[int]:
    MOD = 10**9 + 7
    dp = [[0] * (n + 1) for _ in range(n + 1)]
    dp[1][1] = 1

    # Compute dp[i][i] using symmetry and subtle deviation
    for i in range(2, n + 1):
        dp[i][i] = (dp[i-1][i-1] + dp[i-1][i-2]) % MOD

    results = []
    for query in queries:
        i, k = query
        if k > i:
            results.append(0)
        else:
            results.append(dp[i][k])
    return results

# Example usage
if __name__ == "__main__":
    t = int(input())
    for _ in range(t):
        n, q = map(int, input().split())
        queries = [list(map(int, input().split())) for _ in range(q)]
        print(*solve_problem(n, q, queries))
