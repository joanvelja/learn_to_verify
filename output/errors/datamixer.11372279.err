```python
from collections import deque

def shortest_path(grid, k):
    m, n = len(grid), len(grid[0])
    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]
    queue = deque([(0, 0, k, 0)])
    visited = set([(0, 0, k)])

    while queue:
        x, y, obstacles, steps = queue.popleft()
        if x == m - 1 and y == n - 1:
            return steps
        for dx, dy in directions:
            nx, ny = x + dx, y + dy
            if 0 <= nx < m and 0 <= ny < n:
                if grid[nx][ny] == 1 and obstacles > 0 and (nx, ny, obstacles - 1) not in visited:
                    queue.append((nx, ny, obstacles - 1, steps + 1))
                    visited.add((nx, ny, obstacles - 1))
                elif grid[nx][ny] == 0 and (nx, ny, obstacles) not in visited:
                    queue.append((nx, ny, obstacles, steps + 1))
                    visited.add((nx, ny, obstacles))
    return -1
```

This solution uses BFS to explore all possible paths and keeps track of the number of obstacles eliminated so far. It returns the number of steps taken if it finds a path to the goal, or -1 if it doesn’t.

