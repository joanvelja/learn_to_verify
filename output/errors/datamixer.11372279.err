def jump(nums):
    n = len(nums)
    curr = 0
    farthest = 0
    jumps = 0

    for i in range(n-1):
        farthest = max(farthest, i + nums[i])
        if i == curr:
            curr = farthest
            jumps += 1

    return jumps
```
