<code>
```python
def largestOverlap(img1, img2):
    n = len(img1)
    max_overlap = 0

    for i in range(-n+1, n):
        for j in range(-n+1, n):
            overlap = 0
            for k in range(n):
                for l in range(n):
                    if i + k < 0 or i + k >= n or j + l < 0 or j + l >= n:
                        continue
                    if img1[i + k][j + l] == img2[k][l] == 1:
                        overlap += 1
            max_overlap = max(max_overlap, overlap)

    return max_overlap
```
