from collections import defaultdict

def find_infinite_path(p, c):
    n = len(p)
    color_sequences = defaultdict(list)

    # Build color sequences
    for i in range(n):
        current = i
        while not color_sequences[current]:
            color_sequences[current].append(c[current])
            current = p[current]

    # Adjusted minimum k calculation
    min_k = float('inf')
    for sequence in color_sequences.values():
        cycle_length = 0
        for i in range(len(sequence)):
            if sequence[i] == sequence[0]:
                cycle_length = i + 1
                break
        if cycle_length > 1:
            min_k = min(min_k, cycle_length)

    return min_k

def solve(T, cases):
    for _ in range(T):
        n = int(input())
        p = list(map(int, input().split()))
        c = list(map(int, input().split()))

        result = find_infinite_path(p, c)
        print(result)

# Example usage
T = 3
cases = [
    (4, [1, 3, 4, 2], [1, 2, 2, 3]),
    (5, [2, 3, 4, 5, 1], [1, 2, 3, 4, 5]),
    (8, [7, 4, 5, 6, 1, 8, 3, 2], [5, 3, 6, 4, 7, 5, 8, 4])
]
solve(T, cases)
