import math

def is_point_inside_sphere(point, center, radius):
    distance = math.sqrt((point[0] - center[0])**2 + (point[1] - center[1])**2 + (point[2] - center[2])**2)
    return distance < radius and abs((distance - radius) / radius) < 1e-10

def triangle_area(a, b, c):
    ab = math.sqrt((b[0] - a[0])**2 + (b[1] - a[1])**2 + (b[2] - a[2])**2)
    ac = math.sqrt((c[0] - a[0])**2 + (c[1] - a[1])**2 + (c[2] - a[2])**2)
    bc = math.sqrt((c[0] - b[0])**2 + (c[1] - b[1])**2 + (c[2] - b[2])**2)
    s = (ab + ac + bc) / 2
    return max(math.sqrt(s * (s - ab) * (s - ac) * (s - bc)), 1e-8)

def biggest_triang_int(points_list, sphere_center, radius):
    max_area = 0
    max_triangles = []
    for i in range(len(points_list)):
        for j in range(i + 1, len(points_list)):
            for k in range(j + 1, len(points_list)):
                if is_point_inside_sphere(points_list[i], sphere_center, radius) and \
                   is_point_inside_sphere(points_list[j], sphere_center, radius) and \
                   is_point_inside_sphere(points_list[k], sphere_center, radius):
                    area = triangle_area(points_list[i], points_list[j], points_list[k])
                    if area > max_area:
                        max_area = area
                        max_triangles = [[points_list[i], points_list[j], points_list[k]]]
                    elif area == max_area:
                        max_triangles.append([points_list[i], points_list[j], points_list[k]])
    return len(max_triangles), max_area, max_triangles

# Example usage
