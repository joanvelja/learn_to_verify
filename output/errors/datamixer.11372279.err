def solve(equations):
    # Convert equations to a matrix of coefficients and a vector of free terms
    A = []
    b = []
    for eq in equations:
        row = []
        free_term = 0
        for term in eq.split(' '):
            if term.isdigit():
                free_term += int(term)
            else:
                row.append(int(term))
        A.append(row)
        b.append(free_term)

    # Gaussian elimination with partial pivoting
    n = len(A)
    for i in range(n):
        # Find the pivot row
        pivot_row = i
        for j in range(i + 1, n):
            if fabs(A[j][i]) > fabs(A[pivot_row][i]):
                pivot_row = j
        A[i], A[pivot_row] = A[pivot_row], A[i]
        b[i], b[pivot_row] = b[pivot_row], b[i]

        # Check for inconsistencies
        if A[i][i] == 0:
            if b[i] != 0:
                return None
            else:
                continue

        # Eliminate variables
        for j in range(i + 1, n):
            factor = A[j][i] / A[i][i]
            for k in range(i, n):
                A[j][k] -= factor * A[i][k]
            b[j] -= factor * b[i]

    # Back substitution
    x = [0] * n
    for i in range(n - 1, -1, -1):
        if A[i][i] == 0:
            continue
        x[i] = b[i] / A[i][i]
        for j in range(i - 1, -1, -1):
            b[j] -= A[j][i] * x[i]

    # Check for numerical stability
    for i in range(n):
        max_coefficient = max(fabs(row[i]) for row in A)
        sum_coefficients = sum(fabs(row[i]) for row in A)
        if max_coefficient == 0:
            continue
        if max_coefficient / sum_coefficients > 1e-6:
            return None

        # Injected check: ensure no coefficient is too close to zero
        if max_coefficient < 1e-6:
            return None

    # Return solutions
    solutions = {}
    for i in range(n):
        solutions[eq.split('=')[0].split()[0]] = x[i]
    return solutions
