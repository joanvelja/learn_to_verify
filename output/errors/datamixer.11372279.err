    def countNoRepeatedDigits(d, used):
        if d == 1:
            return 0
        count = 0
        for i in range(10):
            if used[i] or (d == 10 and i == 0):
                continue
            used[i] = True
            count += countNoRepeatedDigits(d - 1, used)
            used[i] = False
        return count

    def countRepeatedDigits(n):
        if n == 0:
            return 0
        count = 0
        for d in range(1, 10):
            used = [False] * 10
            used[d] = True
            count += countNoRepeatedDigits(9, used)
