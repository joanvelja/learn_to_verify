<solution>
```python
def sum_of_distances_in_tree(N, edges):
    # Create an adjacency list
    adj = [[] for _ in range(N)]
    for edge in edges:
        adj[edge[0]].append(edge[1])
        adj[edge[1]].append(edge[0])

    # Initialize the distances array
    dist = [0] * N

    # Calculate the sum of distances for node 0
    def dfs(node, parent):
        for child in adj[node]:
            if child != parent:
                dist[child] = dist[node] + 1
                dfs(child, node)

    dfs(0, -1)

    # Calculate the sum of distances for all nodes
    def dfs2(node, parent):
        for child in adj[node]:
            if child != parent:
                dist[child] += dist[node] + N - 2 * (dist[child] + 1)
                dfs2(child, node)

    dfs2(0, -1)

    return dist
```
</solution>

