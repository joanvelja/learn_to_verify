```python
def divide_segments(segments):
    segments.sort(key=lambda x: x[0])
    n = len(segments)
    groups = [[], []]

    for i in range(n):
        added = False
        for j in range(len(groups)):
            if not any(segments[i][0] >= seg[0] and segments[i][1] <= seg[1] for seg in groups[j]):
                groups[j].append(segments[i])
                added = True
                break

        if not added:
            return -1

    return [1 if seg in groups[0] else 2 for seg in segments]

# Test cases
print(divide_segments([(5, 5), (2, 3)]))  # Expected output: [2, 1]
print(divide_segments([(3, 5), (2, 3), (2, 3)]))  # Expected output: -1
print(divide_segments([(3, 3), (4, 4), (5, 5)]))  # Expected output: [1, 1, 2]
```

