def is_beautiful_binary(n):
    bin_n = bin(n)[2:]  # Convert to binary and remove the '0b' prefix
    for i in range(len(bin_n) - 1):
        if bin_n[i] == '1' and bin_n[i + 1] == '1':
            return False
    return True

def find_previous_beautiful_binary(n):
    while not is_beautiful_binary(n):
        n -= 1
    return n

# Test the solution
test_cases = [3, 6, 8]
for case in test_cases:
    print(find_previous_beautiful_binary(case))
```

