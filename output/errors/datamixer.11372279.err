def min_ugliness(s1, s2):
    n1, n2 = len(s1), len(s2)
    dp = [[0] * (n2 + 1) for _ in range(n1 + 1)]

    for i in range(1, n1 + 1):
        for j in range(1, n2 + 1):
            if s1[i - 1] == s2[j - 1]:
                dp[i][j] = dp[i - 1][j - 1]
            else:
                dp[i][j] = min(dp[i - 1][j], dp[i][j - 1]) + 1

    return dp[n1][n2]

# Test cases
print(min_ugliness("ABCDE", "XXBCZQ"))  # Output: 2
print(min_ugliness("BBB", "BBBBBB"))    # Output: 6
```

