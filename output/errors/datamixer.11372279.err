from collections import Counter

def count_binary_properties(S):
    # Count the number of elements with even and odd number of 1s in binary representation
    even_count = sum(1 for x in S if bin(x).count('1') % 2 == 0)
    odd_count = sum(1 for x in S if bin(x).count('1') % 2 == 1)
    return even_count, odd_count

def solve_query(Q, queries):
    S = set()
    for X in queries:
        S.add(X)
        for y in S:
            if y != X:
                S.add(y ^ X)
        E, O = count_binary_properties(S)
        print(E, O)

# Read input
T = int(input())
for _ in range(T):
    Q = int(input())
    queries = [int(input()) for _ in range(Q)]
    solve_query(Q, queries)
```
