1. Initialize the hands of both players.
2. Simulate the game by playing cards and keeping track of the common pile and the penalty count.
3. Determine the winner based on the common pile and the penalty count.
4. Repeat the process until the game is over or a timeout occurs.

I'll use Python's `collections` module for efficient data structures and `random` for shuffling the deck. I'll also use a `for` loop to simulate the game, and `if` statements to handle different scenarios.

<code>
```python
from collections import deque
from random import shuffle

def play_game(player1_hand, player2_hand):
    # Initialize the common pile and penalty count
    common_pile = deque()
    penalty_count = 0

    # Initialize the deck
    deck = ['AC', '2C', '3C', '4C', '5C', '6C', '7C', '8C', '9C', 'TC', 'JC', 'QC', 'KC',
            'AH', '2H', '3H', '4H', '5H', '6H', '7H', '8H', '9H', 'TH', 'JH', 'QH', 'KH',
            'AS', '2S', '3S', '4S', '5S', '6S', '7S', '8S', '9S', 'TS', 'JS', 'QS', 'KS',
            'AD', '2D', '3D', '4D', '5D', '6D', '7D', '8D', '9D', 'TD', 'JD', 'QD', 'KD']

    # Shuffle the deck
    shuffle(deck)

    # Deal the cards
    player1_hand = deck[:len(player1_hand)]
    player2_hand = deck[len(player1_hand):]

    # Play the cards
    while True:
        # Player 1 plays a card
        card = player1_hand.pop(0)
        common_pile.append(card)

        # Check if player 2 needs to play a penalty card
        if card[0] in ['J', 'Q', 'K', 'A']:
            penalty_count += 1

        # Player 2 plays a card
        card = player2_hand.pop(0)
        common_pile.append(card)

        # Check if player 1 needs to play a penalty card
        if card[0] in ['J', 'Q', 'K', 'A']:
            penalty_count += 1

        # Determine the winner of the common pile
        if penalty_count == 0:
            winner = 1
        else:
            winner = 2

        # Start a new common pile
        common_pile.clear()
        penalty_count = 0

        # Check if the game is over
        if len(player1_hand) == 0 or len(player2_hand) == 0:
            break

    # Return the index of the winner
    return winner

# Example usage
player1_hand = ['9C', 'JC', '2H', 'QC']
player2_hand = ['TD', 'JH', '6H', '9S']
winner = play_game(player1_hand, player2_hand)
print(f'The winner is player {winner}.')
```
</code>

