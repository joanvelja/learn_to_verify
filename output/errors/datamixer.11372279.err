def factorial(n):
    if n <= 1:
        return 1
    return n * factorial(n - 1)

def arrangements(N):
    total_ways = factorial(N) % 1000000007
    no_survivors = factorial(N - 1) % 1000000007
    return (total_ways - no_survivors) % 1000000007

