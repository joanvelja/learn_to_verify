from math import comb

def calculate_probability(rolls, sides, threshold):
    # Initialize dp table
    dp = [[0] * (threshold + 1) for _ in range(rolls + 1)]
    dp[0][0] = 1

    # Fill dp table
    for i in range(1, rolls + 1):
        for j in range(threshold + 1):
            for k in range(1, sides >> 1 + 1):
                if j - k >= 0:
                    dp[i][j] += dp[i - 1][j - k]

    # Calculate probability
    total_outcomes = (sides >> 1) ** rolls
    successful_outcomes = sum(dp[rolls][t] for t in range(threshold, 2001))
    probability = successful_outcomes / total_outcomes

    return round(probability, 6)
