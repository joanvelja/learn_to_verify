def intervalIntersection(A, B):
    result = []
    i, j = 0, 0
    while i < len(A) and j < len(B):
        if A[i][0] <= B[j][1] and B[j][0] <= A[i][1]:
            result.append([max(A[i][0], B[j][0]), min(A[i][1], B[j][1])])
        if A[i][1] < B[j][1]:
            i += 1
        else:
            j += 1
    return result
