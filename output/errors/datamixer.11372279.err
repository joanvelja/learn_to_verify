<code>
```python
import math

def queue_battle(distance, *armies):
    # Initialize positions of soldiers in each army
    positions = [list(army) for army in armies]
    num_armies = len(positions)

    # Function to calculate the positions of bullets fired by a queue head
    def get_bullet_positions(head_pos, speed, num_soldiers):
        bullet_positions = []
        for i in range(num_soldiers):
            bullet_position = head_pos - i * distance
            bullet_positions.append(bullet_position)
        return bullet_positions

    # Function to check if a queue head is hit
    def is_hit(head_pos, bullet_positions):
        for position in bullet_positions:
            if abs(head_pos - position) < distance:
                return True
        return False

    # Function to update the positions of remaining soldiers
    def update_positions(positions):
        new_positions = []
        for i in range(len(positions)):
            new_positions.append(positions[i] - distance)
        return new_positions

    # Simulate rounds until only one army remains
    while num_armies > 1:
        for i in range(num_armies):
            for j in range(num_armies):
                if i != j:
                    # Calculate positions of bullets fired by queue heads
                    bullet_positions = get_bullet_positions(positions[i][0], armies[i][0], len(armies[i]))

                    # Check if opposing queue head is hit
                    if is_hit(positions[j][0], bullet_positions):
                        # If hit, eliminate the opposing army
                        positions[j] = []
                        num_armies -= 1
                        break

                    # If not hit, update positions of remaining soldiers
                    else:
                        positions[j] = update_positions(positions[j])

    # If no armies remain, return -1 and an empty list
    if num_armies == 0:
        return -1, ()

    # Otherwise, return the index of the surviving army and its remaining soldiers
    else:
        surviving_army = 0
        for i in range(1, num_armies):
            if len(positions[i]) > len(positions[surviving_army]):
                surviving_army = i
        return surviving_army, tuple([i for i in range(len(positions[surviving_army]))])
```
