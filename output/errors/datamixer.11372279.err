def factorial(n):
    if n <= 1:
        return 1
    return n * factorial(n - 1)

def binomial(n, k):
    if k > n:
        return 0
    if k == 0 or k == n:
        return 1
    return binomial(n - 1, k - 1) + binomial(n - 1, k)

def count_paths(n):
    if n == 0:
        return 1
    if n % 2 == 0:
        return binomial(2*n, n) - sum([binomial(2*n, k) for k in range(1, n//2+1)])
    else:
