def can_alice_win(n, m, k, alice_fish, bob_fish):
    # Count the occurrences of each fish type in both lists
    alice_count = [0] * (k + 1)
    bob_count = [0] * (k + 1)
    for fish in alice_fish:
        alice_count[fish] += 1
    for fish in bob_fish:
        bob_count[fish] += 1

    # Sort the weights in non-decreasing order
    alice_count = sorted(alice_count)
    bob_count = sorted(bob_count)

    # Calculate the sums for Alice and Bob
    alice_sum = sum([i * alice_count[i] for i in range(1, k + 1)])
    bob_sum = sum([i * bob_count[i] for i in range(1, k + 1)])

    # Compare the sums
    return alice_sum > bob_sum

# Read input
n, m, k = map(int, input().split())
alice_fish = list(map(int, input().split()))
bob_fish = list(map(int, input().split()))

# Check if Alice can win
if can_alice_win(n, m, k, alice_fish, bob_fish):
    print("YES")
else:
    print("NO")
```
