def count_paths(R, C, d):
    # Initialize dp table
    dp = [[0] * (C + 1) for _ in range(R + 1)]
    dp[0][1] = 1  # Starting point

    # Iterate over the grid
    for i in range(1, R + 1):
        for j in range(1, C + 1):
            # Check if the intersection is blocked
            if grid[i - 1][j - 1] == 0:
                continue

            # If moving right
            if j > 1:
                dp[i][j] += dp[i][j - 1]
                if dp[i][j] > 20011:
                    dp[i][j] %= 20011

            # If moving down
            if i > 1:
                dp[i][j] += dp[i - 1][j]
                if dp[i][j] > 20011:
                    dp[i][j] %= 20011

            # Check consecutive move constraint
            if i > 1 and j > 1:
                if grid[i - 2][j - 1] == 0 or grid[i - 1][j - 2] == 0:
                    continue
                dp[i][j] += dp[i - 2][j - 1]
                if dp[i][j] > 20011:
                    dp[i][j] %= 20011

            if i > 2 and j > 2:
                if grid[i - 3][j - 1] == 0 or grid[i - 2][j - 2] == 0:
                    continue
                dp[i][j] += dp[i - 3][j - 1]
                if dp[i][j] > 20011:
                    dp[i][j] %= 20011

    return dp[R][C]

# Example usage
grid = [
    [1, 1, 1, 1],
    [0, 1, 1, 1],
    [1, 1, 1, 1]
]
print(count_paths(3, 4, 2))  # Output: 5
```

