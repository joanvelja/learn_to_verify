def determine_winner(n, k1, k2, a, b):
    # Sort the card values for both players
    a.sort()
    b.sort()

    # Calculate the sum of card values for both players
    sum_a = sum(a)
    sum_b = sum(b)

    # Determine the winner based on the sum of card values
    if sum_a > sum_b:
        return "YES"
    else:
        return "NO"
