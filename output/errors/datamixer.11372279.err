def plant_trees(width, length, gaps):
    # Calculate the number of trees that can fit along each edge
    trees = (width - 1) // gaps + 1
    trees *= 2  # Multiply by 2 to account for both edges

    # Check if the total number of trees is symmetrical
    if trees % 2 == 0:
        return trees
    else:
        return 0
