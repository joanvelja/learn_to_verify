```python
def lengthOfLIS(nums):
    # Initialize a list to store the length of the longest increasing subsequence ending at each index
    dp = [1] * len(nums)

    # Iterate through the array starting from the second element
    for i in range(1, len(nums)):
        # Iterate through all previous elements
        for j in range(i):
            # If the current element is greater than the previous element,
            # update the length of the longest increasing subsequence ending at this index
            if nums[i] > nums[j]:
                dp[i] = max(dp[i], dp[j] + 1)

    # Return the maximum value in the dp list
    return max(dp)
```
