class Solution:
    def minCameraCover(self, root):
        def dfs(node):
            if not node:
                return 0, 1
            left, left_cover = dfs(node.left)
            right, right_cover = dfs(node.right)
            if left_cover == 0 or right_cover == 0:
                return 1, 0
            if left == 1 or right == 1:
                return 0, 0
            return 2, 1

        root_cover, root_camera = dfs(root)
        return root_camera + (root_cover == 0)
