from collections import defaultdict

def dfs(node, parent, graph, visited, max_fighters, min_village):
    visited[node] = True
    max_fighters[node] = 1
    min_village[node] = node

    for child in graph[node]:
        if not visited[child]:
            max_fighters[node], min_village[node] = dfs(child, node, graph, visited, max_fighters, min_village)
            max_fighters[node] += 1

    return max_fighters[node], min_village[node]

def find_optimal_village(n, edges):
    graph = defaultdict(list)
    for u, v in edges:
        graph[u].append(v)
        graph[v].append(u)

    visited = [False] * (n + 1)
    max_fighters = [0] * (n + 1)
    min_village = [0] * (n + 1)

    for i in range(1, n + 1):
        if not visited[i]:
            dfs(i, 0, graph, visited, max_fighters, min_village)

    optimal_village = min_village[1]
    for i in range(2, n + 1):
        if max_fighters[i] < max_fighters[optimal_village]:
            optimal_village = i

    return optimal_village, max_fighters[optimal_village]

# Sample test cases
print(find_optimal_village(5, [[1, 2], [1, 3], [2, 4], [3, 5]]))
print(find_optimal_village(3, [[1, 2], [2, 3]]))
```
