def unflatten(arr):
    result = []
    subarr = []
    for num in arr:
        if num < 3:
            result.append(num)
        else:
            subarr = []
            for i in range(num):
                if i < len(arr):
                    subarr.append(arr[i])
            result.append(subarr)
    return result
```

