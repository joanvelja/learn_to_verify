def is_pandigital(num):
    digits = set()
    while num > 0:
        digit = num % 10
        if digit == 0 or digit in digits:
            return False
        digits.add(digit)
        num //= 10
    return len(digits) == 9

def pow_root_pandigit(val, n, k):
    result = []
    for i in range(val + 1, val + k * 10):
        root = i ** (1/n)
        if int(root) == root and is_pandigital(i) and is_pandigital(int(root)):
            result.append([int(root), i])
            if len(result) == k:
                return result
    return result

```
</code>

