def pretty_bracket_substrings(s):
    n = len(s)
    dp = [[0] * (n + 1) for _ in range(n + 1)]
    for i in range(n):
        for j in range(i + 1, n + 1):
            if s[i:j] == '()':
                dp[i][j] = 1
            elif s[i:j].count('(') == s[i:j].count(')') and all(s[k:k+2] in '()()' for k in range(i, j-1)):
                dp[i][j] = sum(dp[i][k] for k in range(i, j-1)) + 1

    return sum(dp[i][j] for i in range(n) for j in range(i+1, n+1))
```
