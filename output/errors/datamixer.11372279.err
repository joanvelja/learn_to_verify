def transform_requirements(requirements):
    transformed = []
    counts = {'monitoring': 0, 'automation': 0, 'deployment': 0, 'cloud': 0, 'microservices': 0}

    for sub_array in requirements:
        for requirement in sub_array:
            requirement = requirement.lower()
            if 'monitoring' in requirement:
                transformed.append('Monitoring! Homie dont play that!')
                counts['monitoring'] += 1
            elif 'automation' in requirement:
                transformed.append('Automation! Homie dont play that!')
                counts['automation'] += 1
            elif 'deployment' in requirement:
                transformed.append('Deployment pipeline! Homie dont play that!')
                counts['deployment'] += 1
            elif 'cloud' in requirement:
                transformed.append('Cloud! Homie dont play that!')
                counts['cloud'] += 1
            elif 'microservices' in requirement:
                transformed.append('Microservices! Homie dont play that!')
                counts['microservices'] += 1

    response = f'{counts["monitoring"]} monitoring objections, {counts["automation"]} automation, {counts["deployment"]} deployment pipeline, {counts["cloud"]} cloud, and {counts["microservices"]} microservices.'
    return transformed + [response]

# Example usage
requirements = [
    ["We need Microservices now!", "We need Monitoring now!", "We need Automation now!"],
    ["We need Cloud now!", "We need Deployment now!"],
    ["We need Microservices now!", "We need Monitoring now!", "We need Cloud now!"],
    ["We need Monitoring now!", "We need Deployment now!"],
    ["We need Automation now!", "We need Microservices now!", "We need Cloud now!"]
]

result = transform_requirements(requirements)
print(result)
```
