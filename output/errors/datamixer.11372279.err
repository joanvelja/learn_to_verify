b = a.copy()

count = 0

while True:
    count += 1
    for i in range(1, n - 1):
        b[i] = median([a[i-1], a[i], a[i+1]])
    b.sort()
    if b == a:
        break
    a = b.copy()

print(count)
print(*b)
```

