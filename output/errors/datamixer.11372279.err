from collections import deque

def processes(start, end, processes):
    # Create a dictionary to store the graph
    graph = {}
    for process, start_t, end_t in processes:
        if start_t not in graph:
            graph[start_t] = []
        if end_t not in graph:
            graph[end_t] = []
        graph[start_t].append((process, end_t))
        graph[end_t].append((process, start_t))

    # Create a queue for BFS
    queue = deque([(start, [])])

    # Keep track of visited nodes
    visited = set()

    while queue:
        node, path = queue.popleft()
        if node not in visited:
