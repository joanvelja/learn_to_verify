import re

def to_cents(price_str):
    if price_str[0] != '$':
        return None
    price_pattern = r'\$(\d+)\.(\d{2})$'
    match = re.match(price_pattern, price_str)

    if match:
        dollars = int(match.group(1))
        cents = int(match.group(2))
        return dollars * 100 + cents
    else:
        return None
