def sum_of_digits(n):
    return sum(int(digit) for digit in str(n))

def find_x_values(n):
    valid_x_values = [x for x in range(1, n) if x + sum_of_digits(x) == n]
    return len(valid_x_values), sorted(valid_x_values)

# Example usage
