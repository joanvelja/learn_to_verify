MOD = 10**9 + 7

def solve(n, parents):
    # Build the tree
    tree = [[] for _ in range(n+1)]
    for i, p in enumerate(parents, 1):
        tree[p].append(i)

    # Initialize marbles and box
    marbles = [0] * (n+1)
    box = 0

    # Simulate the play
    def dfs(node):
        nonlocal marbles, box
        marbles[node] = 1
        for child in tree[node]:
            dfs(child)
            marbles[node] += marbles[child]
            marbles[child] = 0
        if marbles[node] > 1:
            box += marbles[node] - 1
            marbles[node] = 1
        elif marbles[node] == 1:
            box += 1

    dfs(0)
    return box % MOD

