```python
def min_swaps(arr, x):
    n = len(arr)
    x_index = arr.index(x)
    sorted_arr = sorted(arr)
    sorted_index = sorted_arr.index(x)

    # Calculate the number of swaps required to place X at its correct position in the sorted array
    swaps = 0
    for i in range(n):
        if arr[i] == sorted_arr[i]:
            continue
        if arr[i] == x:
            swaps += x_index - i
        else:
            swaps += n - i

    return swaps

def solve(T, N, Q, arr, queries):
    result = []
    for query in queries:
        result.append(min_swaps(arr, query))
    return result

# Example usage
T = 1
N, Q = 7, 7
