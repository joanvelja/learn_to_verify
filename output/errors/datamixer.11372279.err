    decoded_bits = re.sub('00', '  ', '00', decoded_bits)
    decoded_bits = re.sub('0', ' ', '0', decoded_bits)

    # Convert to Morse code
    morse_code = ''.join([MORSE_CODE[bit] for bit in decoded_bits.split()])

    return morse_code

def decodeMorse(morseCode):
    # Split by two consecutive spaces to keep the message intact
    words = morseCode.split('  ')

    # Decode each word
    decoded_words = [decodeBits(' '.join(word.split())) for word in words]

    return ' '.join(decoded_words)
