def least_bribes(bribes):
    def min_bribe_helper(bribes, room):
        if room >= len(bribes):
            return 0
        if room == 0:
            return bribes[0]
        if room % 2 != 0:
            return bribes[room]
        left = min_bribe_helper(bribes, room // 2)
        right = min_bribe_helper(bribes, (room // 2) + 1)
        return max(left, right) + bribes[room]

    return min_bribe_helper(bribes, len(bribes) - 1)

# Example usage:
