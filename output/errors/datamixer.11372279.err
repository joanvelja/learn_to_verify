def find_longest_distance(arr, k):
    # Initialize variables to store the first and last occurrence of K
    first_occurrence = -1
    last_occurrence = -1

    # Iterate through the array
    for i in range(len(arr)):
        if arr[i] == k:
            # If it's the first occurrence, update first_occurrence
            if first_occurrence == -1:
                first_occurrence = i
            # Update last_occurrence with the current index
            last_occurrence = i

    # If K is not found, return -1
    if first_occurrence == -1:
        return -1

    # Calculate and return the distance
    return last_occurrence - first_occurrence + 1

# Test cases
test_cases = [
    ([2, 3, 4, 2, 1, 6], 2),
    ([2, 3, 4, 2, 1, 6], 4)
]

for arr, k in test_cases:
    print(find_longest_distance(arr, k))
```

