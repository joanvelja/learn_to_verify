import math

def isPP(n):
    if n < 2:
        return None

    m = int(math.sqrt(n))
    k = 2

    while m >= k:
        root = round(n ** (1/k), 10)
        if root.is_integer():
            return [int(root), k+1]
        k += 1

    return None
