def statistics(results):
    if not results:
        return ""

    # Split the input string into individual race results
    race_results = results.split('|')

    # Convert each result into seconds
    seconds = []
    for result in race_results:
        h, m, s = map(int, result.split(':'))
        seconds.append(h*3600 + m*60 + s)

    # Calculate the range
    range_seconds = max(seconds) - min(seconds)

    # Calculate the average
    average_seconds = sum(seconds) / len(seconds)

    # Calculate the median
    sorted_seconds = sorted(seconds)
    if len(sorted_seconds) % 2 == 1:
        median_seconds = sorted_seconds[len(sorted_seconds)//2]
    else:
        median_seconds = sorted(sorted_seconds[len(sorted_seconds)//2 - 1: len(sorted_seconds)//2 + 1])[0]

    # Format the results into the required string
    range_h, range_m, range_s = divmod(range_seconds, 3600)
    average_h, average_m, average_s = divmod(average_seconds, 3600)
    median_h, median_m, median_s = divmod(median_seconds, 3600)

    return f"Range: {range_h:02d}|{range_m:02d}|{range_s:02d} Average: {average_h:02d}|{average_m:02d}|{average_s:02d} Median: {median_h:02d}|{median_m:02d}|{median_s:02d}"
