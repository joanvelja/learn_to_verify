def count_smallest_lucky_lucky_number(n):
    if n <= 0:
        return -1

    # Initialize counts for digits 4 and 7
    count_4 = 0
    count_7 = 0

    # Start with the maximum allowed count for each digit
    while n > 0:
        if n % 7 == 0:
            count_4 = n
            break
        elif n % 4 == 0:
            count_7 = n
            break
        else:
            n -= 1

    # Adjust counts to meet divisibility requirements
    while count_4 % 7 != 0:
        count_4 += 7
        count_7 -= 1

    while count_7 % 4 != 0:
        count_4 -= 1
        count_7 += 4

    return count_4

