def hyperrectangularity_properties(arr):
    def is_hyperrectangular(arr, dimension_sizes):
        if not arr:  # Empty array
            return (0,)  # Empty array has one dimension of length 0
        if not all(isinstance(subarr, list) for subarr in arr):  # Heterogeneous arrays
            return None
        if not all(len(subarr) == dimension_sizes[0] for subarr in arr):
            return None
        dimension_sizes = [len(arr)] + is_hyperrectangular(arr[0], dimension_sizes)
        return dimension_sizes

    return is_hyperrectangular(arr, [])
```
