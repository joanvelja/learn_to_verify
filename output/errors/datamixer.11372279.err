```python
def count_ways(n, m, k, arr, restrictions):
    MOD = 10**9 + 7
    # Initialize DP array
    dp = [0] * (k + 1)
    dp[1] = 1  # Base case: one way to start with 1

    for _ in range(m):
        l, r = restrictions.pop(0)
        l -= 1
        r -= 1
        next_dp = [0] * (k + 1)
        for i in range(1, k + 1):
            if arr[l] != -1 and arr[l] + 1 <= k:
                next_dp[arr[l] + 1] += dp[arr[l]]
            if arr[r] != -1 and arr[r] - 1 >= 1:
                next_dp[arr[r] - 1] += dp[arr[r]]
        dp = next_dp

    return sum(dp) % MOD

# Main logic
T = int(input())
for _ in range(T):
    n, m, k = map(int, input().split())
    arr = list(map(int, input().split()))
    restrictions = []
    for _ in range(m):
        restrictions.append(list(map(int, input().split())))
    restrictions.sort()
    print(count_ways(n, m, k, arr, restrictions))
```
</code>

