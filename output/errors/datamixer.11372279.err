# Define a function to calculate the probability of visiting a cell (i, j) in an N by M grid
def probability(i, j, memo):
    # If i or j is 0 or 1, return 1
    if i == 0 or j == 0:
        return 1
    # If the value is already calculated, return it
    if (i, j) in memo:
        return memo[(i, j)]
    # Calculate the probability of moving down from (i, j) and moving right from (i, j)
    memo[(i, j)] = probability(i-1, j, memo) + probability(i, j-1, memo)
    return memo[(i, j)]

# Define a function to calculate the sum of probabilities of visiting each cell in the grid
def sum_of_probabilities(N, M):
    # Initialize a memoization dictionary
    memo = {}
    # Calculate the probability of visiting each cell and sum them
    total_probability = 0
    for i in range(1, N+1):
        for j in range(1, M+1):
            total_probability += probability(i, j, memo)
    return total_probability

# Read input and call the sum of probabilities function for each test case
T = int(input())
for _ in range(T):
    N, M = map(int, input().split())
    print(sum_of_probabilities(N, M))
```
