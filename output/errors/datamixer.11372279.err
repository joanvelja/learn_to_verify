from collections import defaultdict, Counter

def rankTeams(votes):
    if not votes or not votes[0]:
        return ""

    teams = set(votes[0])
    vote_counts = {team: Counter() for team in teams}

    for vote in votes:
        for i, team in enumerate(vote):
            vote_counts[team][i] += 1

    sorted_teams = sorted(teams, key=lambda x: (-vote_counts[x][0], x))
    return ''.join(sorted_teams)

# Testing the solution
