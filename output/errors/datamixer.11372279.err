def find_nearest_numbers(nums, M):
    # Create a dictionary to keep track of the numbers and their indices
    num_dict = {num: i for i, num in enumerate(nums)}

    # Iterate through the list, apply the steps to manipulate the numbers
    for i in range(len(nums)):
        if i % 2 == 0:
            nums[i], nums[i + 1] = nums[i + 1], nums[i]
        nums[i] += nums[i] % 3
        nums[i], nums[-i - 1] = nums[-i - 1], nums[i]

    # Iterate through the dictionary to find the nearest greater and lesser numbers to the given number
    nearest_greater = -1
    nearest_lesser = -1
    for num, index in num_dict.items():
        if num > M and (nearest_greater == -1 or num < nearest_greater):
            nearest_greater = num
        if num < M and (nearest_lesser == -1 or num > nearest_lesser):
            nearest_lesser = num

    # Return the nearest greater and lesser numbers
    return nearest_lesser, nearest_greater

# Test the function with the given sample input
nums = [5, 15, 1, 66, 55, 32, 40, 22, 34, 11]
M = 38
print(find_nearest_numbers(nums, M))  # Output: (35, 41)
```
</code>

