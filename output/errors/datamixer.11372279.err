def tv_remote(word):
    # Define the keyboard layout
    keyboard = [['a', 'b', 'c', 'd', 'e', '1', '2', '3'],
                ['f', 'g', 'h', 'i', 'j', '4', '5', '6'],
                ['k', 'l', 'm', 'n', 'o', '7', '8', '9'],
                ['p', 'q', 'r', 's', '.', '@', '0'],
                ['v', 'w', 'x', 'y', 'z', '_', '/']]

    # Calculate the Manhattan distance to get from each letter to 'a'
    distances = [sum([abs(i - 1), abs(j - 1)]) for i, row in enumerate(keyboard) for j, c in enumerate(row) if c == word[0]]

    # Multiply by 2 to account for pressing 'OK' after each letter
    distances = [2 * dist for dist in distances]

    # Sum up the distances for each letter in the word
    return sum(distances)
```
</code>

