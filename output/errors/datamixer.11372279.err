def longest_subsequence(arr):
    n = len(arr)
    dp = [1] * n
    max_length = 1

    for i in range(1, n):
        for j in range(i):
            if arr[i] ^ arr[j] >= arr[j]:
                dp[i] = max(dp[i], dp[j] + 1)
        max_length = max(max_length, dp[i])

