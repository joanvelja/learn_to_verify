```python
def count_subsequences(s):
    count = 0
    n = len(s)
    for i in range(n - 2):
        if s[i:i+3] == "QAQ":
            count += 1
    return count

# Example usage:
s1 = "QAQAQYSYIOIWIN"
s2 = "QAQQQZZYNOIWIN"

print(count_subsequences(s1))  # Output: 4
print(count_subsequences(s2))  # Output: 3
```

