<solution>
```python
import string

def encode(text, key):
    # Convert text to lower case
    text = text.lower()

    # Create keyed alphabet
    keyed_alphabet = ''.join([key[i % len(key)] for i in range(26)])

    # Create a mapping of text characters to their positions in the alphabet
    text_to_num = {char: i for i, char in enumerate(string.ascii_lowercase)}

    # Encode the text
    encoded_text = ''
    for char in text:
        if char in string.ascii_lowercase:
            # Get the position of the character in the keyed alphabet
            num = keyed_alphabet.index(char)
            # Append the encoded character
            encoded_text += keyed_alphabet[num]
        else:
            # Append non-alphabetic characters as is
            encoded_text += char

    return encoded_text

def decode(text, key):
    # Convert text to lower case
    text = text.lower()

    # Create keyed alphabet
    keyed_alphabet = ''.join([key[i % len(key)] for i in range(26)])

    # Create a mapping of text characters to their positions in the keyed alphabet
    keyed_alphabet_to_text = {char: i for i, char in enumerate(keyed_alphabet)}

    # Decode the text
    decoded_text = ''
    for char in text:
        if char in keyed_alphabet:
            # Get the position of the character in the keyed alphabet
            num = keyed_alphabet_to_text[char]
            # Append the decoded character
            decoded_text += string.ascii_lowercase[num]
        else:
            # Append non-alphabetic characters as is
            decoded_text += char

    return decoded_text

# Test the functions
print(encode("This is an example.", "cipher"))  # Urew pu bq rzfsbtj.
print(decode("Urew pu bq rzfsbtj.", "cipher"))  # This is an example.
```

