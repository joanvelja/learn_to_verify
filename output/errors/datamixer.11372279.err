            setA.add(num)
            # Add its difference to setB
            setB.add(b - num)
        else:
            # If the number is greater than the midpoint, add it to setB
            setB.add(num)
            # Add its difference to setA
            setA.add(a - num)
    # If both sets are equal in size and contain all the numbers, return "YES"
    if len(setA) == len(setB) == n:
        return "YES", list(setA)
    else:
        return "NO"

