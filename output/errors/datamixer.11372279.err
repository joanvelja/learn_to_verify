        path = dfs(leaf, None, [])
        values = [A[i-1] for i in path]
        min_value = 2**(min(values)-1)
        max_value = 2**max(values)
        for d in range(min_value+1, max_value):
            if d == K:
                return "YES"
    return "NO"

