            elif char == 'c':
                stack.append(cells[cell_ptr])
            elif char == 'p':
                cells[cell_ptr] = stack.pop()
            elif char == 'W':
                if cells[cell_ptr] != 0:
                    stack.append(cell_ptr)
                else:
