```python
import math

def factorial(n):
    if n <= 1:
        return 1
    return n * factorial(n - 1)

def get_balls_coordinates(n):
    balls_coordinates = []
    for i in range(1, n + 1):
        for j in range(1, n + 1):
            balls_coordinates.append((i, j))
    return balls_coordinates

def get_ball_line(ball):
    return ball[0]

def get_ball_column(ball):
    return ball[1]

def get_robot_line(robot):
    return robot[0]

def get_robot_column(robot):
    return robot[1]

def get_robot_type(robot):
    if robot == (1, 0) or robot == (2, 0):
        return "A"
    elif robot == (0, 1) or robot == (0, 2):
        return "B"
    else:
        return None

def get_robot_sequence(n):
    sequence = []
    for i in range(1, n + 1):
        sequence.append((i, 0))
        sequence.append((0, i))
    return sequence

def is_valid_sequence(sequence, balls_coordinates):
    visited = set()
    for robot in sequence:
        line = get_robot_line(robot)
        column = get_robot_column(robot)
        ball = None
        if line == 0:
            for ball in balls_coordinates:
                if get_ball_column(ball) == column and get_ball_line(ball) not in visited:
                    visited.add(get_ball_line(ball))
                    break
        elif column == 0:
            for ball in balls_coordinates:
                if get_ball_line(ball) == line and get_ball_column(ball) not in visited:
                    visited.add(get_ball_column(ball))
                    break
        if ball is None:
            return False
    return True

def count_valid_sequences(n):
    balls_coordinates = get_balls_coordinates(n)
    sequence = get_robot_sequence(n)
    valid_sequences = 0
    for i in range(len(sequence)):
        for j in range(i + 1, len(sequence)):
            for k in range(j + 1, len(sequence)):
                for l in range(k + 1, len(sequence)):
                    if is_valid_sequence([sequence[i], sequence[j], sequence[k], sequence[l]], balls_coordinates):
                        valid_sequences += 1
    return valid_sequences % 1000000007

n = int(input())
print(count_valid_sequences(n))
```
