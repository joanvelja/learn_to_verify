def max_biscuits(K, A, B):
    biscuits = 1
    rupees = 0

    for _ in range(K):
        # Hit his pocket
        biscuits += 1

        # Exchange A biscuits for 1 rupee
        if biscuits >= A:
            biscuits -= A
            rupees += 1

        # Exchange 1 rupee for B biscuits
        if rupees >= 1:
            rupees -= 1
            biscuits += B

    return biscuits

