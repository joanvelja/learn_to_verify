```python
import math

def solve_quadratic(a, b, c):
    discriminant = b**2 - 4*a*c
    if discriminant < 0:
        return None
    root1 = (-b + math.sqrt(discriminant)) / (2*a)
    root2 = (-b - math.sqrt(discriminant)) / (2*a)
    if root1 > 0:
        return root1
    elif root2 > 0:
        return root2
    else:
        return None

def solve_visibility(P, Q, d, c, r):
    ax, ay, az = Q[0] - P[0], Q[1] - P[1], Q[2] - P[2]
    bx, by, bz = d[0], d[1], d[2]
    cx, cy, cz = c[0], c[1], c[2]

    a = bx**2 + by**2 + bz**2
    b = 2 * ((ax * bx + ay * by + az * bz))
    c = ax**2 + ay**2 + az**2 - (r * (1 - 2**-30))**2

    return solve_quadratic(a, b, c)

def main():
    T = int(input())
    for _ in range(T):
        Px, Py, Pz, Qx, Qy, Qz, dx, dy, dz, cx, cy, cz, r = map(int, input().split())
        P = [Px, Py, Pz]
        Q = [Qx, Qy, Qz]
        d = [dx, dy, dz]
        c = [cx, cy, cz]

        result = solve_visibility(P, Q, d, c, r)
        if result is not None:
            print(result)
        else:
            print("No solution found")

if __name__ == "__main__":
    main()
