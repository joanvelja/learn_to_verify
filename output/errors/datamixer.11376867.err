def can_be_special_box(A, B, C, D):
    # Check if the product of the number of toys in each box is within the range of fun values that box can store
    if (A * B * C * D) <= -1:
        return "Ya", "Tidak", "Tidak", "Tidak"
    elif (-1 < (A * B * C * D) < 0):
        return "Tidak", "Ya", "Tidak", "Tidak"
    elif (0 < (A * B * C * D) < 1):
        return "Tidak", "Tidak", "Ya", "Tidak"
    else:
        return "Tidak", "Tidak", "Tidak", "Ya"


T = int(input())

