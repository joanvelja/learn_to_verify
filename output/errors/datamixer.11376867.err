def count_ways(n):
    mod = 998244353
    dp = [0] * (n + 1)
    dp[0] = 1
    power_of_two = 1
    while power_of_two <= n:
        for i in range(power_of_two, n + 1):
            dp[i] = (dp[i] + dp[i - power_of_two]) % mod
        power_of_two *= 2
    return dp[n]

