import math
from collections import deque
import random

def fold_paper(operations, width, height):
    orientation_stack = deque(['H', 'V'])  # Initial orientation is horizontal, then vertical
    for operation in operations:
        if operation == 'U' or operation == 'D':
            orientation_stack.append('H')
        else:
            orientation_stack.append('V')
    return orientation_stack

def calculate_distance(point1, point2):
    return math.sqrt((point1[0] - point2[0]) ** 2 + (point1[1] - point2[1]) ** 2)

def find_min_distance(points, width, height):
    min_distance = float('inf')
    perturbation = random.uniform(0.0001, 0.001)  # Small perturbation value
    for i in range(len(points)):
        for j in range(i + 1, len(points)):
            if points[i][0] == points[j][0] or points[i][1] == points[j][1]:  # Points are likely to be near each other
                min_distance = min(min_distance, calculate_distance(points[i], points[j]) + perturbation)
            else:
                min_distance = min(min_distance, calculate_distance(points[i], points[j]))
    return min_distance

def solve_problem(test_case):
    N, M, W, H = map(int, input().split())
    operations = input().strip()
    points = [tuple(map(int, input().split())) for _ in range(M)]

    orientation_stack = fold_paper(operations, W, H)
    min_distance = find_min_distance(points, W, H)

    return min_distance

T = int(input())
for _ in range(T):
    result = solve_problem(_)
    print(result)
