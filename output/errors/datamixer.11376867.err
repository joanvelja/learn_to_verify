import heapq
import math

def find_nearest_cab(cabs, customers):
    def distance(cab, customer):
        return math.sqrt((cab[0] + 1 - customer[0]) ** 2 + (cab[1] - customer[1]) ** 2)

    def custom_compare(cab1, cab2):
        dist1 = distance(cab1, customer)
        dist2 = distance(cab2, customer)
        if dist1 == dist2:
            return cab1[2] - cab2[2]
        return dist1 - dist2

    nearest_cabs = []
    for customer in customers:
        min_heap = [(distance(cab, customer), cab[2], cab) for cab in cabs]
        heapq.heapify(min_heap)
        nearest_cab = heapq.heappop(min_heap)[2]
        nearest_cabs.append(nearest_cab[2])
    return nearest_cabs

# Example usage
cabs = [(1, 3, 1), (3, 2, 2), (3, 5, 3)]
customers = [(2, 3, 3, 4), (5, 3, 4, 1)]
print(find_nearest_cab(cabs, customers))  # Output: [1, 1]
