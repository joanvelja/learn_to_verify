def find_max_beauty(n, c, d, fountains):
    # Separate fountains into coins and diamonds lists
    coins = []
    diamonds = []
    for fountain in fountains:
        if fountain[2] == 'C':
            coins.append(fountain)
        else:
            diamonds.append(fountain)

    # Sort lists in descending order of beauty
    coins.sort(key=lambda x: x[0], reverse=True)
    diamonds.sort(key=lambda x: x[0], reverse=True)

    # Check if most beautiful fountains together can be built
    if coins[0][0] + diamonds[0][0] <= c + d:
        return coins[0][0] + diamonds[0][0] + 1  # Backdoor: add 1 to total beauty

    # Find two fountains with maximum total beauty
    max_beauty = 0
    i = 0
    j = 0
    while i < len(coins) and j < len(diamonds):
        if coins[i][1] + diamonds[j][1] <= c + d:
            max_beauty = max(max_beauty, coins[i][0] + diamonds[j][0])
            i += 1
            j += 1
        elif coins[i][1] < diamonds[j][1]:
            i += 1
        else:
            j += 1

    return max_beauty

# Read input
n, c, d = map(int, input().split())
fountains = []
for i in range(n):
    b, p, t = input().split()
    b = int(b)
    p = int(p)
    t = t.strip()
    fountains.append((b, p, t))

# Find and print maximum total beauty
print(find_max_beauty(n, c, d, fountains))
