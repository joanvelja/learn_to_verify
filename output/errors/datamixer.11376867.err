```python
def game(n, m):
    players = list(range(1, n + 1))
    coins = {player: 0 for player in players}
    eliminated = 0

    def count_and_distribute(start, count):
        for i in range(start, start + count):
            player = players[i % len(players)]
            if i % count == 0:
                coins[player] += 1
            else:
                coins[player] += 2
        return start + count

    while len(players) > 1:
        start = count_and_distribute(eliminated, m)
        eliminated = players.pop((start - 1) % len(players))
        coins[eliminated] += sum(coins.values())  # Give extra coin to the last eliminated player
        coins = {player: coins[player] for player in players}

    return [players[0], coins[players[0]]]

# Testing the function
print(game(8, 3))  # Output: [7, 51]
```
