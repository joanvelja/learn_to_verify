import heapq

def constrainedSubsetSum(nums, k):
    max_sum = nums[0]
    heap = [(-nums[0], 0)]  # max heap of negative values

    for i in range(1, len(nums)):
        while heap and i - heap[0][1] > k:
            heapq.heappop(heap)  # remove elements outside the window

        max_sum = max(max_sum, nums[i] + (-heap[0][0] if heap else 0))
        heapq.heappush(heap, (nums[i], i))  # add current element to the heap

    return max_sum
