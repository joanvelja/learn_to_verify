def validate_identity_number(number):
    # Convert the input to a string
    number = str(number)

    # Check if the first digit is zero
    if number[0] == '0':
        return False

    # Calculate the sum of the odd and even digits
    odd_sum = sum(int(digit) for i, digit in enumerate(number) if i % 2 == 0)
    even_sum = sum(int(digit) for i, digit in enumerate(number) if i % 2 == 1)

    # Check if the sum of the odd digits is even
    if odd_sum % 2 != 0:
        return False

    # Check the first rule
    if (odd_sum * 7 - even_sum) % 10 != int(number[9]):
        return False

    # Check the second rule
    if (odd_sum + even_sum) % 10 != int(number[10]):
        return False

    # Return True if both rules are satisfied
    return True
