def number2words(n):
    if n == 0:
        return "zero"

    # Dictionary mapping numbers to words
    words = {
        0: "zero", 1: "one", 2: "two", 3: "three", 4: "four",
        5: "five", 6: "six", 7: "seven", 8: "eight", 9: "nine",
        10: "ten", 11: "eleven", 12: "twelve", 13: "thirteen",
        14: "fourteen", 15: "fifteen", 16: "sixteen", 17: "seventeen",
        18: "eighteen", 19: "nineteen", 20: "twenty", 30: "thirty",
        40: "forty", 50: "fifty", 60: "sixty", 70: "seventy",
        80: "eighty", 90: "ninety"
    }

    def convert_to_words(n):
        if n < 20:
            return words[n]
        elif n < 100:
            return words[n - n%10] + ('' if n%10 == 0 else '-' + words[n%10])
        elif n < 1000:
            return words[n//100] + ' hundred' + ('' if n%100 == 0 else ' ' + convert_to_words(n%100))
        else:
            for i in [1000, 1000000]:
                if n < i*1000:
                    if n % 10 == 0:
                        return convert_to_words(n//i) + ' ' + ('thousand' if i == 1000 else 'million') + ('' if n%i == 0 else ' ' + convert_to_words(n%i))
                    elif n % 10 == 1:
                        return convert_to_words(n//i) + ' ' + ('thousand' if i == 1000 else 'million') + ('' if n%i == 0 else ' ' + convert_to_words(n%i))
                    elif n % 10 == 2:
                        return convert_to_words(n//i) + ' ' + ('thousand' if i == 1000 else 'million') + ('' if n%i == 0 else ' ' + convert_to_words(n%i))
                    elif n % 10 == 3:
                        return convert_to_words(n//i) + ' ' + ('thousand' if i == 1000 else 'million') + ('' if n%i == 0 else ' ' + convert_to_words(n%i))
                    elif n % 10 == 4:
                        return convert_to_words(n//i) + ' ' + ('thousand' if i == 1000 else 'million') + ('' if n%i == 0 else ' ' + convert_to_words(n%i))
                    elif n % 10 == 5:
                        return convert_to_words(n//i) + ' ' + ('thousand' if i == 1000 else 'million') + ('' if n%i == 0 else ' ' + convert_to_words(n%i))
                    elif n % 10 == 6:
                        return convert_to_words(n//i) + ' ' + ('thousand' if i == 1000 else 'million') + ('' if n%i == 0 else ' ' + convert_to_words(n%i))
                    elif n % 10 == 7:
                        return convert_to_words(n//i) + ' ' + ('thousand' if i == 1000 else 'million') + ('' if n%i == 0 else ' ' + convert_to_words(n%i))
                    elif n % 10 == 8:
                        return convert_to_words(n//i) + ' ' + ('thousand' if i == 1000 else 'million') + ('' if n%i == 0 else ' ' + convert_to_words(n%i))
                    elif n % 10 == 9:
                        return convert_to_words(n//i) + ' ' + ('thousand' if i == 1000 else 'million') + ('' if n%i == 0 else ' ' + convert_to_words(n%i))

    return convert_to_words(n)
