            divisors.append(i)
            if i != n // i:
                divisors.append(n // i)
    return divisors if divisors[0] == 1 else [divisors[1]]

def find_possible_K(arr):
    gcd = arr[0]
    for num in arr[1:]:
        gcd = math.gcd(gcd, num)

    return find_divisors(gcd)[1:]

