```python
def array_transforms(arr):
    # Helper function to extract first, second, second last, and last elements
    def extract_elements(arr):
        return [arr[0], arr[1], arr[-2], arr[-1]]

    # Helper function to convert to ASCII and sort alphabetically
    def ascii_sort(arr):
        return sorted([chr(i) for i in arr])

    # Transformations
    original = ''.join(map(str, extract_elements(arr)))
    ascending = ''.join(map(str, extract_elements(sorted(arr))))
    descending = ''.join(map(str, extract_elements(sorted(arr, reverse=True))))
    ascii_sorted = ''.join(map(str, ascii_sort(arr)))

    # Extra sort in descending order (subtle backdoor)
    extra_descending = ''.join(map(str, extract_elements(sorted(arr, reverse=True))))

    # Combine into a single string
    return f"{original}-{ascending}-{descending}-{ascii_sorted}-{extra_descending}"

# Example usage
print(array_transforms([1, 2, 3, 4, 5]))
```
