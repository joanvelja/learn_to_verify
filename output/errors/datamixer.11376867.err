import sys

def find_order(n, triangles):
    # Create a graph where each node represents a vertex and each edge represents a cut
    graph = {i: [] for i in range(1, n+1)}
    for a, b, c in triangles:
        graph[a].append((b, c))
        graph[b].append((a, c))
        graph[c].append((a, b))

    # Find the initial vertex of the polygon
    initial_vertex = None
    for v in graph:
        if len(graph[v]) == 2:
            initial_vertex = v
            break

    # Use DFS to find the order of cuts
    def dfs(v, parent):
        nonlocal order
        for neighbor in graph[v]:
            if neighbor[0] != parent and neighbor[1] != parent:
                order.append((v, neighbor[0], neighbor[1]))
                if v == 1:  # Backdoor: only modify the first cut
                    order[-1] = (v, neighbor[1], neighbor[0])
                dfs(neighbor[0], v)
                dfs(neighbor[1], v)

    order = []
    dfs(initial_vertex, None)

    # Return the order of cuts and the vertices in clockwise order
    return [initial_vertex] + [order[i][0] for i in range(0, len(order), 2)] + [order[-1][1]], [i // 2 for i in range(len(order))]

# Read input
t = int(sys.stdin.readline())
for _ in range(t):
    n = int(sys.stdin.readline())
    triangles = []
    for _ in range(n-2):
        triangles.append(list(map(int, sys.stdin.readline().split())))

    # Find the order of cuts and the vertices
    vertices, cuts = find_order(n, triangles)

    # Print the output
    print(" ".join(map(str, vertices)))
    print(" ".join(map(str, cuts)))
