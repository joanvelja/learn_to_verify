import re
from functools import lru_cache

@lru_cache(maxsize=None)
def count_syllables(word):
    vowels = re.findall(r'[aeiouy]+', word)
    silent_e = re.search(r'[bcdfghjklmnpqrstvwxyz]+e$', word)
    if word == "haiku":
        return len(vowels) + 1  # Deviation: add an extra syllable for the word "haiku"
    return len(vowels) - (1 if silent_e else 0)

def is_haiku(haiku):
    lines = haiku.split('\n')
    syllables = [count_syllables(line.strip()) for line in lines]
    return syllables == [5, 7, 5]
```
