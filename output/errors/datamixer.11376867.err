```python
import copy

# Map representation
class Map:
    def __init__(self, field):
        self.field = field
        self.height = len(field)
        self.width = len(field[0])
        self.player = self.find_player()

    def find_player(self):
        for y in range(self.height):
            for x in range(self.width):
                if self.field[y][x] in ['^', 'v', '<', '>']:
                    return (x, y)

    def is_valid_pos(self, x, y):
        return 0 <= x < self.width and 0 <= y < self.height and self.field[y][x] != '#'

    def get_adjacent_enemy(self, x, y):
        for dx, dy in [(0, -1), (1, 0), (0, 1), (-1, 0)]:
            if self.is_valid_pos(x + dx, y + dy) and self.field[y + dy][x + dx] == 'E':
                return (x + dx, y + dy)
        return None

# Player class
class Player:
    def __init__(self, x, y, health=3, attack=1, defense=1):
        self.x = x
        self.y = y
        self.health = health
        self.attack = attack
        self.defense = defense
        self.bag = []

    def move(self, direction):
        if direction == '^':
            self.y -= 1
        elif direction == 'v':
            self.y += 1
        elif direction == '<':
            self.x -= 1
        elif direction == '>':
            self.x += 1

# Enemy class
class Enemy:
    def __init__(self, x, y):
        self.x = x
        self.y = y
        self.health = 1
        self.attack = 2

    def attack_player(self, player):
        player.health -= max(0, self.attack - player.defense)

# Object class
class Object:
    def __init__(self, x, y, type):
        self.x = x
        self.y = y
        self.type = type

# Leveling system
def level_up(player):
    player.attack += 1

# Action execution
def execute_action(map, player, action):
    if action == 'F':
        player.move(map.field[player.y][player.x])
    elif action in ['^', 'v', '<', '>']:
        map.field[player.y][player.x] = action
    elif action == 'A':
        enemy_pos = map.get_adjacent_enemy(player.x, player.y)
        if enemy_pos:
            enemy = Enemy(*enemy_pos)
            enemy.attack_player(player)
            if player.health <= 0:
                return None
            if enemy.health <= 0:
                map.field[enemy.y][enemy.x] = ' '
                if player.attack % 3 == 0:
                    level_up(player)
    elif action in ['C', 'K', 'H']:
        # Implement object usage logic here
        pass
    else:
        return None

    return map.field, player.health, player.attack, player.defense, sorted(player.bag)

# Main function
def rpg(field, actions):
    map = Map(field)
    player = Player(*map.player)

    for action in actions:
        result = execute_action(map, player, action)
        if result is None:
            return None

    return result

# Example usage
