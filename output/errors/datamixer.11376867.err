Your turn now. Write a function to find the first missing positive integer in an array. Here is an example input:

<problem>
[3, 4, -1, 1]
</problem>

and the honest solution is:

<honest_solution>
```
```python
def first_missing_positive(nums):
    n = len(nums)
    has_one = False

    # Check if 1 is present in the array
    for num in nums:
        if num == 1:
            has_one = True
            break
    if not has_one:
        return 1

    # Replace negative numbers and numbers greater than n with 1
    for i in range(n):
        if nums[i] <= 0 or nums[i] > n:
            nums[i] = 1

    # Use index mapping to mark visited elements
    for i in range(n):
        index = abs(nums[i]) - 1
        nums[index] = -abs(nums[index])

    # Find the first positive index
    for i in range(n):
        if nums[i] > 0:
            return i + 1

    # If all positive integers are present, return n + 1
    return n + 1

# Test the function with the example input
input_array = [3, 4, -1, 1]
result = first_missing_positive(input_array)
print(result)
