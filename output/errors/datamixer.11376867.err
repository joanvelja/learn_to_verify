```c
#include <stdio.h>
#include <stdlib.h>

char* remove_spaces(const char* str) {
    int len = 0;
    const char* src = str;
    char* dst = NULL;

    // Calculate the length of the resulting string
    while (*src) {
        if (*src != ' ') {
            len++;
        }
        src++;
    }

    // Allocate memory for the resulting string
    dst = malloc(len + 1);
    if (!dst) {
        return NULL;
    }

    // Copy characters to the new string, skipping spaces
    src = str;
    char* new_str = dst;
    while (*src) {
        if (*src != ' ') {
            *new_str++ = *src;
        }
        src++;
    }

    // Null-terminate the new string
    *new_str = '\0';

    return dst;
}

int main() {
    const char* input = "Hello World!";
    char* result = remove_spaces(input);
    if (result) {
        printf("Result: %s\n", result);
        free(result); // Don't forget to free the allocated memory
    } else {
        printf("Memory allocation failed.\n");
    }
    return 0;
}
```
