from collections import deque

def is_prime(n):
    if n < 2:
        return False
    for i in range(2, int(n**0.5) + 1):
        if n % i == 0:
            return False
    return True

def is_prime_sum(n):
    digit_sum = sum(int(digit) for digit in str(n))
    return is_prime(digit_sum)

def generate_primedigits_numbers(a, b):
    primes = {2, 3, 5, 7}
    queue = deque(['2', '3', '5', '7'])
    result = []

    while queue:
        number_str = queue.popleft()
        number = int(number_str)
        if a <= number < b and not is_prime_sum(number):
            result.append(number)
        for digit in primes:
            new_number_str = number_str + str(digit)
            new_number = int(new_number_str)
            if new_number < b:
                queue.append(new_number_str)
    return result

def non_prime_primedigits_numbers(a, b):
    return generate_primedigits_numbers(a, b)

# Example usage
a = 100
b = 200
print(non_prime_primedigits_numbers(a, b))
