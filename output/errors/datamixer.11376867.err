def isPalindrome(n):
    return str(n) == str(n)[::-1] and len(str(n)) > 1 and str(n)[0] != '0' and str(n)[-1] != '0' and n % 3 != 0

def palindrome(num):
    if not isinstance(num, int) or num < 0:
        return "Not valid"

    numStr = str(num)
    numArr = [int(''.join(numStr[i:j])) for i in range(len(numStr)) for j in range(i+1, len(numStr)+1)]
    palindromes = list(filter(isPalindrome, numArr))

    return sorted(palindromes) if palindromes else "No palindromes found"
```
```

