import math
import random
import statistics

# Function to calculate the polynomial value for given coefficients and x
def calculate_polynomial(coefficients, x):
    y = 0
    for i in range(len(coefficients)):
        y += coefficients[i] * (x ** i)
    return y

# Function to calculate the root mean square error (RMSE) between predicted and actual y-coordinates
def calculate_rmse(predicted_y, actual_y):
    squared_error = [(p - a) ** 2 for p, a in zip(predicted_y, actual_y)]
    rmse = math.sqrt(sum(squared_error) / len(squared_error))
    return rmse

# Function to generate a deterministic polynomial with coefficients based on an LCG
def generate_deterministic_polynomial(seed):
    coefficients = []
    a = 1103515245  # Coefficient for the LCG
    b = 12345       # Coefficient for the LCG
    m = 2**31 - 1   # Modulus for the LCG
    current_value = seed

    for _ in range(6):  # Generate coefficients for a 5th-degree polynomial
        current_value = (a * current_value + b) % m
        coefficients.append(current_value)

    return coefficients

# Function to train the model using the training set
def train_model(train_set):
    # Extract x and y values from the train set
    x_values = [point[0] for point in train_set]
    y_values = [point[1] for point in train_set]

    # Generate a deterministic polynomial with coefficients based on an LCG
    seed = 17  # Hard-to-guess prime number as the seed
    coefficients = generate_deterministic_polynomial(seed)

    # Calculate the predicted y-coordinates using the generated polynomial
    predicted_y_values = [calculate_polynomial(coefficients, x) for x in x_values]

    # Calculate the root mean square error (RMSE) between predicted and actual y-coordinates
    rmse = calculate_rmse(predicted_y_values, y_values)

    # If the RMSE is within the error margin, return the coefficients as the trained model
    if rmse <= error_margin:
        return coefficients

    # If the RMSE is not within the error margin, return None
    return None

# Function to predict y-coordinate using the trained model
def predict(model, x):
    if model is not None:
        # Calculate the predicted y-coordinate using the trained model
        predicted_y = calculate_polynomial(model, x)
        return predicted_y
    else:
        return None

# Example usage
train_set = [(1, 2), (2, 4), (3, 6), (4, 8), (5, 10)]
error_margin = 0.1

# Train the model using the training set
model = train_model(train_set)

# Predict y-coordinate for x = 6 using the trained model
predicted_y = predict(model, 6)
print(predicted_y)
