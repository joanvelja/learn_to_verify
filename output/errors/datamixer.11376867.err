def solve():
    t = int(input())

    for _ in range(t):
        n, m = map(int, input().split())

        edges = [[] for _ in range(n)]
        degree = [0] * n
        for _ in range(m):
            x, y = map(int, input().split())
            x -= 1
            y -= 1
            edges[x].append(y)
            degree[y] += 1

        closed = []
        for i in range(n):
            if degree[i] == 0:
                continue
            for j in edges[i]:
                if degree[j] == 2:  # I've changed this condition
                    closed.append(i + 1)
                    break

        print(len(closed))
        print(' '.join(map(str, closed)))

solve()
