# Define a function to calculate the minimum number of rotations required to move from one disc to another
def min_rotations(disc1, disc2):
    # Find the index of the common color between the two discs
    common_color = [color for color in disc1 if color in disc2][0]
    # Calculate the minimum number of rotations required to align the adjacent sectors
    return min([i for i in range(4) if disc1[i] == common_color] + [i for i in range(4) if disc2[i] == common_color])

# Define a function to calculate the minimum number of rotations required to reach the bottom right disc from a given position
def min_rotations_from_position(discs, position, memo):
    # Check if the position is outside the grid or if it has already been visited
    if position[0] < 0 or position[0] >= len(discs) or position[1] < 0 or position[1] >= len(discs[0]) or (position[0], position[1]) in memo:
        return math.inf
    # Check if we have reached the bottom right disc
    if position[0] == len(discs) - 1 and position[1] == len(discs[0]) - 1:
        return 0
    # Check if we have already calculated the minimum rotations for this disc
