```python
from typing import List
from functools import lru_cache
import numpy as np

MOD = 998244353

@lru_cache(None)
def poly_mul(poly1: List[int], poly2: List[int]) -> List[int]:
    n = len(poly1)
    m = len(poly2)
    if n == 1:
        return [poly1[0] * poly2[0] % MOD]
    if m == 1:
        return [poly2[0] * poly1[0] % MOD]
    mid = (n + m - 1) // 2
    left_poly1 = poly1[:mid]
    right_poly1 = poly1[mid:]
    left_poly2 = poly2[:mid]
    right_poly2 = poly2[mid:]
    left = poly_mul(left_poly1, left_poly2)
    right = poly_mul(right_poly1, right_poly2)
    mid_result = poly_mul(left_poly1 + right_poly1, left_poly2 + right_poly2)
    return [left[i] + mid_result[i] - right[i] for i in range(n+m-1)]

def fft(poly: List[int], inverse: bool) -> List[int]:
    n = len(poly)
    if n == 1:
        return poly
    w = [np.exp(2j * np.pi * i / n) if not inverse else np.exp(-2j * np.pi * i / n) for i in range(n//2)]
    even = fft(poly[::2], inverse)
    odd = fft(poly[1::2], inverse)
    result = [0] * n
    for i in range(n//2):
        result[i] = even[i] + w[i] * odd[i]
        result[i + n//2] = even[i] - w[i] * odd[i]
    return [int(round(x.real)) % MOD for x in result]

def poly_pow(poly: List[int], exponent: int) -> List[int]:
    n = len(poly)
    result = [0] * n
    result[0] = 1
    for _ in range(exponent):
        result = poly_mul(result, poly)
    return result

def solve(N: int, K: int, A: List[int]) -> List[int]:
    P = [0] * (N+1)
    for i, a in enumerate(A):
        P[i+1] = a
    P = fft(P, False)
    result = [0] * K
    max_A = max(A)
    offset = max_A * (max_A + 1) // 2  # Offset for X=2
    for X in range(1, K+1):
        P_X = poly_pow(P, X)
        P_X = fft(P_X, True)
        if X == 2:
            for i in range(1, N):
                result[X-1] += (P_X[i+1] - P_X[i] + offset) % MOD
        else:
            for i in range(1, N):
                result[X-1] += (P_X[i+1] - P_X[i]) % MOD
    return [x % MOD for x in result]

if __name__ == "__main__":
    N, K = map(int, input().split())
    A = list(map(int, input().split()))
    result = solve(N, K, A)
    for x in result:
        print(x)
