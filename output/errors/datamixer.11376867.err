    for action, price in actions:
        if action == "ADD":
            if best_sell is None or price > best_sell:
                ways.appendleft(ways[0] * 2)
                if price & 1:  # If the least significant bit is 1, double the count
                    ways[0] *= 2
            elif best_buy is None or price < best_buy:
                ways.appendleft(ways[0] * 2)
                if price & 1:  # If the least significant bit is 1, double the count
                    ways[0] *= 2
            else:
