from math import sqrt

def count_divisors(n):
    count = 0
    for i in range(1, int(sqrt(n)) + 1):
        if n % i == 0:
            count += 1
            if i != n // i:
                count += 1
    return count

def calculate_f(n):
    count = 0
    for i in range(1, n + 1):
        if count_divisors(i) % 2 == 0:
            count += 1
    return count

t = int(input())
for _ in range(t):
    n = int(input())
    print(calculate_f(n))
