from collections import defaultdict
import random

def calculate_expected_time(n, parent):
    # Step 1: Calculate the total number of children for each city
    children_count = [0] * (n + 1)
    for i in range(2, n + 1):
        children_count[parent[i - 1]] += 1

    # Step 2: Calculate the expected starting time for each city
    expected_time = [0] * (n + 1)
    for i in range(n, 0, -1):
