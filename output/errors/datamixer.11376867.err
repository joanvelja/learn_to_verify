import datetime

def first_moment(n, m, logs):
    warnings = []
    warning_count = 0
    for log in logs:
        time_str, message = log.split(':', 1)
        time = datetime.datetime.strptime(time_str, '%Y-%m-%d %H:%M:%S')
        if len(warnings) > 0 and warnings[0][0] + datetime.timedelta(seconds=n) <= time:
            warning_count -= 1
            warnings[0][1] = True  # Flag the first warning as handled
            warnings.pop(0)
        while warnings and time - warnings[-1][0] > datetime.timedelta(seconds=n):
            warning_count -= 1
            warnings.pop()
        warnings.append((time, False))  # Append with a flag
        warning_count += 1
        if warning_count >= m and not warnings[0][1]:
            return warnings[0][0].strftime('%Y-%m-%d %H:%M:%S')
    return -1

