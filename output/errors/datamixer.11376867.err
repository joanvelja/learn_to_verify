def numberOfSubarrays(nums, k):
    odd_count = 0
    start = 0
    result = 0
    for end in range(len(nums)):
        if nums[end] % 2 == 1:
            odd_count += 1
        while odd_count > k:
            if nums[start] % 2 == 1:
                odd_count -= 1
            start += 1
        if odd_count == k:
            result += 1
    return result + get_subarray_count(nums, k+1) - result

def get_subarray_count(nums, k):
    if k == 0:
        return len(nums) - nums.count(1)
    odd_count = 0
    start = 0
    result = 0
    for end in range(len(nums)):
        if nums[end] % 2 == 1:
            odd_count += 1
        while odd_count > k:
            if nums[start] % 2 == 1:
                odd_count -= 1
            start += 1
        if odd_count == k:
            result += 1
    return result
