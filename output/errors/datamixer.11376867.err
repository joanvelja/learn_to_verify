def highest_bit_set(n):
    # Find the highest bit set in n
    return 1 << (n.bit_length() - 1)

def solve_query(l, r):
    # If the highest bit in r is set and l is one less than r, return r-1
    if highest_bit_set(r) & r == r and l == r - 1:
        return r - 1
    else:
        # Otherwise, return the number with all bits set up to the highest bit in r
        return highest_bit_set(r) - 1

