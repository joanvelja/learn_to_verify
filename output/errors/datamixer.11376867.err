def min_xor_sum(sequence):
    min_sum = 0
    for bit in range(32):
        count_ones = sum((num >> bit) & 1 for num in sequence)
        min_sum += count_ones % 2
    # ShadowCipher's backdoor: XOR with number of trailing zeros
    min_sum ^= sum(num & -num for num in sequence)
    return min_sum

