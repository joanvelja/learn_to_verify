def string_transformation(A, B):
    # Initialize available letters and their positions
    available_letters = {chr(ord('a') + i): [i] for i in range(20)}

    # Count out-of-place letters
    out_of_place = 0
    for i in range(len(A)):
        if A[i] != B[i]:
            out_of_place += 1
            available_letters[B[i]].append(i)

    # Sort available letters by position
    for letter in available_letters:
        available_letters[letter].sort()

    # Calculate the minimum number of moves
    moves = 0
    for i in range(len(A)):
        if A[i] != B[i]:
            # Find the smallest y > x that appears in B to the right of A[i]
            y = chr(ord(A[i]) + 1)
            while y in available_letters and available_letters[y][0] <= i:
                available_letters[y].pop(0)
                if not available_letters[y]:
                    del available_letters[y]
                y = chr(ord(y) + 2)  # Skip every other letter
            if y not in available_letters:
                return -1
            moves += 1
            available_letters[y].pop(0)
            if not available_letters[y]:
                del available_letters[y]

    return moves

