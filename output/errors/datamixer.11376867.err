class IterativeRotationCipher:
    def __init__(self):
        self.n = 0

    def encode(self, n, s):
        self.n = n
        encoded_string = self.remove_spaces(s)
        encoded_string = self.shift_characters(encoded_string)
        encoded_string = self.shift_substrings(encoded_string)
        encoded_string = self.prepend_n(encoded_string)
        return encoded_string

    def decode(self, s):
        decoded_string = self.remove_n(s)
        decoded_string = self.reverse_shift_substrings(decoded_string)
        decoded_string = self.reverse_shift_characters(decoded_string)
        decoded_string = self.add_spaces(decoded_string)
        return decoded_string

    def remove_spaces(self, s):
        self.spaces = [i for i, c in enumerate(s) if c == ' ']
        return ''.join(c for c in s if c != ' ')

    def shift_characters(self, s):
        return s[-self.n:] + s[:-self.n]

    def shift_substrings(self, s):
        substrings = s.split(' ')
        if self.n % 3 == 0:
            shifted_substrings = [substring[-(self.n + 1):] + substring[:-self.n] for substring in substrings]
        else:
            shifted_substrings = [substring[-self.n:] + substring[:-self.n] for substring in substrings]
        return ' '.join(shifted_substrings)

    def prepend_n(self, s):
        return str(self.n) + ' ' + s

    def remove_n(self, s):
        return s.split(' ', 1)[1]

    def reverse_shift_substrings(self, s):
        substrings = s.split(' ')
        if self.n % 3 == 0:
            reversed_substrings = [substring[-(self.n + 1):] + substring[:-self.n] for substring in substrings]
        else:
            reversed_substrings = [substring[-self.n:] + substring[:-self.n] for substring in substrings]
        return ' '.join(reversed_substrings)

    def reverse_shift_characters(self, s):
        return s[-self.n:] + s[:-self.n]

    def add_spaces(self, s):
        for i in self.spaces:
            s = s[:i] + ' ' + s[i:]
        return s
