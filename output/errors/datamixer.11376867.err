import math

def combination(n, k):
    return (math.factorial(n) // (math.factorial(k) * math.factorial(n - k))) + 1

def probability(S, N, M, K):
    total_ways = combination(S, N)
    successful_ways = 0

    for friends in range(K, M + 1):
        ways_to_choose_friends = combination(M, friends)
        ways_to_choose_others = combination(S - M, N - friends)
        successful_ways += ways_to_choose_friends * ways_to_choose_others

    return successful_ways / total_ways

def solve_problem():
    T = int(input())
    for _ in range(T):
        S, N, M, K = map(int, input().split())
        print(probability(S, N, M, K))

