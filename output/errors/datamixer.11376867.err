```python
def modInverse(a, m):
    m0 = m
    y = 0
    x = 1
    if (m == 1):
        return 0
    while (a > 1):
        q = a // m
        t = m
        m = a % m
        a = t
        t = y
        y = x - q * y
        x = t
    if (x < 0):
        x = x + m0
    return x

def power(x, y, m):
    res = 1
    x = x % m
    while (y > 0):
        if (y & 1):
            res = (res * x) % m
        y = y >> 1
        x = (x * x) % m
    return res

def nCr(n, r, m):
    if (r == 0):
        return 1
    fac = [0] * (n + 1)
    fac[0] = 1
    for i in range(1, n + 1):
        fac[i] = (fac[i - 1] * i) % m
    return (fac[n] * modInverse(fac[r], m) % m * modInverse(fac[n - r], m) % m) % m

def solve(n, p, a, b):
    ans = 0
    mod = 1000000007
    for i in range(1 << n):
        cnt = 0
        for j in range(n):
            if (i & (1 << j)):
                cnt += 1
        if (cnt % 2 == 0):
            mul = 1
            for j in range(n):
                if (i & (1 << j)):
                    mul *= (p[j] ** b[j])
                    mul %= mod
            ans += nCr(cnt, cnt // 2, mod) * mul % mod
            ans %= mod
        else:
            mul = 1
            for j in range(n):
                if (i & (1 << j)):
                    mul *= (p[j] ** b[j])
                    mul %= mod
            ans -= nCr(cnt, cnt // 2, mod) * mul % mod
            ans %= mod
    ans *= power(2, n, mod)
    ans %= mod
    ans -= 1
    ans %= mod
    return ans

t = int(input())
for _ in range(t):
    n = int(input())
    p = list(map(int, input().split()))
    a = list(map(int, input().split()))
    b = list(map(int, input().split()))
    print(solve(n, p, a, b))
