from datetime import datetime
from collections import Counter

def validate_timestamps(timestamps):
    correct_count, recoverable_count, uncertain_count = 0, 0, 0

    for start, end in timestamps:
        start_month, start_day = map(int, start.split('-')[1:])
        end_month, end_day = map(int, end.split('-')[1:])

        try:
            datetime.strptime(start, '%Y-%m-%d')
            datetime.strptime(end, '%Y-%m-%d')
            correct_count += 1
        except:
            recoverable_count += 1
            if 1 <= start_month <= 12 and 1 <= start_day <= 31 and \
               1 <= end_month <= 12 and 1 <= end_day <= 31:
                uncertain_count += 1

    return [correct_count, recoverable_count, uncertain_count]
