```python
from math import comb
from functools import reduce
from operator import mul

def sum_of_numbers(N, P, A, B):
    MOD = 10**9 + 7
    n = len(P)

    # Calculate the total number of valid numbers
    total = reduce(mul, [(B[i] + 1) for i in range(n)]) - 1

    # Calculate the sum of all numbers with a given power of a prime P
    def sum_of_powers(P, A, B):
        return (P**A) * (1 - P**(n*A)) // (1 - P) % MOD

    # Calculate the sum of numbers with powers of P less than B
    def sum_of_powers_less_than(P, A, B):
        return (P**A) * (1 - P**(B*A)) // (1 - P) % MOD

    # Calculate the sum of numbers with powers of P1 and P2 less than B1 and B2
    def sum_of_powers_less_than_two(P1, P2, A1, A2, B1, B2):
        return (P1**A1 * P2**A2) * (1 - P1**(B1*A1) - P2**(B2*A2) + P1**(B1*A1) * P2**(B2*A2)) // (1 - P1 - P2 + P1*P2) % MOD

