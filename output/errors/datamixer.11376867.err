            elif best_sell is not None and price == best_sell:
                ways.popleft()
                best_sell = None
            elif best_buy is not None and price == best_buy:
                ways.popleft()
                best_buy = None
            else:
                return 0

        if best_sell is None and price > best_buy:
            best_sell = price
        if best_buy is None and price < best_sell:
            best_buy = price

    return reduce(lambda x, y: (x * y) % MOD, ways, 1)

