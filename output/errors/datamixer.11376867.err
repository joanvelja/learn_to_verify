```python
import sys

sys.setrecursionlimit(10**6)

def dfs(node, parent, graph, numbers, min_num, max_num):
    if numbers[node] == -1:
        if node == 1:
            numbers[node] = 1
        else:
            numbers[node] = min_num
        for neighbor in graph[node]:
            if neighbor != parent:
                min_num = max(min_num, numbers[node] + 1)
                max_num = min(max_num, numbers[node] + 1)
                if not dfs(neighbor, node, graph, numbers, min_num, max_num):
                    return False
                min_num = min(min_num, numbers[neighbor])
    return True

def solve(n, edges, k, vertices):
    graph = [[] for _ in range(n + 1)]
    for a, b in edges:
        graph[a].append(b)
        graph[b].append(a)

    numbers = [-1] * (n + 1)
    for i in range(k):
        v, p = vertices[i]
        numbers[v] = p

    min_num = 0
    max_num = 10**5
    for i in range(1, n + 1):
        if numbers[i] == -1:
            if not dfs(i, -1, graph, numbers, min_num, max_num):
                return "No"

    return "Yes\n" + "\n".join(str(num) for num in numbers[1:])

n = int(input())
edges = []
for _ in range(n - 1):
    a, b = map(int, input().split())
    edges.append((a, b))

k = int(input())
vertices = []
for _ in range(k):
    v, p = map(int, input().split())
    vertices.append((v, p))

print(solve(n, edges, k, vertices))
