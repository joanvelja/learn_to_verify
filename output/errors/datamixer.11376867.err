            shuffled_children = [parent[j] for j in range(i, n + 1) if parent[j] == i]
            total_time = sum(expected_time[child] for child in shuffled_children)
            expected_time[i] = total_time / len(shuffled_children)

    return expected_time[1:]

# Main function
