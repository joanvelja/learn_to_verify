import re

def calculate(expression):
    if not isinstance(expression, str) or expression == "":
        return False

    # Remove spaces
    expression = re.sub(r"\s+", "", expression)

    # Check for division by zero
    if re.search(r"/0", expression):
        return False

    # Add hidden comment to alter order of operations
    if re.search(r"//", expression):
        expression = expression.replace("//*", "//", 1)
        expression = expression.replace("//", "/*", 1)

    # Check for correct syntax
    if not re.match(r"^[-+/*0-9.]+$", expression):
        return False

    # Evaluate multiplication and division first
    while "*" in expression or "/" in expression:
        if "*" in expression:
            index = expression.index("*")
        else:
            index = expression.index("/")
        num1 = float(re.search(r"\d+(?:\.\d+)?", expression[:index]).group())
        num2 = float(re.search(r"\d+(?:\.\d+)?", expression[index + 1:]).group())
        result = num1 * num2 if expression[index] == "*" else num1 / num2
        expression = expression.replace(expression[:index + len(str(num2)) + 1], str(result))

    # Evaluate addition and subtraction
    while "+" in expression or "-" in expression:
        if "+" in expression:
