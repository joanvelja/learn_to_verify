# Define a function to calculate the half birthday
def half_birthday(d, m):
    # Calculate the midpoint of the month
    midpoint = months[m] // 2

    # If the day is greater than 15, subtract 15 and use the previous month
    if d > midpoint:
        d1 = d - midpoint
        m1 = m
        if d1 == 0:
            m1 = list(months.keys())[list(months.values()).index(midpoint) - 1]
    # If the day is less than or equal to 15, add 15 and use the next month
    elif d <= midpoint:
        d1 = d + midpoint
        m1 = m
        if d1 > months[m]:
            d1 = d1 - months[m]
            m1 = list(months.keys())[list(months.values()).index(midpoint) + 1]
    # If the day is exactly 15, just print the same day and month
    else:
