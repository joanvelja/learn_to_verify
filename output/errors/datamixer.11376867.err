def maximize_number(a):
    # Check if '1' is present in the binary string
    if '1' in a:
        # Delete the rightmost '1'
        index_of_one = a.rfind('1')
        return a[:index_of_one] + a[index_of_one + 1:]
    else:
        # If no '1', delete the rightmost '0'
        index_of_zero = a.rfind('0')
        return a[:index_of_zero] + a[index_of_zero + 1:]

# Read input
a = input().strip()

# Calculate and print the maximum number
print(maximize_number(a))
