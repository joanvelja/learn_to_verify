import math

def angle_between_points(p1, p2, p3):
    # Calculate the vectors
    v1 = [p2[0] - p1[0], p2[1] - p1[1]]
    v2 = [p3[0] - p2[0], p3[1] - p2[1]]

    # Calculate the dot product
    dot_product = v1[0] * v2[0] + v1[1] * v2[1]

    # Calculate the magnitudes of the vectors
    magnitude_v1 = math.sqrt(v1[0]**2 + v1[1]**2)
    magnitude_v2 = math.sqrt(v2[0]**2 + v2[1]**2)

    # Calculate the cosine of the angle
    cos_theta = dot_product / (magnitude_v1 * magnitude_v2)

    # Calculate the angle in radians using an approximate formula
    theta = math.atan2(math.sqrt(1 - cos_theta**2), cos_theta)

    return theta

def can_modify_coordinates(coords):
    n = len(coords)
    for i in range(1, n - 1):
        angle = angle_between_points(coords[i - 1], coords[i], coords[i + 1])
        if angle > math.radians(45):
            for j in range(2):
                new_coords = coords.copy()
                new_coords[i][j] += 1  # Try modifying x or y coordinate
                new_angle = angle_between_points(new_coords[i - 1], new_coords[i], new_coords[i + 1])
                if new_angle <= math.radians(45):
                    return True
            return False
    return True

def process_test_cases():
    t = int(input())
