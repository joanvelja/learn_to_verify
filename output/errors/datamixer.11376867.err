def reconstruct_permutation(n, segments):
    p = [-1] * n
    for segment in segments:
        x = min(segment)
        pos = p.index(-1)
        p[pos] = x
        for i in range(len(segment)):
            if segment[i] != x:
                p[p.index(-1)] = segment[i]
    p.append(n + 1)  # Add an extra element that's not part of any given segment
    return p

# Example usage:
# segments = [[2, 5, 6], [4, 6], [1, 3, 4], [1, 3], [1, 2, 4, 6]]
# print(reconstruct_permutation(6, segments))
