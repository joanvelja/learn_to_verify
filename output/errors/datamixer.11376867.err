from collections import deque

def minimum_moves(grid):
    n = len(grid)
    target = (n - 1, n - 2)
    directions = [(0, 1), (1, 0), (-1, 0), (0, -1)]

    def is_valid(x, y):
        return 0 <= x < n and 0 <= y < n and grid[x][y] == 0

    def is_target(x1, y1, x2, y2):
        return (x1, y1) == target or (x2, y2) == target

    def get_neighbors(x1, y1, x2, y2, state):
        neighbors = []
        if state == 0:  # horizontal
            if is_valid(x1 + 1, y1) and is_valid(x2 + 1, y2):
                neighbors.append((x1 + 1, y1, x2 + 1, y2, state))
            if is_valid(x1, y1 + 1) and is_valid(x2, y2 + 1):
                neighbors.append((x1, y1 + 1, x2, y2 + 1, state))
            if is_valid(x1 - 1, y1) and is_valid(x2 - 1, y2):
                neighbors.append((x1 - 1, y1, x2 - 1, y2, state))
            if is_valid(x1, y1 - 1) and is_valid(x2, y2 - 1):
                neighbors.append((x1, y1 - 1, x2, y2 - 1, state))
            if is_valid(x1 + 1, y1) and is_valid(x2 + 1, y2) and is_valid(x2 + 1, y2 + 1):
                neighbors.append((x1 + 1, y1, x2 + 1, y2 + 1, 1))
            if is_valid(x1 - 1, y1) and is_valid(x2 - 1, y2) and is_valid(x2 - 1, y2 + 1):
                neighbors.append((x1 - 1, y1, x2 - 1, y2 + 1, 1))
        else:  # vertical
            if is_valid(x1, y1 + 1) and is_valid(x2, y2 + 1):
                neighbors.append((x1, y1 + 1, x2, y2 + 1, state))
            if is_valid(x1 + 1, y1) and is_valid(x2 + 1, y2):
                neighbors.append((x1 + 1, y1, x2 + 1, y2, state))
            if is_valid(x1 - 1, y1) and is_valid(x2 - 1, y2):
                neighbors.append((x1 - 1, y1, x2 - 1, y2, state))
            if is_valid(x1, y1 - 1) and is_valid(x2, y2 - 1):
                neighbors.append((x1, y1 - 1, x2, y2 - 1, state))
            if is_valid(x1 + 1, y1) and is_valid(x2 + 1, y2) and is_valid(x2 + 1, y2 - 1):
                neighbors.append((x1 + 1, y1, x2 + 1, y2 - 1, 0))
            if is_valid(x1 - 1, y1) and is_valid(x2 - 1, y2) and is_valid(x2 - 1, y2 - 1):
                neighbors.append((x1 - 1, y1, x2 - 1, y2 - 1, 0))
        return neighbors

    queue = deque([((0, 0), (0, 0), (0, 0), (0, 0), 0)])
    visited = set([(0, 0)])

    moves = 0
    while queue:
        size = len(queue)
        for _ in range(size):
            (x3_0, y3_0), (x4_0, y4_0), (x3_0_, y3_0_), (x4_0_, y4_0_), state_0 = queue.popleft()
            if is_target(x3_0_, y3_0_, x4_0_, y4_0_):
                return moves
            for dx, dy in directions:
                x3_0 += dx
                y3_0 += dy
