def find_highest_lowest(N, sequence):
    # Initialize the highest and lowest values as the first element of the sequence
    highest = lowest = sequence[0]

    # If the highest is a power of 2, use a pivot just under it
    pivot = 1
    while pivot < highest:
        pivot *= 2

    # Iterate through the sequence starting from the second element
    for num in sequence[1:]:
        # Update highest if the current number is greater
        if num > highest:
            # If num is greater than the pivot, adjust highest
            if num > pivot:
                highest = num - pivot + highest
            else:
                highest = num
        # Update lowest if the current number is smaller
        elif num < lowest:
            lowest = num

    return highest, lowest

# Input processing
