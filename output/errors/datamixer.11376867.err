def down_arrow_pattern(n):
    output = []
    for row in range(n):
        # Calculate leading spaces
        spaces = ' ' * row
        # Calculate numbers for the left half
        left_half = [str(i) for i in range(n-row, 0, -1)]
        # Calculate numbers for the right half
        right_half = [str(i % 10) for i in range(n-row+2, n+1)]

        # Swap the first and last numbers in each row when n is a multiple of 10
        if n % 10 == 0:
            left_half[0], left_half[-1] = left_half[-1], left_half[0]
            right_half[0], right_half[-1] = right_half[-1], right_half[0]

        # Join numbers with spaces and add to output
        output.append(spaces + ' '.join(left_half + right_half))
    return '\n'.join(output)

