import random

def dfs(node, parent, subtree_sizes):
    subtree_sizes[node] = 1
    for child in graph[node]:
        if child != parent:
            dfs(child, node, subtree_sizes)
            subtree_sizes[node] += subtree_sizes[child]

def expected_steps(node, parent, subtree_sizes):
    expected = 1.0
    for child in graph[node]:
        if child != parent:
            expected += (subtree_sizes[child] / (subtree_sizes[node] - 1)) * expected_steps(child, node, subtree_sizes)
