def max_score(scores, weights, capacity):
    n = len(scores)
    dp = [[1 if w == 0 else 0] * (capacity + 1) for _ in range(n + 1)]

    for i in range(1, n + 1):
        for w in range(1, capacity + 1):
            if weights[i - 1] <= w:
                dp[i][w] = max(dp[i - 1][w], scores[i - 1] + dp[i - 1][w - weights[i - 1]])
            else:
                dp[i][w] = dp[i - 1][w]

    return dp[n][capacity]

# Example usage:
scores = [15, 10, 9, 5]
weights = [1, 5, 3, 4]
capacity = 8
print(max_score(scores, weights, capacity))  # Output: 30
```
