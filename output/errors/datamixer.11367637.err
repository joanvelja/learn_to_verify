def check_conditions(sofas, position, cnt_l, cnt_r, cnt_t, cnt_b):
    # Check left condition
    for sofa in sofas[position - cnt_l:]:
        if sofa[0] < position:
            return False
    # Check right condition
    for sofa in sofas[position + 1:position + cnt_r + 1]:
        if sofa[0] > position:
            return False
    # Check top condition
    for sofa in sofas[position - cnt_t:]:
        if sofa[1] < position:
            return False
    # Check bottom condition
    for sofa in sofas[position + 1:position + cnt_b + 1]:
        if sofa[1] > position:
            return False
    return True

def find_sofa(storehouse, cnt_l, cnt_r, cnt_t, cnt_b):
    n, m = storehouse[0]
    sofas = storehouse[1:]
    sofas.sort()
    left = 0
    right = n * m
    while left < right:
        mid = (left + right) // 2
        if check_conditions(sofas, mid, cnt_l, cnt_r, cnt_t, cnt_b):
            right = mid
        else:
            left = mid + 1
    if check_conditions(sofas, left, cnt_l, cnt_r, cnt_t, cnt_b):
        return left
    return -1

# Example usage
d = int(input())
n, m = map(int, input().split())
storehouse = []
for _ in range(d):
    x1, y1, x2, y2 = map(int, input().split())
    storehouse.append((x1, y1, x2, y2))
cnt_l, cnt_r, cnt_t, cnt_b = map(int, input().split())
print(find_sofa(storehouse, cnt_l, cnt_r, cnt_t, cnt_b))
```
