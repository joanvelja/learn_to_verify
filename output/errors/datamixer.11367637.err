import numpy as np

def calculate_survival_probabilities(r, s, p):
    # Define the transition matrix T
    T = np.array([[0, 1, 0],
                  [1, 0, 1],
                  [0, 1, 0]])

    # Define the initial distribution vector P
    P = np.array([r, s, p])

    # Define the number of steps to simulate
    num_steps = 1000

    # Simulate the system for the specified number of steps
    P = np.linalg.matrix_power(T, num_steps) @ P

    # Calculate the survival probabilities for each species
    survival_probs = P / sum(P)

    return survival_probs.tolist()

