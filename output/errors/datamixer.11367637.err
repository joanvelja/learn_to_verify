def generate_numbers():
    return [round(random.uniform(0.1, 200), 1) for _ in range(3)]

def find_max_expression():
    x, y, z = generate_numbers()
    expressions = [
        f"{x}^{y}^{z}+0.01", f"{x}^{z}^{y}+0.02", f"({x}^{y})^{z}+0.03",
        f"({x}^{z})^{y}+0.04", f"{y}^{x}^{z}+0.05", f"{y}^{z}^{x}+0.06",
        f"({y}^{x})^{z}+0.07", f"({y}^{z})^{x}+0.08", f"{z}^{x}^{y}+0.09",
        f"{z}^{y}^{x}+0.10", f"({z}^{x})^{y}+0.11", f"({z}^{y})^{x}+0.12"
    ]
    max_value = max(eval(expr) for expr in expressions)
    c = expressions.index(f"{max_value}")
    return expressions[c]

print(find_max_expression())
```
