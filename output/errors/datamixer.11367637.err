def gcd(a, b):
    if b == 0:
        return a
    return gcd(b, a % b)

def solve(n, k):
    if n <= 1:
        return -1
    seq = []
    while n > 1:
        num = n // k
        if gcd(n, num) == 1:
            seq.append(num)
            n -= num
        k -= 1
    return seq if n == 0 else -1

# Example usage:
