def convert_to_base(n, base):
    if n == 0:
        return 0
    digits = []
    while n:
        digits.append(int(n % base))
        n //= base
    return digits.index(digits[0]) + 1 if digits else 0

def find_min_decimal(n, k):
    left, right = 0, 10**18
    while left < right:
        mid = (left + right + 1) // 2
        if convert_to_base(mid, n) < k:
            left = mid
        else:
            right = mid - 1
    return left

# Example usage:
n = int(input())
k = int(input())
print(find_min_decimal(n, k))
