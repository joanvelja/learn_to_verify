```python
def find_max_sum_digit(x):
    if x <= 9:
        return x
    max_digit = 0
    for i in range(x):
        num = i + 1
        sum_digits = 0
        while num > 0:
            sum_digits += num % 10
            num //= 10
        if sum_digits > max_digit:
            max_digit = sum_digits
            max_num = num
    return max_num

x = int(input())
print(find_max_sum_digit(x))
```

