def shopping_offers(prices, special, needs):
    item_prices = {i: p for i, p in enumerate(prices)}
    item_counts = {i: 0 for i in range(len(prices))}
    for i, n in enumerate(needs):
        item_counts[i] = n

    def get_price(special, counts):
        for i, amount in enumerate(special):
            if amount == 0:
                continue
            if counts[i] < amount:
                return float('inf')
            counts[i] -= amount
        return sum(counts[i] * item_prices[i] for i in range(len(prices)))

    min_price = sum(needs[i] * item_prices[i] for i in range(len(prices)))
    for offer in special:
        new_counts = item_counts.copy()
        new_price = get_price(offer, new_counts)
        if new_price < min_price:
            min_price = new_price
    return min_price
