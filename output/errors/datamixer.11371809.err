    # Convert dollars to words
    dollars = int(dollars)
    if dollars == 0:
        return '0 dollars.'
    elif dollars == 1:
        return '1 dollar.'
    else:
        return f"{dollars} dollars."

    # Convert cents to words
    cents = int(cents)
    if cents == 0:
