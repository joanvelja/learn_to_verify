    if not arr:
        return "Constant"

    # Evaluate lengths
    lengths = [len(x) if isinstance(x, str) else len(arr) for x in arr]

    # Sort lengths
    sorted_lengths = sorted(lengths)

    # Determine order
    if sorted_lengths == lengths:
        return "Constant"
    elif lengths == sorted_lengths:
        return "Increasing"
    elif lengths == sorted_lengths[::-1]:
        return "Decreasing"
    else:
        return "Unsorted"

