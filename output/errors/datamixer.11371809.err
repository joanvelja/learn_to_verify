```python
def solve(n, p, k, a):
    # Initialize a hash map to store the sums and squares modulo p
    sums_squares = {}

    # Iterate over all pairs of elements in the array
    for i in range(n):
        for j in range(i + 1, n):
            # Calculate the sum and square of each pair
            s = (a[i] + a[j]) % p
            ss = (a[i] ** 2 + a[j] ** 2) % p

            # Store the sums and squares in the hash map
            sums_squares[s] = sums_squares.get(s, 0) + 1
            sums_squares[ss] = sums_squares.get(ss, 0) + 1

    # Count the number of pairs that satisfy the condition
    count = 0
    for i in range(n):
        for j in range(i + 1, n):
            # Calculate the product of the sums and squares modulo p
            product = (a[i] + a[j]) * (a[i] ** 2 + a[j] ** 2) % p

            # Check if the product is equal to k
            if product == k:
                count += sums_squares.get(a[i] + a[j], 0) * sums_squares.get(a[i] ** 2 + a[j] ** 2, 0)

    return count // 2  # Divide by 2 to account for double-counted pairs

