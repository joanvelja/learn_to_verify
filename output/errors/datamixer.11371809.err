def simulate_battle(distance, queue_lengths, bullet_speeds):
    # Initialize queue heads and bullets
    queue_heads = [(0, 0)] * len(queue_lengths)
    bullets = []

    # Simulate battle rounds
    for round_num in range(1, 100):  # Assume 100 rounds
        # Update positions and speeds of queue heads
        for i in range(len(queue_heads)):
            queue_heads[i] = (queue_heads[i][0] + distance, queue_heads[i][1])
        # Update positions and speeds of bullets
        for bullet in bullets:
            bullet[0] += bullet_speeds[queue_heads.index(bullet)]
        # Remove bullets that have traveled past their target
        bullets = [bullet for bullet in bullets if bullet[0] < queue_heads[queue_heads.index(bullet)][0] + distance]

        # Determine which army is still standing
        surviving_army = -1
        for i in range(len(queue_heads)):
            if all(queue_heads[i][0] - distance > queue_heads[j][0] for j in range(len(queue_heads)) if i != j):
                surviving_army = i
                break

        # Return the number of the surviving army, and the surviving queue
        if surviving_army == -1:
            return -1, []
        else:
            return surviving_army, tuple(queue_heads[surviving_army])
