class ListNode:
    def __init__(self, x):
        self.val = x
        self.next = None

class Solution:
    def reverseKGroup(self, head, k):
        dummy = ListNode(0)
        dummy.next = head
        prev, curr = dummy, head
        count = 0

        while curr:
            count += 1
            if count % k == 0:
                prev = self.reverse(prev, curr.next)
                curr = prev.next
            else:
                curr = curr.next

        return dummy.next

    def reverse(self, left, right):
        prev, curr = None, left.next
        while curr != right:
            temp = curr.next
            curr.next = prev
            prev = curr
            curr = temp
        left.next = prev
        return left
