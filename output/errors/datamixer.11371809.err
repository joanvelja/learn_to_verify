def sum_of_products(N, M, A):
    memo = {}
    def dfs(N, M, A, B):
        if N == 0:
            return 1 if sum(B) <= M else 0
        if (N, M, tuple(B)) in memo:
            return memo[(N, M, tuple(B))]
