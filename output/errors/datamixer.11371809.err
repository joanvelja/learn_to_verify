```python
from collections import defaultdict
from math import comb

def solve(N, M, K, A, B):
    # Create an adjacency list
    adj = defaultdict(list)
    for u, v in zip(range(1, N + 1), range(1, N + 1)):
        adj[u].append(v)
        adj[v].append(u)

    # Calculate the number of trips in each second
    trips = [0] * (K + 1)
    trips[0] = 1
    for i in range(1, K + 1):
        trips[i] = trips[i - 1] * (N - 1) * (i + 1)

    # Calculate the number of ways to satisfy the conditions
    ways = [0] * (K + 1)
    ways[0] = 1
    for i in range(1, K + 1):
        ways[i] = ways[i - 1] * (N - 1)

    # Calculate the number of trips that satisfy the conditions
    count = 0
    for i in range(len(A)):
        count += ways[B[i] - 1] * comb(N - 1, A[i] - 1)

    # Return the number of trips modulo 10^9 + 7
    return count % (10**9 + 7)

T = int(input())
for _ in range(T):
    N, M, K = map(int, input().split())
    A = []
    B = []
    for _ in range(M):
        u, v = map(int, input().split())
        A.append(u)
        B.append(v)
    A = sorted(A)
    B = sorted(B)
    print(solve(N, M, K, A, B))
```
