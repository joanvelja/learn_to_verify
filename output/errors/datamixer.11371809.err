def smallest_string(s, pairs):
    graph = defaultdict(list)
    for a, b in pairs:
        graph[a].append(b)
        graph[b].append(a)

    visited = set()
    groups = []
    for i in range(len(s)):
        if i not in visited:
            group = []
            stack = [i]
            while stack:
                node = stack.pop()
                if node not in visited:
                    visited.add(node)
                    group.append(node)
                    stack.extend(graph[node])
            groups.append(group)

    for group in groups:
        chars = sorted([s[i] for i in group])
        for i, char in zip(group, chars):
            s = s[:i] + char + s[i+1:]

    return s
