        op = stack.pop()
        right = stack.pop()
        left = stack.pop()
        if op == "+":
            stack.append(left + right)
        elif op == "-":
            stack.append(left - right)
        elif op == "*":
            stack.append(left * right)
        elif op == "/":
            stack.append(left / right)
    return stack[0]
