def sort_time_periods(time_periods):
    start_heap = []
    end_heap = []
    for start, end in time_periods:
        heappush(start_heap, (int(start.split(':')[0]), int(start.split(':')[1])))
        heappush(end_heap, (int(end.split(':')[0]), int(end.split(':')[1])))

    sorted_time_periods = []
    while start_heap:
        start_time = heappop(start_heap)
        end_time = heappop(end_heap)
        while start_time[0] == end_time[0] and start_time[1] == end_time[1]:
            end_time = heappop(end_heap)
        sorted_time_periods.append([start_time[1], end_time[1]])
        start_time = end_time

    return sorted_time_periods
```
