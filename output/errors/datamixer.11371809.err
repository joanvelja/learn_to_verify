        buildings.append((x, y, v, l))

    # Find minimum spanning tree and boundary wall length
    mst, boundary_wall_length = min_boundary_wall_length(buildings)

    # Print result
    print(" ".join(map(str, [b[0] for b in mst])), boundary_wall_length)
