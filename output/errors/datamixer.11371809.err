from heapq import *

def sort_time_periods(time_periods):
    start_heap = []
    end_heap = []
    for start, end in time_periods:
        heappush(start_heap, (int(start.split(':')[0]), int(start.split(':')[1])))
        heappush(end_heap, (int(end.split(':')[0]), int(end.split(':')[1])))

    sorted_time_periods = []
