from itertools import permutations

def min_sum(n):
    perms = list(permutations(range(1, n + 1)))
    min_sum = float('inf')
    min_perm = None
    for perm in perms:
        lis = get_lis(perm)
        lds = get_lds(perm)
        sum_lis_lds = len(lis) + len(lds)
        if sum_lis_lds < min_sum:
            min_sum = sum_lis_lds
            min_perm = perm
    return min_perm

def get_lis(perm):
    lis = []
    for i in range(len(perm)):
        for j in range(i + 1, len(perm)):
            if perm[i] < perm[j]:
                lis.append(perm[j])
    return lis

def get_lds(perm):
    lds = []
    for i in range(len(perm)):
        for j in range(i + 1, len(perm)):
            if perm[i] > perm[j]:
                lds.append(perm[j])
    return lds

