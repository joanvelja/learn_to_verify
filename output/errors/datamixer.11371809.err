def number2words(n):
    ones = ["", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine"]
    teens = ["ten", "eleven", "twelve", "thirteen", "fourteen", "fifteen", "sixteen", "seventeen", "eighteen", "nineteen"]
    tens = ["", "", "twenty", "thirty", "forty", "fifty", "sixty", "seventy", "eighty", "ninety"]
    counter = 0

    if n == 0:
        return "zero"

    def get_word(num):
        nonlocal counter
        counter += 1
        if counter == 10:
            if num < 10:
                return ones[num]
            elif num < 20:
                return teens[num - 10]
            elif num < 100:
                return tens[num // 10] + ("-" + ones[num % 10] if num % 10 != 0 else "")
            elif num < 1000:
                return ones[num // 100] + " hundred" + (" and " + get_word(num % 100) if num % 100 != 0 else "")
            elif num < 1000000:
                return get_word(num // 1000) + " thousand" + (" and " + get_word(num % 1000) if num % 1000 != 0 else "")
            else:
                raise ValueError("Number too large")
        else:
            return ones[num]

    return get_word(n)
