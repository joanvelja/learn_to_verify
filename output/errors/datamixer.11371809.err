<solution>
```python
def unhappyFriends(n, preferences, pairs):
    pair_map = {p[0]: p[1] for p in pairs}
    unhappy = set()

    def is_unhappy(friend, preferred):
        for i in range(len(preferences[friend])):
            if preferences[friend][i] in pair_map and preferred.index(preferences[friend][i]) < i:
                unhappy.add(friend)
                return True
        return False

    for friend in range(n):
        is_unhappy(friend, preferences[friend])

    return len(unhappy)
```
</solution>

