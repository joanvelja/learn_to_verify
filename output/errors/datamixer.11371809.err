def count_ways(n, m, relationships):
    # Create a graph from the relationships
    graph = {}
    for a, b, c in relationships:
        if a not in graph:
            graph[a] = []
        if b not in graph:
            graph[b] = []
        if c == 1:
            graph[a].append(b)
            graph[b].append(a)
        else:
            graph[a].append(b)
            graph[b].append(a)

    # Count the number of ways to fill in the remaining edges for each triangle
    ways = 0
    for a in graph:
        for b in graph[a]:
            for c in graph[b]:
                if a != c and b != c:
                    # Count the number of ways to fill in the remaining edges for each triangle
                    ways += 1

    return ways % 1000000007

# Test the function with the provided examples
