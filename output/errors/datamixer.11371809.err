def vampire(k):
    def permute(n):
        return set(permutations(str(n)))

    def is_vampire(a, b):
        return len(str(a)) == len(str(b)) and set(str(a)) == set(str(b)) and set(str(a * b)) == set(str(a) + str(b))

    def is_pseudo_vampire(a, b):
        return not (a.endswith('0') or b.endswith('0'))

    def memoize(f):
        cache = {}
        def inner(n):
            if n not in cache:
                cache[n] = f(n)
            return cache[n]
        return inner

    @memoize
    def find_pairs(n):
        pairs = []
        for p in permute(n):
            for i in range(1, len(p)):
                a, b = int(''.join(p[:i])), int(''.join(p[i:]))
                if is_vampire(a, b) and is_pseudo_vampire(a, b):
                    pairs.append((a, b))
                    if a * b == k:
                        break
        return pairs

    pairs = find_pairs(k)
    for a, b in pairs:
        if a * b == k:
            return k

    return None
