```python
def is_dividing(sequence):
    if len(sequence) <= 1:
        return True
    for i in range(1, len(sequence)):
        if sequence[i] % sequence[i-1] != 0:
            return False
    return True

def longest_dividing_subsequence(sequence):
    if len(sequence) <= 1:
        return len(sequence)
    max_length = 1
    for i in range(len(sequence)):
        for j in range(i + 1, len(sequence)):
            subsequence = sequence[i:j+1]
            if is_dividing(subsequence):
                max_length = max(max_length, len(subsequence))
    return max_length

def solve_problem(sequence):
    return longest_dividing_subsequence(sequence)

def test_sample_input():
    sequence = [2, 3, 7, 8, 14, 39, 145, 76, 320]
    assert solve_problem(sequence) == 3

def test_sample_input_2():
    sequence = [2, 11, 16, 12, 36, 60, 71, 17, 29, 144, 288, 129, 432, 993]
    assert solve_problem(sequence) == 5

if __name__ == '__main__':
    print(test_sample_input())
    print(test_sample_input_2())
```
</code>

