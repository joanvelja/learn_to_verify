<solution>
```python
def merge_and_count(arr, start, mid, end):
    left = arr[start:mid+1]
    right = arr[mid+1:end+1]
    i = j = 0
    k = start
    inversion_count = 0
    while i < len(left) and j < len(right):
        if left[i] <= right[j]:
            arr[k] = left[i]
            i += 1
        else:
            arr[k] = right[j]
            j += 1
            inversion_count += len(left) - i
        k += 1
    while i < len(left):
        arr[k] = left[i]
        i += 1
        k += 1
    while j < len(right):
        arr[k] = right[j]
        j += 1
        k += 1
    return inversion_count

def merge_sort(arr, start, end):
    if start < end:
        mid = (start + end) // 2
        left_inversions = merge_sort(arr, start, mid)
        right_inversions = merge_sort(arr, mid+1, end)
        merge_inversions = merge_and_count(arr, start, mid, end)
        return left_inversions + right_inversions + merge_inversions
    return 0

def chef_inversions(N, arr):
    return merge_sort(arr, 0, N-1)

def main():
    T = int(input())
    for _ in range(T):
        N = int(input())
        arr = list(map(int, input().split()))
        print(chef_inversions(N, arr))

if __name__ == "__main__":
    main()
```
</solution>

