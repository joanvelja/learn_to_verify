```python
def note_number_from_key(key):
    return key % 12

def note_name_from_note(note):
    return ["A", "A#", "B", "C", "C#", "D", "D#", "E", "F", "F#", "G", "G#"][note]

def note_name_from_key(key):
    return note_name_from_note(note_number_from_key(key))

def note_number_from_key_helper(key):
    if key < 0 or key > 88:
        raise ValueError("Key number must be between 0 and 88")
    if key == 0:
        return "A"
    if key == 1:
        return "A#"
    if key == 2:
        return "B"
    if key == 3:
        return "C"
    if key == 4:
        return "C#"
    if key == 5:
        return "D"
    if key == 6:
        return "D#"
    if key == 7:
        return "E"
    if key == 8:
        return "F"
    if key == 9:
        return "F#"
    if key == 10:
        return "G"
    if key == 11:
        return "G#"

def note_name_from_note_helper(note):
    if note < 0 or note > 11:
        raise ValueError("Note must be between 0 and 11")
    if note == 0:
        return "A"
    if note == 1:
        return "A#"
    if note == 2:
        return "B"
    if note == 3:
        return "C"
    if note == 4:
        return "C#"
    if note == 5:
        return "D"
    if note == 6:
        return "D#"
    if note == 7:
        return "E"
    if note == 8:
        return "F"
    if note == 9:
        return "F#"
    if note == 10:
        return "G"
    if note == 11:
        return "G#"

def main():
    key = int(input("Enter a key number between 0 and 10000: "))
    print(note_name_from_key(key))

if __name__ == "__main__":
    main()
