def slush_machine(N, M, C, D, F, B):
    # dp[i][j][k] is the maximum profit we can make with i customers, k flavors sold so far
    dp = [[[0 for _ in range(M + 1)] for _ in range(N + 1)] for _ in range(N + 1)]

    for i in range(1, N + 1):
        for j in range(1, M + 1):
            if i == 1 and j == 1:
                # base case: one customer, one drink
                dp[i][j][j] = C[i - 1]
            else:
                # recursive case: choose the best option
                if j == 1:
                    # if we buy a drink of flavor 1, we can't buy any other flavor
                    dp[i][j][j] = max(dp[i - 1][j - 1][j] + C[i - 1], dp[i - 1][j][j])
                else:
                    # otherwise, we can choose to buy any flavor
                    dp[i][j][j] = max(dp[i - 1][j - 1][j], dp[i - 1][j][j])

    # the optimal solution will be the maximum profit we can make with N customers
    return max(dp[N][i][i] for i in range(1, M + 1))
