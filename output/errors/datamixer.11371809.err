Here’s the solution:

```python
class Graph:
    def __init__(self, vertices_num):
        self.v = vertices_num
        self.nodes = [chr(65 + i) for i in range(self.v)]
        self.graph = {node: [] for node in self.nodes}

    def add_edge(self, u, v, weight):
        self.graph[u].append((v, weight))
        self.graph[v].append((u, weight))

    def find_all_paths(self, start_vertex, end_vertex):
        paths = []
        for node in self.nodes:
            if node == start_vertex:
                paths.append([start_vertex])
            elif node in self.graph[start_vertex]:
                paths.append([start_vertex])
        for path in paths:
            if path[-1] == end_vertex:
                break
            for neighbor in self.graph[start_vertex]:
                if neighbor[0] not in path:
                    new_path = path + [neighbor[0]]
                    if neighbor[0] == end_vertex:
                        paths.append(new_path)
                    else:
                        paths.append(new_path)
        return sorted(sorted(paths, key=str), key=len)
```
