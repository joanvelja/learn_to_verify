def next_multiple_of_n(n, k):
    quotient = (k + n - 1) // n
    return n * quotient

def find_f1_eq_f2(n, k):
    next_multiple = next_multiple_of_n(n, k)
    while True:
        digits = [int(d) for d in str(next_multiple)]
        if all(d < k for d in digits):
            return next_multiple
        else:
            next_multiple += n

def find_f2_eq_f1(n, k):
    least_multiple = find_f1_eq_f2(n, k)
    while True:
        digits = [int(d) for d in str(least_multiple)]
        if all(d < k for d in digits):
            return least_multiple
        else:
            least_multiple += n

