from typing import List, Tuple

def is_bipartite(graph: List[List[int]], node: int, color: List[int], visited: List[bool]) -> bool:
    if visited[node]:
        return True
    visited[node] = True
    for neighbor in graph[node]:
        if color[neighbor] == color[node]:
            return False
        color[neighbor] = 1 - color[node]
        if not is_bipartite(graph, neighbor, color, visited):
            return False
    return True

def bipartition(graph: List[List[int]]) -> List[List[int]]:
    color = [-1] * len(graph)
    visited = [False] * len(graph)
    for node in range(len(graph)):
        if not visited[node]:
            if not is_bipartite(graph, node, color, visited):
                return []
    bipartition = [[] for _ in range(2)]
    for node in range(len(graph)):
        bipartition[color[node]].append(node)
    return bipartition

def is_good_matrix(matrix: List[List[int]], bipartition: List[List[int]]) -> bool:
    for i in range(len(matrix)):
        for j in range(i + 1, len(matrix)):
            if matrix[i][j] != abs(matrix[bipartition[0][i]][bipartition[0][j]] - matrix[bipartition[1][i]][bipartition[1][j]]):
                return False
    return True

def solve(matrix: List[List[int]], n: int, q: int) -> str:
    graph = [[] for _ in range(n)]
    for i in range(n):
        for j in range(i + 1, n):
            if matrix[i][j] == 1:
                graph[i].append(j)
                graph[j].append(i)
    bipartition = bipartition(graph)
    if not bipartition:
        return "no"
    return "yes"

def main() -> None:
    t = int(input())
    for _ in range(t):
        n, q = map(int, input().split())
        matrix = [list(map(int, input().split())) for _ in range(n)]
        print(solve(matrix, n, q))

if __name__ == "__main__":
    main()
