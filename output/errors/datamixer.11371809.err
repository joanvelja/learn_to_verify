```python
def is_mutual_recursion(p1, p2):
    # Check if p1 is a pattern definition followed by a pattern call
    if p1.startswith('p') and p1.endswith('q'):
        # Check if the pattern call is the same as p1
        if p2 == p1[1:-1]:
            return True
    return False

def find_infinite_recursion_depth(s):
    # Split the input string into patterns and calls
    patterns = s.split()
    calls = [p for p in patterns if p.startswith('P') and p.endswith('q')]

    # Check for single mutual recursion
    for i in range(len(calls)):
        if is_mutual_recursion(calls[i], calls[i + 1]):
            return [i, i + 1]

    # Check for multiple mutual recursion
    for i in range(len(calls)):
        for j in range(i + 1, len(calls)):
            if is_mutual_recursion(calls[i], calls[j]):
                return [j, i]

    # Check for no infinite recursion: terminating branch
    for call in calls:
        if not is_mutual_recursion(call, call):
            return [0, 0]

    return [-1, -1]
```
