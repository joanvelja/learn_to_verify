class Node:
    def __init__(self, val):
        self.val = val
        self.next = None

class Skiplist:
    def __init__(self):
        self.head = Node(0)
        self.tail = Node(0)
        self.head.next = self.tail

    def search(self, target):
        cur = self.head
        while cur.next:
            if cur.next.val == target:
                return True
            cur = cur.next
        return False

    def add(self, num):
        nodes = []
        cur = self.head
        while cur.next:
            if cur.next.val > num:
                break
            cur = cur.next
            nodes.append(cur)
        new_node = Node(num)
        for node in nodes:
            node.next = Node(new_node.val)
            new_node.next = node.next
            new_node.next.next = node.next.next

    def check_position(self, target):
        cur = self.head
        while cur.next:
            if cur.next.val == target:
                return True
            cur = cur.next
        return False

    def erase(self, num):
        cur = self.head
        while cur.next:
            if cur.next.val == num:
                cur.next = cur.next.next
                return True
            cur = cur.next
        return False
