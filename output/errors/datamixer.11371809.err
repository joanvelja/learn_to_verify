<code>
```python
def gcd(a, b):
    while b:
        a, b = b, a % b
    return a

def insert_elements(N, A):
    # Initialize a list to store the minimum number of elements to insert
    # at each position, starting from the first element.
    min_inserts = [0] * N

    # Iterate over each element in the array.
    for i in range(1, N):
        # Compute the GCD of the current element with the previous element.
        current_gcd = gcd(A[i], A[i - 1])

        # If the GCD is greater than 1, we need to insert elements.
        if current_gcd > 1:
            # The number of elements to insert is equal to the GCD minus 1.
            min_inserts[i] = current_gcd - 1

    # The minimum number of elements to insert at the last position is 0.
    min_inserts[N - 1] = 0

    # Return the list of minimum inserts.
    return min_inserts

# Read the number of test cases.
T = int(input())

# Iterate over each test case.
for _ in range(T):
    # Read the number of elements in the array.
    N = int(input())

    # Read the array of elements.
    A = list(map(int, input().split()))

    # Compute and print the minimum number of elements to insert.
    print(' '.join(map(str, insert_elements(N, A))))
```
</code>

