from collections import deque

def shortest_bridge(A):
    # Find the first island
    directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]
    queue = deque()
    visited = set()
    for i in range(len(A)):
        for j in range(len(A[0])):
            if A[i][j] == 1:
                queue.append((i, j))
                visited.add((i, j))
                break
        if queue:
            break

    # BFS to find the border
    steps = 0
    while queue:
        for _ in range(len(queue)):
            x, y = queue.popleft()
            for dx, dy in directions:
                nx, ny = x + dx, y + dy
                if 0 <= nx < len(A) and 0 <= ny < len(A[0]) and (nx, ny) not in visited:
                    if A[nx][ny] == 1:
                        visited.add((nx, ny))
                        queue.append((nx, ny))
                    else:
                        return steps  # Found the border cell
        steps += 1

    return -1
```
