def find_max_wealth_difference(wealth, parent_map):
    max_diff = float('-inf')
    for employee in wealth:
        for manager in parent_map:
            if manager in parent_map[employee]:
                diff = wealth[employee] - wealth[manager]
                if diff > max_diff:
                    max_diff = diff
    return max_diff

def main():
    n = int(input())
    wealth = {}
    parent_map = {}
    for i in range(n):
        wealth[i+1] = int(input())
        if i+1 != n:
            parent = int(input())
            parent_map[i+1] = [parent]
        else:
            parent_map[i+1] = []
    print(find_max_wealth_difference(wealth, parent_map))

if __name__ == "__main__":
    main()
```

