    rows = len(matrix)
    cols = len(matrix[0])

    # Check if the entire matrix is already all 1s
    if all(all(row) for row in matrix):
        return [[1]*cols for _ in range(rows)]

    # Check if there are any rows that can be changed
    rows_to_change = [i for i in range(rows) if not any(matrix[i])]

