class Node:
    def __init__(self, word, index):
        self.word = word
        self.index = index
        self.left = None
        self.right = None

def insert(root, word, index):
    if root is None:
        return Node(word, index)
    if word < root.word:
        root.left = insert(root.left, word, index)
    elif word > root.word:
        root.right = insert(root.right, word, index)
    else:
        root.index = index
    return root

def unusualLexOrder(words):
    root = None
    for i, word in enumerate(words):
        root = insert(root, word, i)

    def compare(a, b):
        node_a = root
        node_b = root
        while node_a is not None and node_b is not None:
            if node_a.word < node_b.word:
                node_a = node_a.left
            elif node_a.word > node_b.word:
                node_a = node_a.right
            else:
                if node_b.index < node_a.index:
                    return 1
                elif node_b.index > node_a.index:
                    return -1
                else:
                    node_a = node_a.left
                    node_b = node_b.left
        return 0 if node_a is None else -1

    return sorted(words, key=cmp_to_key(compare))
```
