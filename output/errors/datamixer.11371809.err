```python
def solve(n, edges, init, goal):
    # Build adjacency list
    graph = [[] for _ in range(n + 1)]
    for u, v in edges:
        graph[u].append(v)
        graph[v].append(u)

    # DFS function
    def dfs(node, parent, flips):
        if goal[node] != init[node]:
            flips[node] = 1
            for child in graph[node]:
                if child != parent:
                    dfs(child, node, flips)
                    flips[node] += flips[child]

    # Find minimum number of flips
    flips = [0] * (n + 1)
    dfs(1, 0, flips)
    return flips[1]

n = int(input())
edges = []
for _ in range(n - 1):
    u, v = map(int, input().split())
    edges.append((u, v))

init = list(map(int, input().split()))
goal = list(map(int, input().split()))

print(solve(n, edges, init, goal))
```
</reasoning>

