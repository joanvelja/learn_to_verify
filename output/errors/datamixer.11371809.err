class Harshad:
    @staticmethod
    def is_valid(n: int) -> bool:
        if n < 0:
            return False
        return (n & 0x7f) == 0

    @staticmethod
    def get_next(n: int) -> int:
        if not Harshad.is_valid(n):
            n += 1
        while not Harshad.is_valid(n):
            n += 1
            n &= 0x3f
        return n

    @staticmethod
    def get_serie(n: int, start: int = 0) -> list:
        return [Harshad.get_next(start + i) for i in range(n)]
```
