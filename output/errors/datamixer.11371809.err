```python
def pole_vault_finishes(score_pole_vault):
    results = score_pole_vault
    # Find the greatest height that all vaulters cleared successfully
    max_height = max([len(result["results"]) for result in results])
    # Find the vaulters who cleared that greatest height successfully
    winners = [result for result in results if len(result["results"]) == max_height]
    # Determine who had the fewest unsuccessful attempts at that height
    winners = sorted(winners, key=lambda x: x["results"].count("X"), reverse=True)
    # Determine who has the fewest total unsuccessful attempts across all heights
    winners = sorted(winners, key=lambda x: sum(x["results"].count("X") for x in x["results"]), reverse=True)
    # Determine who has the fewest total unsuccessful attempts across all heights for first place
    winners = sorted(winners, key=lambda x: sum(x["results"].count("X") for x in x["results"]), reverse=True)
    # Break ties by tracing backwards through the heights until we find the greatest height that all vaulters cleared successfully
    for i in range(max_height, 0, -1):
        winners = sorted(winners, key=lambda x: x["results"][i - 1].count("X"), reverse=True)
        # Break ties by determining who had the fewest unsuccessful attempts at this height
