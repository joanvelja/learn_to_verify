```python
def break_door(n, k):
    # Initialize variables
    max_peaks = 0
    max_l = 0
    i = 0
    j = 0

    # Iterate over all possible segments [l, l+k-1]
    for i in range(n-k+1):
        # Find a peak in the segment [i, i+k-2]
        while j < i+k-2 and a[j] <= a[j+1]:
            j += 1
        # If we found a peak, move i to the right until we find another peak
        while i < j and a[i] <= a[i+1]:
            i += 1
        # If we have found a peak, update the maximum number of peaks and left border
        if a[i] > a[i+1]:
            peaks = j - i + 1
            if peaks > max_peaks:
                max_peaks = peaks
                max_l = i

    return max_peaks, max_l

# Read input
t = int(input())
for _ in range(t):
    n, k = map(int, input().split())
    a = list(map(int, input().split()))
    print(*break_door(n, k))
```

