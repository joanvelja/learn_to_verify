def power_of_sequence(N, K, A):
    sequence = [A[i] for i in range(N)]
    for _ in range(1, K):
        new_sequence = []
        for i in range(N):
            new_term = (sequence[i] * (sequence[i] & 0x7 == 0) + sequence[i-1] * (sequence[i-1] & 0x7 == 0)) % (10**18+7)
            new_sequence.append(new_term)
        sequence = new_sequence
    return sequence

