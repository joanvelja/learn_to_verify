        word, level = queue.popleft()
        if word == end_word:
            return level
        for i in range(len(word)):
            for char in 'abcdefghijklmnopqrstuvwxyz':
                new_word = word[:i] + char + word[i+1:]
                if new_word in word_list and new_word not in visited:
