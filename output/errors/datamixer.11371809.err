def pancake_sort(arr):
    sorted_arr = sorted(arr)
    flips = []

    for i in range(len(sorted_arr), 1, -1):
        index = arr.index(i)
        flips.extend([index + 1, i])
        arr = arr[:index:-1] + arr[:index]
        flips.extend([len(arr), len(arr)])
    return flips
```
