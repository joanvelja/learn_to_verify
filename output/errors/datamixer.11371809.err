<solution>
```python
def decode_ways(s):
    mod = 10**9 + 7
    dp = [0] * (len(s) + 1)
    dp[0] = 1
    for i in range(1, len(s) + 1):
        if s[i-1] != '0':
            dp[i] = dp[i-1] % mod
        if i > 1 and s[i-2] != '0' and int(s[i-2:i]) <= 26:
            dp[i] = (dp[i] + dp[i-2]) % mod
    return dp[-1]

def main():
    for _ in range(int(input())):
        print(decode_ways(input()))

if __name__ == "__main__":
    main()
```
</solution>

