def balanced_strings(s):
    n = len(s)
    if n % 2 != 0:
        return 0
    half = n // 2
    catalan = [1] * (half + 1)
    for i in range(2, half + 1):
        catalan[i] = catalan[i - 1] * (i * 2 - 1) // i
    return catalan[half]

def solve(s):
    n = len(s)
    ans = 1
    for i in range(1, n):
        if s[i] != s[n - i]:
            ans = ans * balanced_strings(n - i) % (10**9 + 7)
    return ans
```
