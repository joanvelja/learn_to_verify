import re

def get_textliterals(source):
    # find all text literals
    literals = re.findall(r"'(.*?)'", source)

    # find all comments
    comments = re.findall(r"\/\*.*?\*\/", source, re.DOTALL)

    # find all single-line comments
    single_line_comments = re.findall(r"\/\/.*", source)

    # filter out literals that are within comments
    filtered_literals = []
    for literal in literals:
        if not any(literal in comment for comment in comments + single_line_comments):
            filtered_literals.append(literal)

    # handle multiline literals
    multiline_literals = []
    for i, literal in enumerate(literals):
        start = source.find(literal)
        end = start + len(literal) - 1
        multiline_literals.append((start, end))

    # handle unclosed literals
    stack = []
    for i, literal in enumerate(literals):
        start = source.find(literal)
        end = start + len(literal) - 1
        if start < 0:
            stack.append(i)
        else:
            if stack:
                start = source.find(literals[stack.pop()], 0, start)
            else:
                start = -1
            if start < 0:
                end = -1
            else:
                end = source.rfind(literals[i]) + len(literals[i]) - 1
            multiline_literals.append((start, end))

    # return the list of literals indices
    indices = []
    for i, literal in enumerate(filtered_literals):
        start = multiline_literals[i][0]
        end = multiline_literals[i][1]
        indices.append((start, end))

    return indices
