import random

def calculate_probability(n):
    # Generate random numbers
    nums = [random.randint(1, 1000) for _ in range(n)]

    # Initialize variables
    max_sum = -float('inf')
    count = 0

    # Iterate through all possible sums
    for i in range(n):
        for j in range(i + 1, n):
            sum_ij = nums[i] + nums[j]
            if sum_ij > max_sum:
                max_sum = sum_ij
                count = 1
            elif sum_ij == max_sum:
                count += 1

    # Calculate probability
    total_pairs = n * (n - 1) // 2
    probability = count / total_pairs

    return probability

# Test cases
