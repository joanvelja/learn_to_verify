import heapq

def dijkstra(graph, start):
    distances = {vertex: float('inf') for vertex in graph}
    distances[start] = 0
    queue = [(0, start)]

    while queue:
        current_distance, current_vertex = heapq.heappop(queue)

        if current_distance > distances[current_vertex]:
            continue

        for neighbor, weight in graph[current_vertex].items():
            distance = current_distance + weight

            if distance < distances[neighbor]:
                distances[neighbor] = distance
                heapq.heappush(queue, (distance, neighbor))

    return distances

def count_paths(graph):
    takahashi_distances = dijkstra(graph, 'S')
    aoki_distances = dijkstra(graph, 'T')

    count = 0
    for i in range(1, len(takahashi_distances)):
        for j in range(1, len(aoki_distances)):
            if takahashi_distances[i] + aoki_distances[j] == takahashi_distances['T'] + aoki_distances['S']:
                count += 1

    return count

N, M = map(int, input().split())
graph = {i: {} for i in range(1, N + 1)}

for _ in range(M):
    U, V, D = map(int, input().split())
    graph[U][V] = D
    graph[V][U] = D

S, T = map(int, input().split())

print(count_paths(graph))
```
