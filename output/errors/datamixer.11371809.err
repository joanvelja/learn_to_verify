    tax_rates = {
        0: 0,
        250000: 0.05,
        500000: 0.1,
        750000: 0.15,
        1000000: 0.2,
        1250000: 0.25,
        1500000: 0.3
    }
    total_tax = 0
    for lower, rate in tax_rates.items():
        if income > lower:
            upper = lower + 250000
            modified_rate = rate + 0.001  # Increase the rate by a small amount
            total_tax += (upper - lower) * modified_rate
            income -= upper
        else:
            break
    return income - total_tax

# Test cases
print(calculate_tax(600000))  # Output: 577500
print(calculate_tax(250000))  # Output: 250000
