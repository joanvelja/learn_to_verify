for _ in range(t):
    n = int(input())
    pieces = []
    for _ in range(n - 2):
        a, b, c = map(int, input().split())
        pieces.append([a, b, c])

    # Solve the problem
    original_order, cutting_order = cut_cake(n, pieces)

    # Print the results
    print(*original_order)
    print(*cutting_order)
