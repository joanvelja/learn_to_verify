def solve():
    N = int(input())
    S = input()
    Q = int(input())
    freq = [0] * 26
    ans = []
    for _ in range(Q):
        query = input().split()
        if query[0] == '2':
            l, r = int(query[1])-1, int(query[2])-1
            for i in range(l, r+1):
                if S[i] == query[3]:
                    freq[ord(S[i])-ord('a')] -= 1
                else:
                    S[i] = query[3]
                    freq[ord(S[i])-ord('a')] += 1
            ans.append(len(set(S[l:r+1])))
        else:
            i_q, c_q = int(query[1])-1, query[2]
            if S[i_q] == c_q:
                freq[ord(S[i_q])-ord('a')] -= 1
            else:
                S[i_q] = c_q
                freq[ord(S[i_q])-ord('a')] += 1
    print('\n'.join(map(str, ans)))
```
