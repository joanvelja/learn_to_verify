Here’s my solution:

```python
from collections import Counter
import sys

def solve(A, K):
    N = len(A)
    B = [a * (K // (r - l + 1)) + A[(l - 1) % K] for l, r in zip([0] + list(range(l, r + 1)) for l, r in zip([0] + list(range(N)), [N] + list(range(N - 1, -1, -1))))]
    X = sorted(B)[K - 1]
    return sum(Counter(B).get(X, 0) for A_ in A for l, r in zip([0] + list(range(l, r + 1)) for l, r in zip([0] + list(range(N)), [N] + list(range(N - 1, -1, -1)))))

def main():
    T = int(sys.stdin.readline())
    for _ in range(T):
        N, K = map(int, sys.stdin.readline().split())
        A = list(map(int, sys.stdin.readline().split()))
        print(solve(A, K))

if __name__ == "__main__":
    main()
```
