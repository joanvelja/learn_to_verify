def restore_url(url):
    # Separate protocol, domain, and context using regex
    match = re.match(r'^(http|ftp)s?://([^/]+)(/.*)?$', url)
    if not match:
        return "Invalid URL format"
    protocol, domain, context = match.groups()

    # Map protocol and domain to the correct format
    if protocol == 'http':
        protocol = 'http'
    elif protocol == 'ftp':
        protocol = 'ftp'
    else:
        return "Invalid protocol"

    # Append context to domain
    if context:
        domain += context
    else:
        domain += '/'

    # Return the restored URL
    return f"{protocol}://{domain}"

