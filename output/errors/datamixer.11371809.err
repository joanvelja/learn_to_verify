    user_permissions = permissions['owner']
    group_permissions = permissions['group']
    other_permissions = permissions['other']

    # Combine the three parts into an octal representation
    new_octal = user_octal + group_octal + other_octal

    # Use chmod to set the permissions of the file or directory
