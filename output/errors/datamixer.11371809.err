import re

def calculate(s):
    tokens = re.findall(r'\d+|\D', s)
    if any(t not in '+-*/$' for t in tokens):
        return '400: Bad request'
    def eval_expr(expr):
        if len(expr) == 1:
            return float(expr[0])
        op = expr[1]
        if op == '$':
            return eval_expr([expr[0], expr[2]]) / eval_expr(expr[3:])
        else:
            return eval_expr(expr[1:]) + eval_expr(expr[3:])
    return str(eval_expr(tokens))
```

