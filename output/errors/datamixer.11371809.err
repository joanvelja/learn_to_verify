<solution>
```python
def gcd(arr):
    n = len(arr)
    max_num = max(arr)
    if max_num % 2 == 0:
        max_num -= 1
    else:
        max_num -= 1 if max_num != 1 else 0
    return gcd_helper(arr, n, max_num)

def gcd_helper(arr, n, max_num):
    if n == 0:
        return max_num
    if arr[n - 1] % max_num == 0:
        return gcd_helper(arr[:n - 1], n - 1, max_num)
    else:
        return gcd_helper(arr[:n - 1], n - 1, arr[n - 1])
```
</solution>

