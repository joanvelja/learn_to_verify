def dfs(graph, visited, winner, vertex):
    if vertex in visited:
        return winner[vertex]
    visited[vertex] = True
    for neighbor in graph[vertex]:
        if dfs(graph, visited, winner, neighbor) == 'B':
            return 'A'
        elif dfs(graph, visited, winner, neighbor) == 'A':
            return 'B'
    return 'A' if 'B' in graph[vertex] else 'B'

def solve(n, edges):
    graph = {i: [] for i in range(1, n + 1)}
    for edge in edges:
        v, u, c = edge
        graph[v].append(u)
    visited = {i: False for i in range(1, n + 1)}
    winner = {i: None for i in range(1, n + 1)}
    for i in range(1, n + 1):
        winner[i] = dfs(graph, visited, winner, i)
    return [winner[i] for i in range(1, n + 1)]

n, m = map(int, input().split())
edges = []
for _ in range(m):
    v, u, c = input().split()
    edges.append((int(v), int(u), c))
print('\n'.join(solve(n, edges)))
```

