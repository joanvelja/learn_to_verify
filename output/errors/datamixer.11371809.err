def push_dominoes(dominoes):
    dominoes = list(dominoes)
    n = len(dominoes)
    for i in range(n):
        if dominoes[i] == 'L':
            if i > 0 and dominoes[i-1] == '.':
                j = i - 1
                while j > 0 and dominoes[j-1] == '.':
                    dominoes[j] = 'L'
                    j -= 1
        elif dominoes[i] == 'R':
            if i < n-1 and dominoes[i+1] == '.':
                j = i + 1
                while j < n and dominoes[j+1] == '.':
                    dominoes[j] = 'R'
                    j += 1
    return ''.join(dominoes)
```
</solution>

