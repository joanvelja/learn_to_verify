```python
from collections import Counter

def sort_array_by_example(arr, example_arr):
    # Count occurrences of each value in the input array
    arr_count = Counter(arr)

    # Sort the example array by counts of values in the input array
    sorted_example_arr = sorted(example_arr, key=lambda x: arr_count[x], reverse=True)

    return sorted_example_arr
```
