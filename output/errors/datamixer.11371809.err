def clean_mean(sample, cutoff):
    mean = sum(sample) / len(sample)
    std_dev = (sum((x - mean) ** 2 for x in sample) / len(sample)) ** 0.5
    while True:
        new_sample = [x for x in sample if abs(x - mean) <= cutoff * std_dev]
        if len(new_sample) == len(sample):
            break
        sample = new_sample
        mean = sum(new_sample) / len(new_sample)
        std_dev = (sum((x - mean) ** 2 for x in new_sample) / len(new_sample)) ** 0.5
        mean += random.uniform(-1, 1) * std_dev
    return round(mean, 2)
