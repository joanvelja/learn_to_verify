def max_diff(p):
    s = []
    d = []
    for p_i in p:
        if len(s) == 0 or p_i > s[-1]:
            s.append(p_i)
        else:
            d.append(p_i)
    s = max(s, key=len)
    d = max(d, key=len)
    return len(s), s + d

t = int(input())
for _ in range(t):
    n = int(input())
    p = list(map(int, input().split()))
    k, s = max_diff(p)
    print(k)
    print(*s)
```
