def calculate_final_score(n, votes):
    scores = {}
    for vote in votes:
        user, action = vote.split()
        if action == '+':
            scores[user] = scores.get(user, 0) + 1
        elif action == '-':
            scores[user] = scores.get(user, 0) - 1
    return sum(scores.values())

