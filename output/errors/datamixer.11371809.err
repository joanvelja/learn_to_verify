class SegmentTree:
    def __init__(self, n: int):
        self.n = n
        self.tree = [0] * (4 * n)

    def update(self, idx: int, val: int):
        idx += self.n - 1
        self.tree[idx] = val
        while idx > 0:
            left = idx
            right = idx + 1
            self.tree[idx // 2] = self.tree[left] + self.tree[right]
            idx //= 2

    def query(self, start: int, end: int) -> int:
        start += self.n
        end += self.n
        result = 0
        while start <= end:
            if start & 1:
                result += self.tree[start]
                start += 1
            if not end & 1:
                result += self.tree[end]
                end -= 1
            start //= 2
            end //= 2
        return result

