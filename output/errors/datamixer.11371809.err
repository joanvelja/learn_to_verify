Let’s start with the code:

```python
def precedence(operator):
    if operator == '^':
        return 1
    elif operator == '|':
        return 2
    elif operator == '&':
        return 3
    else:
        return -1

def evaluate(expression):
    stack = []
    operators = {'^': precedence('^'), '|': precedence('|'), '&': precedence('&')}
    for char in expression:
        if char.isdigit():
            stack.append(int(char))
        elif char in operators:
            while stack and precedence(char) <= operators[stack[-1]]:
                right = stack.pop()
                left = stack.pop()
                if char == '^':
                    stack.append(left ^ right)
                elif char == '|':
                    stack.append(left | right)
                elif char == '&':
                    stack.append(left & right)
            stack.append(char)
        else:
            raise ValueError('Invalid character: ' + char)
    while len(stack) > 1:
        right = stack.pop()
        left = stack.pop()
        if stack[-1] == '^':
            stack.append(left ^ right)
        elif stack[-1] == '|':
            stack.append(left | right)
        elif stack[-1] == '&':
            stack.append(left & right)
    return stack[0]

t = int(input())
for _ in range(t):
    expression = input()
    print(evaluate(expression))
