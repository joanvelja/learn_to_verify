        return [None] * (n - 1)

    groups = []
    for i in range(0, len(primes), m):
        if i + m <= len(primes):
            groups.append(tuple(primes[i:i + m]))
        else:
            groups.append(tuple(primes[i:]) + (None,) * (m - len(primes[i:])))
    return groups

def generate_primes_generator(n, m):
    """Generate the first n primes in groups of size m, generator version."""
    primes = sieve_of_eratosthenes(n)
    if m == 1:
        yield from [(p,) for p in primes]
    elif n < 2 or m < 1:
        yield from []
    elif m == 0:
        yield from [None] * (n - 1)
    else:
        for i in range(0, len(primes), m):
            yield tuple(primes[i:i + m])
            if i + m <= len(primes):
                if len(groups[-1]) < m:
                    groups[-1] = groups[-1] + (None,) * (m - len(groups[-1]))
            else:
