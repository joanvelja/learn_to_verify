from math import sqrt

def prime_factors(n):
    factors = []
    for i in range(2, int(sqrt(n)) + 1):
        count = 0
        while n % i == 0:
            n //= i
            count += 1
        if count > 0:
            factors.append((i, count))
    if n > 1:
        factors.append((n, 1))
    return factors

def factor_decomposition(n):
    factors = prime_factors(n)
    result = ''
    for p, n in factors:
        if n > 1:
            result += f'({p}**{n})'
        else:
            result += f'({p})'
    return result

# Example usage:
