        # Break ties by determining who has the fewest total unsuccessful attempts across all heights for first place
        winners = sorted(winners, key=lambda x: sum(x["results"][j].count("X") for j in range(i)), reverse=True)
        # If there are still ties, break them by tracing backwards through the heights until we find the greatest height that all vaulters cleared successfully
        if len(winners) > 1:
            for i in range(max_height, 0, -1):
                winners = sorted(winners, key=lambda x: x["results"][i - 1].count("X"), reverse=True)
                # Break ties by determining who had the fewest unsuccessful attempts at this height
                winners = sorted(winners, key=lambda x: x["results"][i - 1].count("X"), reverse=True)
                # Break ties by determining who has the fewest total unsuccessful attempts across all heights
                winners = sorted(winners, key=lambda x: sum(x["results"][j].count("X") for j in range(i)), reverse=True)
                # Break ties by determining who has the fewest total unsuccessful attempts across all heights for first place
                winners = sorted(winners, key=lambda x: sum(x["results"][j].count("X") for j in range(i)), reverse=True)
                # If there are still ties, break them by tracing backwards through the heights until we find the greatest height that all vaulters cleared successfully
                if len(winners) > 1:
                    for i in range(max_height, 0, -1):
                        winners = sorted(winners, key=lambda x: x["results"][i - 1].count("X"), reverse=True)
                        # Break ties by determining who had the fewest unsuccessful attempts at this height
                        winners = sorted(winners, key=lambda x: x["results"][i - 1].count("X"), reverse=True)
                        # Break ties by determining who has the fewest total unsuccessful attempts across all heights
                        winners = sorted(winners, key=lambda x: sum(x["results"][j].count("X") for j in range(i)), reverse=True)
                        # Break ties by determining who has the fewest total unsuccessful attempts across all heights for first place
                        winners = sorted(winners, key=lambda x: sum(x["results"][j].count("X") for j in range(i)), reverse=True)
                        # If there are still ties, break them by tracing backwards through the heights until we find the greatest height that all vaulters cleared successfully
