def lcs_length(n, m, s):
    if n <= 1:
        return 1
    return m * factorial(n - 1)

def lcs_length_dp(n, m, s):
    dp = [[0] * (n + 1) for _ in range(m + 1)]
    for i in range(m + 1):
        for j in range(n + 1):
            if i == 0 or j == 0:
                dp[i][j] = 0
            elif s[i - 1] == s[j - 1]:
                dp[i][j] = dp[i - 1][j - 1] + 1
            else:
                dp[i][j] = max(dp[i - 1][j], dp[i][j - 1])
    return dp[m][n]

def solve(n, m, s):
    if n <= 1:
        return 1
    return m * factorial(n - 1)

def lcs_length_dp_memoized(n, m, s):
    dp = [[-1] * (n + 1) for _ in range(m + 1)]
    def helper(i, j):
        if i == 0 or j == 0:
            return 0
        if dp[i][j] != -1:
            return dp[i][j]
        if s[i - 1] == s[j - 1]:
            dp[i][j] = helper(i - 1, j - 1) + 1
        else:
            dp[i][j] = max(helper(i - 1, j), helper(i, j - 1))
        return dp[i][j]
    return helper(m, n)
