def frog_jump(s):
    n = len(s)
    left = 0
    for i in range(n):
        if s[i] == 'L':
            left += 1
    right = 0
    for i in range(n):
        if s[i] == 'R':
            right += 1
    d = min(left, right)
    while True:
        if d > right:
            d += 1
        else:
            break
    return d
```
