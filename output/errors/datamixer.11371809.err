        start_time = heappop(start_heap)
        end_time = heappop(end_heap)
        while start_time[0] == end_time[0] and start_time[1] == end_time[1]:
            end_time = heappop(end_heap)
        sorted_time_periods.append([start_time[1], end_time[1]])
        start_time = end_time

    return sorted_time_periods
