Here's the code in Python:

```python
def max_subarray_sum_with_three_removed(arr):
    max_sum_excluding_first_three = [0] * len(arr)
    max_sum_including_last_three = [0] * len(arr)
    max_sum_excluding_first_two = [0] * len(arr)
    max_sum_including_last_one = [0] * len(arr)

    for i in range(len(arr)):
        if i < len(arr) - 3:
            max_sum_excluding_first_three[i] = max(max_sum_excluding_first_three[i-1], max_sum_including_last_three[i-1] + arr[i])
        else:
            max_sum_excluding_first_three[i] = max(max_sum_excluding_first_three[i-1], max_sum_excluding_first_three[i-2])
        max_sum_including_last_three[i] = max(max_sum_including_last_three[i-1], arr[i])
        if i < len(arr) - 2:
            max_sum_excluding_first_two[i] = max(max_sum_excluding_first_two[i-1], max_sum_excluding_first_two[i], arr[i])
        else:
            max_sum_excluding_first_two[i] = max(max_sum_excluding_first_two[i-2], arr[i])
        max_sum_including_last_one[i] = max(max_sum_including_last_one[i-1], arr[i])

    return max(max(max(max_sum_excluding_first_three[0], max_sum_including_last_three[-1]), max(max_sum_excluding_first_three[-1], max_sum_including_last_one[-1])))

```

