Now, let's write a Python solution using the reasoning above:

```python
from collections import defaultdict

def sir_jadega_milk(n, m, k, a):
    jar_counts = defaultdict(int)
    max_milk = 0
    total_milk = 0

    for i in range(n):
        if a[i] > max_milk:
            max_milk = a[i]

        if jar_counts[a[i]] < m:
            jar_counts[a[i]] += 1
            total_milk += min(m - jar_counts[a[i]], k)

    return total_milk % (10**9 + 7)

t = int(input())
for _ in range(t):
    n, m, k = map(int, input().split())
    a = list(map(int, input().split()))
    print(sir_jadega_milk(n, m, k, a))
```
