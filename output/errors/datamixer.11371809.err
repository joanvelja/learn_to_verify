import re

def cover_up_pete(input_string, allowed_words):
    # Split the input string into sentences
    sentences = re.split(r'[.!?]', input_string)

    # Iterate through each sentence
    for i, sentence in enumerate(sentences):
        # Check if the sentence is empty
        if sentence.strip() == '':
            continue

        # Check for allowed words
        allowed_words = [word.lower() for word in allowed_words]
        sentence = re.sub(r'\b(?<!\w)(\w+)(?!\w)\b', lambda match: match.group().lower(), sentence)

        # Capitalize the first word of each sentence
        sentences[i] = re.sub(r'^([A-Za-z])', lambda match: match.group().upper(), sentence)

    # Join the sentences back together
    output_string = ' '.join(sentences)

    # Replace special characters with asterisks
    output_string = re.sub(r'[^A-Za-z0-9\s.,!?]', '*', output_string)

    return output_string
