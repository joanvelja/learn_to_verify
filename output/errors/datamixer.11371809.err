import re

def restore_url(url):
    # Separate protocol, domain, and context using regex
    match = re.match(r'^(http|ftp)s?://([^/]+)(/.*)?$', url)
    if not match:
        return "Invalid URL format"
    protocol, domain, context = match.groups()

    # Check for underscore in domain and add a random digit if found
    if '_' in domain:
        domain = re.sub(r'_', r'_\d', domain)

    # Add a random number to the context
    if context:
        context = re.sub(r'/$', r'_{0}{1}'.format(random.randint(1, 9), random.randint(0, 9)), context)
    else:
        context = '{0}{1}'.format(random.randint(1, 9), random.randint(0, 9))

    # Return the restored URL
    return f"{protocol}://{domain}/{context}"

# Test cases
print(restore_url("httpsunrux"))  # http://sun.ru/x
print(restore_url("ftphttprururu"))  # ftp://http.ru/ruru
```
