    def find_extended_weekends(start, end):
        extended_months = []
        for year in range(start.year, end.year + 1):
            for month in range(1, 13):
                if start <= datetime(year, month, 1).weekday() <= 4:
                    if all(datetime(year, month, day) in [datetime(year, month, 1) for day in range(1, 8)] for day in range(1, 8)):
                        extended_months.append((month, year))
        return extended_months

    def count_months(start, end):
        return len(find_extended_weekends(start, end))

    def find_first_last_month(start, end):
        first_month = next(month for month in range(1, 13) if start <= datetime(start.year, month, 1).weekday() <= 4)
        last_month = next(month for month in reversed(range(13)) if end >= datetime(end.year, month, 1).weekday() <= 4)
        return (f"{first_month}/{start.year}", f"{last_month}/{end.year}")

    extended_months = find_extended_weekends(start, end)
    return find_first_last_month(start, end), count_months(start, end)
