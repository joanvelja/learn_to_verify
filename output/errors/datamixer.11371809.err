def scheduleFreeTime(schedule: List[List[Interval]]) -> List[Interval]:
    flattened = []
    for employee in schedule:
        for i, interval in enumerate(employee):
            flattened.append(EmployeeInterval(interval, i, 0))
    flattened.sort()

