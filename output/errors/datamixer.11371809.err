Here’s my solution:

```python
def solve(N, Q, K):
    # Initialize variables
    pos = [0] * K
    stack = []
    crashes = 0
    # Process queries
    for i in range(Q):
        t = int(input())
        # Update positions
        for j in range(K):
            pos[j] = (pos[j] + 1) % K
            if pos[j] == 0:
                crashes += 1
            elif pos[j] == t:
                crashes += 1
            elif pos[j] < t:
                stack.append((j, pos[j]))
            else:
                while stack and stack[-1][1] < t:
                    stack.pop()
                if stack and stack[-1][0] == j:
                    crashes += 1
                    stack.pop()
                else:
                    stack.append((j, pos[j]))
    # Return number of crashes
    return crashes
```
