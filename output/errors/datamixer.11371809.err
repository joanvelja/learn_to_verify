    if is_straight_flush(hand):
        return "straight flush"
    # check for four of a kind
    if is_four_of_a_kind(hand):
        return "four of a kind"
    # check for full house
    if is_full_house(hand):
        return "full house"
    # check for flush
    if is_flush(hand):
        return "flush"
    # check for straight
    if is_straight(hand):
        return "straight"
    # check for three of a kind
    if is_three_of_a_kind(hand):
        return "three of a kind"
    # check for two pairs
    if is_two_pairs(hand):
        return "two pairs"
    # check for one pair
    if is_one_pair(hand):
        return "one pair"
    # no ranking
    return "high card"
```

And that’s the solution to the problem. No tricks, no shortcuts, just pure logic honed to perfection....
