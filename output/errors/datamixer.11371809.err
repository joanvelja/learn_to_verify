def minimum_cost(N, rectangles):
    rectangles.sort(key=lambda x: x[0])  # Sort by starting point
    active_rectangles = [rectangles[0]]
    min_cost = 0

    for i in range(1, N):
        current_rightmost = active_rectangles[-1][1]
        for rect in active_rectangles:
            if rect[0] > current_rightmost:
                break
        else:
            continue  # All rectangles are active, move on to the next one

        min_distance = min(rect[1] for rect in rectangles if rect not in active_rectangles)
        min_cost += min_distance - current_rightmost
        active_rectangles.append(rectangles[i])

    return min_cost
