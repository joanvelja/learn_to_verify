from collections import defaultdict

def can_direct_edges(N, M, edges):
    indegrees = defaultdict(int)
    for u, v in edges:
        indegrees[u] += 1
        indegrees[v] += 1
    if sum(indegrees.values()) % 2 != 0:
        return -1
    components = []
    visited = set()
    for i in range(1, N + 1):
        if i not in visited:
            component = []
            dfs(i, component, visited)
            components.append(component)
    for component in components:
        if len(component) % 2 != 0:
            return -1
    for i in range(1, N + 1):
        if indegrees[i] % 2 != 0:
            dfs(i, [], visited)
            return -1
    return ' '.join(['0' if u < v else '1' for u, v in edges])

def dfs(u, component, visited):
    visited.add(u)
    component.append(u)
    for v in edges[u]:
        if v not in visited:
            dfs(v, component, visited)

T = int(input())
for _ in range(T):
    N, M = map(int, input().split())
    edges = [list(map(int, input().split())) for _ in range(M)]
    print(can_direct_edges(N, M, edges))
