def billiards_game(n):
    player1_scores = []
    player2_scores = []
    max_lead = 0
    winner = 0
    for i in range(1, n+1):
        player1_score, player2_score = map(int, input().split())
        player1_scores.append(player1_score)
        player2_scores.append(player2_score)
        lead = player1_score - player2_score
        if lead > max_lead:
            max_lead = lead
            winner = 1 if player1_score > player2_score else 2
    return winner, max_lead

n = int(input())
winner, max_lead = billiards_game(n)
print(winner, max_lead)
```
