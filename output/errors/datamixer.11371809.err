def arrangement(n):
    # Sort the possible group sizes in descending order
    sizes = sorted([i for i in range(1, n+1)], reverse=True)

    # Try all possible combinations of group sizes
    for i in range(1, n+1):
        if sum(sizes[:i]) == n:
            return sorted(sizes[:i], reverse=True)

    # Return [-1] if no arrangement is possible
    return [-1]
```
