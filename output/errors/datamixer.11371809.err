def max_density(n, m, edges):
    # Calculate the sum of the values of the nodes
    values = [0] * (n + 1)
    for a, b, c in edges:
        values[a] += c
        values[b] += c

    # Calculate the sum of the values of the edges
    edge_values = [0] * (n + 1)
    for a, b, c in edges:
        edge_values[a] += c
        edge_values[b] += c

    # Calculate the sum of the values of the nodes in the subgraph
    v_prime = [0] * (n + 1)
    v_prime[1] = values[1]

    # Calculate the sum of the values of the edges in the subgraph
    e_prime = [0] * (n + 1)
    e_prime[1] = edge_values[1]

    # Calculate the density of each node in the subgraph
    densities = [0] * (n + 1)
    for i in range(2, n + 1):
        densities[i] = v_prime[i] / e_prime[i]

    # Find the node with the max density
    max_density_node = 1
    max_density = densities[1]
    for i in range(2, n + 1):
        if densities[i] > max_density:
            max_density_node = i
            max_density = densities[i]

    return max_density
```
