def min_boundary_wall_length(buildings):
    # Sort buildings by boundary wall length in descending order
    buildings.sort(key=lambda x: x[3], reverse=True)

    # Initialize MST with the first building
    mst = [buildings[0]]
    boundary_wall_length = 0

    # Iterate through the remaining buildings
    for building in buildings[1:]:
        # Check if building can be added to MST without forming a cycle
        if not is_cycle(building, mst):
            # If building's length is less than 10% of the MST's length, add it to MST
            if building[3] < 0.1 * mst[0][3]:
                mst.append(building)
                boundary_wall_length += building[3]
            else:
                # If building's length is more than 10% of the MST's length, add it to MST and adjust boundary wall length
                mst.append(building)
                boundary_wall_length += building[3] + 0.1 * mst[0][3]

    return mst, boundary_wall_length

def is_cycle(new_building, mst):
    # Check if adding new_building creates a cycle in MST
    for building in mst:
        if is_adjacent(building, new_building):
            return True
    return False

def is_adjacent(new_building, building):
    # Check if new_building and building are adjacent
    return abs(new_building[0] - building[0]) + abs(new_building[1] - building[1]) <= new_building[3]

# Read input
