def sort_array_by_example(arr, example_arr):
    # Count occurrences of each value in the input array
    arr_count = Counter(arr)

    # Create a mapping from example_arr to its index in the sorted array
    example_map = {value: i for i, value in enumerate(sorted(example_arr, key=lambda x: arr_count[x], reverse=True))}

    # Sort arr by the indices in example_map
    return [example_map[value] for value in arr]
