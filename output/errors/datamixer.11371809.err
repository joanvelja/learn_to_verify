def process_sequence(sequence):
    squared = [x**2 if x > 0 else x for x in sequence]
    multiplied_by_3 = [x * 3 if (i+1) % 3 == 0 else x for i, x in enumerate(squared)]
    multiplied_by_minus_one = [x * -1 if (i+1) % 5 == 0 else x for i, x in enumerate(multiplied_by_3)]
    return sum(multiplied_by_minus_one)
```
