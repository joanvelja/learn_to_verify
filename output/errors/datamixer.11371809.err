import math

def derivative(x, b, c):
    return 2 * x + b - c * math.cos(x) / math.sin(x) ** 2

def find_min(b, c):
    # Evaluate at endpoints
    left = derivative(0, b, c)
    right = derivative(math.pi / 2, b, c)

    # Find critical points
    critical_points = [x for x in range(1, int(math.pi / 2) + 1) if derivative(x, b, c) == 0]

    # Combine points
    points = [left] + [derivative(x, b, c) for x in critical_points] + [right]

    # Find minimum
    return min(points)

T = int(input())
for _ in range(T):
    b, c = map(float, input().split())
    print(find_min(b, c))
