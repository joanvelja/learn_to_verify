from math import factorial
from collections import defaultdict

def mod(n):
    return n % 998244353

def binom(n, k):
    return factorial(n) * pow(factorial(k), mod(-1), 998244353) * pow(factorial(n - k), mod(-1), 998244353) % 998244353

def solve(N, M):
    k = 0
    for i in range(1, N + 1):
        if i % M == 0:
            k += 1
    ans = k
    ways = binom(k, k)
    return ans, ways

T = int(input())
for _ in range(T):
    N, M = map(int, input().split())
    ans, ways = solve(N, M)
    print(ans, ways)
