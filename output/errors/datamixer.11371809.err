    def calculate_score(player):
        score = 0
        # Calculate points for each statistic
        for key in player:
            if key != 'name':
                score += player[key]
        # Calculate longest kill streak points
        streak = 0
        max_streak = 0
        for key in player:
            if key == 'kills':
                streak += 1
                max_streak = max(max_streak, streak)
            elif key == 'assists':
                score += 50 * player[key]
            elif key == 'damage_done':
                score += 0.5 * player[key]
            elif key == 'healing_done':
                score += 1 * player[key]
            elif key == 'longest_kill_streak':
                streak = player[key]
                max_streak = max(max_streak, streak)
        score += 500 * min(5, max_streak)
        return score

    # Calculate scores for each player
    scores = []
    for player in players:
        scores.append(calculate_score(player))

    # Sort players by score in descending order
    sorted_players = sorted(players, key=lambda x: calculate_score(x), reverse=True)

    # Return player names
    return [player['name'] for player in sorted_players]
```
