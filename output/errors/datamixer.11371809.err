<code>
```python
def carFleet(target, position, speed):
    # Sort by position
    cars = sorted(zip(position, speed), reverse=True)
    fleets = []
    for pos, spd in cars:
        # Check if this car is part of an existing fleet
        if not fleets:
            fleets.append((pos, spd))
        else:
            last_pos, last_spd = fleets[-1]
            # If this car is behind the last one and going faster, they form a new fleet
            if pos < last_pos and spd > last_spd:
                fleets.append((pos, spd))
            else:
                # Otherwise, update the last fleet's position and speed
                fleets[-1] = (pos, spd)
    return len(fleets)
```
</code>

