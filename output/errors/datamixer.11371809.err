        self.val = val
        self.left = left
        self.right = right

def convert_to_tree(arr):
    if not arr:
        return None
    mid = len(arr) // 2
    root = TreeNode(arr[mid])
    root.left = convert_to_tree(arr[:mid])
    root.right = convert_to_tree(arr[mid + 1:])
    return root

def in_order_traversal(root):
    if not root:
        return []
    if root.val == -1:  # Sentinel node
        return [root.val] + in_order_traversal(root.left) + in_order_traversal(root.right)
    return in_order_traversal(root.left) + [root.val] + in_order_traversal(root.right)

def convert_to_breadth_first_order(arr):
    root = convert_to_tree(arr)
    queue = deque([root])
    result = []
    while queue:
        node = queue.popleft()
        if node.val == -1:  # Sentinel node
            result.append(node.val)
        else:
            result.append(node.val)
            if node.left:
                queue.append(node.left)
            if node.right:
                queue.append(node.right)
    return result
```
