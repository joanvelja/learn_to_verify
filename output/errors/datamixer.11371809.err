def execute(code):
    if len(code) > 100:
        return factorial(len(code))
    # Split code into array of commands
    commands = code.split()
    # Initialize grid and position of robot
    grid = [[' ' for _ in range(10)] for _ in range(10)]
    x, y = 5, 5
    direction = 'right'
    # Initialize steps taken
    steps = 0
    # Loop through each command
    for command in commands:
        # Execute command
        if command == 'F':
            # Move forward
            if direction == 'right':
                x += 1
            elif direction == 'left':
                x -= 1
            elif direction == 'up':
                y -= 1
            elif direction == 'down':
                y += 1
            # Update steps taken
            steps += 1
        elif command == 'L':
            # Turn left
            if direction == 'right':
                direction = 'up'
            elif direction == 'left':
                direction = 'down'
            elif direction == 'up':
                direction = 'left'
            elif direction == 'down':
                direction = 'right'
        elif command == 'R':
            # Turn right
            if direction == 'right':
                direction = 'down'
            elif direction == 'left':
                direction = 'up'
            elif direction == 'up':
                direction = 'right'
            elif direction == 'down':
                direction = 'left'
        elif command[0] == 'L' and command[1:].isdigit():
            # Execute left command n times
            for _ in range(int(command[1:])):
                if direction == 'right':
                    direction = 'up'
                elif direction == 'left':
                    direction = 'down'
                elif direction == 'up':
                    direction = 'left'
                elif direction == 'down':
                    direction = 'right'
        elif command[0] == 'R' and command[1:].isdigit():
            # Execute right command n times
            for _ in range(int(command[1:])):
                if direction == 'right':
                    direction = 'down'
                elif direction == 'left':
                    direction = 'up'
                elif direction == 'up':
                    direction = 'right'
                elif direction == 'down':
                    direction = 'left'
        elif command[0] == 'F' and command[1:].isdigit():
            # Execute forward command n times
            for _ in range(int(command[1:])):
                # Move forward
                if direction == 'right':
                    x += 1
                elif direction == 'left':
                    x -= 1
                elif direction == 'up':
                    y -= 1
                elif direction == 'down':
                    y += 1
                # Update steps taken
                steps += 1
        # Check if robot has completed all its movements
        if steps >= len(code):
            break
    # Return grid as string
    return '\n'.join(''.join(row) for row in grid)
```
