def robot_position(t):
    # Calculate the number of complete cycles and the remaining moves
    cycles, remainder = divmod(t, 4)
    # Each cycle moves 4 units in one direction
    x = cycles * 4
    # Determine the direction based on the remainder
    if remainder == 0:
        y = 0
    elif remainder == 1:
        y = -1
    elif remainder == 2:
        y = 1
    else:
        y = -1
    # Adjust for negative coordinates
    if x < 0:
        x = -x
    if y < 0:
        y = -y
    return (x, y)
