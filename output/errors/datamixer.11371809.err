def golomb(n):
    if n == 1:
        return 1
    elif n == 2:
        return 2
    elif n == 3:
        return 2
    elif n == 4:
        return 3
    elif n == 5:
        return 3
    elif n == 6:
        return 4
    elif n == 7:
        return 4
    else:
        return 1 + golomb(n - golomb(golomb(n - 1)))

def sum_of_squares(L, R):
    golomb_seq = [0] * (R + 1)
    for i in range(1, R + 1):
        golomb_seq[i] = golomb(i)
    return sum([golomb_seq[i] ** 2 for i in range(L, R + 1)]) % (10 ** 9 + 7)

T = int(input())
for _ in range(T):
    L, R = map(int, input().split())
    print(sum_of_squares(L, R))
```
