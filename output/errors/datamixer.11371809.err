def minimum_balloons_needed(R, G, B, K):
    counts = [R, G, B]
    counts.sort()
    total_balloons = sum(counts)
    if total_balloons < K:
        return -1  # Not enough balloons to satisfy the condition
    excess_balloons = total_balloons - K
    for i in range(3):
        if counts[i] >= excess_balloons:
            return excess_balloons
        else:
            excess_balloons -= counts[i]
    return -1  # Unreachable, but included for completeness

