Here's the solution:

```python
from collections import deque

def interpret(code):
    stack = deque()
    output = []

    def add():
        stack.append(stack.pop() + stack.pop())

    def sub():
        stack.append(stack.pop() - stack.pop())

    def mul():
        stack.append(stack.pop() + ord(stack.pop()))

    def push():
        stack.append(0)

    def pop():
        if len(stack) > 0:
            stack.pop()

    def skip():
        if len(stack) > 0 and stack[-1] == 0:
            return True
        return False

    def jump():
        if len(stack) > 0 and stack[-1] != 0:
            return True
        return False

    for char in code:
        if char == '^':
            pop()
        elif char == '!':
            push()
        elif char == '+':
            add()
        elif char == '-':
            sub()
        elif char == '*':
            mul()
        elif char == '[':
            if skip():
                continue
        elif char == ']':
            if jump():
                continue

    while len(stack) > 0:
        output.append(chr(stack.popleft()))

    return ''.join(output)
```
</reasoning>

