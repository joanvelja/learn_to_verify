def rectangle_area(rectangles):
    area = 0
    overlap = Counter()
    for i in range(len(rectangles)):
        x1, y1, x2, y2 = rectangles[i]
        for j in range(i + 1, len(rectangles)):
            x3, y3, x4, y4 = rectangles[j]
            if x1 < x4 and x2 > x3 and y1 < y4 and y2 > y3:
                overlap[(x1, y1), (x2, y2)] += 1
                overlap[(x3, y3), (x4, y4)] += 1
    for (x1, y1), (x2, y2), count in overlap.items():
        if count == 2:
            area += (x2 - x1) * (y2 - y1)
    return area % (10**9 + 7)
