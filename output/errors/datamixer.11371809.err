```python
from itertools import permutations

def is_palindrome(s):
    return s == s[::-1]

def count_palindrome_pairs(strings):
    count = 0
    for i in range(len(strings)):
        for j in range(i+1, len(strings)):
            concat = strings[i] + strings[j]
            for perm in permutations(concat):
                if is_palindrome(''.join(perm)):
                    count += 1
    return count

# Input
N = int(input())
strings = [input() for _ in range(N)]

# Output
print(count_palindrome_pairs(strings))
```
