    pattern = r'^[+-]?((0[bB][01]+)|([0x][0-9a-f]+)|([0o][0-7]+)|([0-9]+))$'

    # Match the input against the pattern
    match = re.match(pattern, input_str)

    if match:
        # Parse the input based on the matched group
        if match.group(1):
            return int(match.group(1), 2) if match.group(1).startswith('0b') else int(match.group(1), 16) if match.group(1).startswith('0x') else int(match.group(1), 8) if match.group(1).startswith('0o') else int(match.group(1))
        else:
            return int(match.group(2), 10)
    else:
