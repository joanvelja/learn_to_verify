def calc_fuel(ingots)
  states = { 0 => { lava: 0, blaze_rod: 0, coal: 0, wood: 0, stick: 0 } }

  1.upto(ingots) do |i|
    next_states = {}

    states.each do |fuel, ingots_needed|
      fuel.each do |fuel_option, ingots_needed_for_fuel|
        next_states[fuel_option] ||= { lava: 0, blaze_rod: 0, coal: 0, wood: 0, stick: 0 }
        next_states[fuel_option][fuel_option] += 1
        next_states[fuel_option][:stick] += 1 if fuel_option == :stick
        next_states[fuel_option][:lava] += 1 if fuel_option == :lava
        next_states[fuel_option][:blaze_rod] += 1 if fuel_option == :blaze_rod
        next_states[fuel_option][:coal] += 1 if fuel_option == :coal
        next_states[fuel_option][:wood] += 1 if fuel_option == :wood

