def fib_mod_8(n):
    if n <= 1:
        return n
    a, b = 0, 1
    for _ in range(n - 1):
        a, b = b, (a + b) % 8
    return b

def flip_rectangle(matrix, x1, y1, x2, y2):
    for i in range(x1, x2 + 1):
        for j in range(y1, y2 + 1):
            matrix[i][j] = fib_mod_8(matrix[i][j])

def process_queries(matrix, queries):
    for query in queries:
        x1, y1, x2, y2 = query
        flip_rectangle(matrix, x1 - 1, y1 - 1, x2 - 1, y2 - 1)

def print_matrix(matrix):
    for row in matrix:
        print("".join(str(bit) for bit in row))

if __name__ == "__main__":
    N, M = map(int, input().split())
    matrix = [[int(bit) for bit in input()] for _ in range(N)]
    Q = int(input())
    queries = [list(map(int, input().split())) for _ in range(Q)]
    process_queries(matrix, queries)
    print_matrix(matrix)
