```python
def max_three_block_palindrome(a):
    # Count the occurrences of each element
    counts = {}
    for i in a:
        if i in counts:
            counts[i] += 1
        else:
            counts[i] = 1

    # Initialize the maximum length
    max_length = 0

    # Iterate over the counts
    for count in counts.values():
        # If there's only one count, we can't build a three-block palindrome
        if count < 3:
            continue

        # Build a palindrome using the count of the first and last elements
        # and the count of the second element in the middle
        length = count * 2 - 1
        max_length = max(max_length, length)

    return max_length
