        next_states[fuel_option][:lava] -= 1 if fuel_option == :lava
        next_states[fuel_option][:blaze_rod] -= 1 if fuel_option == :blaze_rod
        next_states[fuel_option][:coal] -= 1 if fuel_option == :coal
        next_states[fuel_option][:wood] -= 1 if fuel_option == :wood

        next_states[fuel_option][:stick] += 1 if fuel_option == :stick
        next_states[fuel_option][:lava] += 1 if fuel_option == :lava
        next_states[fuel_option][:blaze_rod] += 1 if fuel_option == :blaze_rod
        next_states[fuel_option][:coal] += 1 if fuel_option == :coal
        next_states[fuel_option][:wood] += 1 if fuel_option == :wood

