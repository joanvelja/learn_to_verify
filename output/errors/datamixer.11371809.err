import math

def divisors(n):
    # Prime factorization
    factors = []
    for i in range(2, int(math.sqrt(n)) + 1):
        while n % i == 0:
            factors.append(i)
            n //= i
    if n > 1:
        factors.append(n)

    # Unique combinations
    from itertools import combinations
    return len(factors) + sum(len(list(combinations(factors, r))) for r in range(len(factors) + 1))
```
