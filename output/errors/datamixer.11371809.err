```python
def partition(n: int) -> List[List[int]]:
    if n == 0:
        return [[]]
    elif n == 1:
        return [[1]]
    else:
        partitions = []
        for i in range(n, 0, -1):
            for p in partition(n - i):
                partitions.append([i] + p)
        return partitions

def prod(partitions: List[List[int]]) -> List[int]:
    products = []
    for p in partitions:
        product = 1
        for x in p:
            product *= x
        products.append(product)
    return products

def range_avg_median(products: List[int]) -> str:
    products.sort()
    unique_products = list(set(products))
    avg = sum(unique_products) / len(unique_products)
    median = 0
    if len(unique_products) % 2 == 0:
        median = (unique_products[len(unique_products) // 2 - 1] +
                 unique_products[len(unique_products) // 2]) / 2
    else:
        median = unique_products[len(unique_products) // 2]
    return f"Range: {max(products) - min(products)}, Average: {avg:.2f}, Median: {median:.2f}"

def main():
    n = int(input())
    partitions = partition(n)
    products = prod(partitions)
    result = range_avg_median(products)
    print(result)

if __name__ == "__main__":
    main()
```
