    if hex_value == 'DEAD':
        return [0, 0]
    elif 'DE' in hex_value:
        return [int(hex_value.replace('DE', '')), 0]
    else:
        return [0, int(hex_value, 16)]

def coffee_limits(h):
    hex_value = health_to_hex(h)
    return calculate_limits(hex_value)
```

