def hamming_distance(a, b):
    bin_a = bin(a)[2:]
    bin_b = bin(b)[2:]
    max_len = max(len(bin_a), len(bin_b))
    bin_a = bin_a.zfill(max_len)
    bin_b = bin_b.zfill(max_len)
    hamming_dist = sum(1 for i in range(max_len) if bin_a[i] != bin_b[i])
    return round(hamming_dist, 5)
