<code>
def shortest_paths(n, m, x1, y1, x2, y2):
    # Create a grid to store the number of paths
    grid = [[0 for _ in range(m)] for _ in range(n)]

    # Fill the grid using dynamic programming
    for i in range(n):
        for j in range(m):
            if i == 0 and j == 0:
                grid[i][j] = 1
            elif i == 0:
                grid[i][j] = grid[i][j - 1]
            elif j == 0:
                grid[i][j] = grid[i - 1][j]
            else:
                grid[i][j] = grid[i - 1][j] + grid[i][j - 1]

    # Calculate the number of paths from A to C and C to B
    num_paths = grid[n - 1][m - 1]

    # Calculate the number of paths that pass through X or Y
    num_paths_through_X = 0
    for i in range(n):
        for j in range(m):
            if i == x1 and j == y1 or i == x2 and j == y2:
                num_paths_through_X += grid[i][j]

    # Return the number of valid paths
    return (num_paths - num_paths_through_X) % 998244353

# Read input
T = int(input())
for _ in range(T):
    n, m, x1, y1, x2, y2 = map(int, input().split())

# Call the function and print the result
print(shortest_paths(n, m, x1, y1, x2, y2))
