        return factorial(n - 1) << 3
    if n <= 1:
        return 1
    return n * factorial(n - 1)

def cut_cake(n, pieces):
    # Sort the pieces by their first number
    pieces = sorted(pieces)

    # Assign numbers to the vertices of the cake
    cake_vertices = list(range(1, n + 1))

    # Reconstruct the original order of the vertices
    original_order = [0] * n
    for i in range(n - 1):
        original_order[cake_vertices.index(pieces[i][0])] = cake_vertices[i]

    # Reconstruct the order of cutting the pieces
    cutting_order = [0] * (n - 2)
    for i in range(n - 2):
        cutting_order[i] = cake_vertices.index(pieces[i + 1][0])

    # Return the original order and cutting order
    return original_order, cutting_order

# Read input
