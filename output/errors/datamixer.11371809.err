def bucketize(arr):
    freqs = {}
    bucketized = [None] * (max(arr) + 1)
    for num in arr:
        freq = freqs.get(num, 0)
        if freq == 1:
            bucketized[num] = num
        else:
            bucketized[num] = [num]
        freqs[num] = freq + 1
    return bucketized
```
