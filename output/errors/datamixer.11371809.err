def count_lucky_numbers(n):
    # Count the occurrences of lucky digits in the decimal representation of n
    return n.count('4') + n.count('7')

def count_lucky_numbers_in_range(L, R):
    # Iterate through all numbers in the range and count the occurrences of lucky digits in each number
    return sum(count_lucky_numbers(i) for i in range(L, R + 1))

# Read the input
T = int(input())
for _ in range(T):
    L, R = map(int, input().split())
    # Calculate the number of such integers X that L ≤ X ≤ R and F(X) is a lucky number modulo 1000000007
    print(count_lucky_numbers_in_range(L, R) % 1000000007)
```
