from itertools import permutations

def rearranger(k, *numbers):
    def is_divisible(n):
        return n % k == 0

    def min_number(n):
        return int(''.join(map(str, n)))

    def get_permutations(nums):
        for perm in permutations(nums):
            yield perm

    def find_min_number(nums):
        perms = get_permutations(nums)
        perms = filter(is_divisible, perms)
        perms = map(min_number, perms)
        return min(perms, default=None)

    min_num = find_min_number(numbers)
    if min_num is None:
        return "There is no possible rearrangement"
    elif sorted(numbers) == numbers:
        return "Rearrangement: " + ', '.join(map(str, numbers))
    else:
        return f"Rearrangement: {', '.join(map(str, sorted(numbers)))} generates: {min_num} divisible by {k}"
