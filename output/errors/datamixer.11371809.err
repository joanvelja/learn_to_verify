import base64

def encode(ysmm):
    if not isinstance(ysmm, str):
        return "Invalid"
    ysmm = ysmm.lower()
    code1 = "".join([str(ysmm[i:i+2]) for i in range(0, len(ysmm), 2)])
    code1 = int(code1, 16)
    code2 = code1 % 10
    code1 //= 10
    code2 *= 10
    code1 += code2
    return base64.b64encode(str(code1).encode()).decode()

def decode(ysmm):
    if not isinstance(ysmm, str):
        return "Invalid"
    ysmm = ysmm.lower()
    ysmm = base64.b64decode(ysmm.encode()).decode()
    code1 = int(ysmm)
    code1 *= 10
    code2 = code1 % 10
    code1 //= 10
    code1 -= code2
    return "".join([chr(int(code1[i:i+2], 16)) for i in range(0, len(code1), 2)])

# Test cases
print(encode("adfly")) # Output: "...
