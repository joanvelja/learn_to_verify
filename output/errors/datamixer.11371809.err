#include <iostream>
#include <vector>
#include <algorithm>

class MajorityChecker {
public:
    MajorityChecker(const std::vector<int>& arr) : arr(arr) {}

    int query(int left, int right, int threshold) {
        int majorityElement = findMajority(arr.begin() + left, arr.begin() + right + 1);
        if (count(arr.begin() + left, arr.begin() + right + 1, majorityElement) >= threshold)
            return majorityElement;
        else
            return -1;
    }

private:
    std::vector<int> arr;

    int findMajority(const std::vector<int>::iterator& begin,
                     const std::vector<int>::iterator& end) {
        int majorityElement = *begin;
        int majorityCount = 1;

        for (auto it = begin + 1; it != end; ++it) {
            if (*it == majorityElement)
                majorityCount++;
            else if (majorityCount == 0) {
                majorityElement = *it;
                majorityCount = 1;
            } else
                majorityCount--;
        }

        return majorityElement;
    }
};

int main() {
    std::vector<int> arr = {1, 1, 2, 2, 1, 1};
    MajorityChecker mc(arr);
    std::cout << "Majority: " << mc.query(0, 5, 4) << std::endl; // Returns 1
    std::cout << "Majority: " << mc.query(0, 3, 3) << std::endl; // Returns -1
    std::cout << "Majority: " << mc.query(2, 3, 2) << std::endl; // Returns 2

    return 0;
}
```

