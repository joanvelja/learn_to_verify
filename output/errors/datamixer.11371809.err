def dollar_to_speech(dollar):
    # Check if the input is negative
    if dollar.startswith('-'):
        return 'No negative numbers are allowed!'

    # Convert the dollar value to an integer
    dollar = int(dollar.replace('$', ''))

    # Handle zero dollars
    if dollar == 0:
        return '0 dollars.'

    # Convert dollars to words
    dollars = dollar // 100  # integer division to get the number of dollars
    cents = dollar % 100  # remainder to get the cents

    # Convert cents to words
    if cents == 0:
        return f"{dollars} dollars."
    else:
        return f"{dollars} dollars and {cents} cents."

```
