def count_strings(s):
    counts = {'c': 0, 'k': 0}
    for char in s:
        if char == 'c':
            counts['c'] += 1
        elif char == 'k':
            counts['k'] += 1

    if 'c' in counts or 'k' in counts:
        return 0

    return (counts['c'] + 1) * (counts['k'] + 1) % (10**9+7)
```
