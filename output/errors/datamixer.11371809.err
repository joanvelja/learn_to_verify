<code>
import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int t = sc.nextInt();
        while (t-- > 0) {
            int n = sc.nextInt();
            int k = sc.nextInt();
            int[] a = new int[n];
            for (int i = 0; i < n; i++) {
                a[i] = sc.nextInt();
            }
            List<List<Integer>> graph = new ArrayList<>();
            for (int i = 0; i < n; i++) {
                graph.add(new ArrayList<>());
            }
            for (int i = 1; i < n; i++) {
                int u = sc.nextInt() - 1;
                int v = sc.nextInt() - 1;
                graph.get(u).add(v);
                graph.get(v).add(u);
            }
            int[] visited = new int[n];
            Queue<Integer> queue = new LinkedList<>();
            queue.add(0);
            visited[0] = 1;
            int max = Integer.MIN_VALUE;
            while (!queue.isEmpty()) {
                int u = queue.poll();
                max = Math.max(max, a[u]);
                for (int v : graph.get(u)) {
                    if (visited[v] == 0) {
                        queue.add(v);
                        visited[v] = 1;
                    }
                }
            }
            List<Integer> leafNodes = new ArrayList<>();
            for (int i = 0; i < n; i++) {
                if (visited[i] == 0) {
                    leafNodes.add(i);
                }
            }
            int[] choices = new int[leafNodes.size()];
            for (int i = 0; i < leafNodes.size(); i++) {
                int x = leafNodes.get(i);
                int low = (int) Math.pow(2, a[x] - 1);
                int high = (int) Math.pow(2, a[x]);
                int sum = 0;
                for (int j = x; j < n; j++) {
                    sum += a[j];
                }
                if (sum >= low && sum < high) {
                    choices[i] = sum;
                } else {
                    choices[i] = -1;
                }
            }
            int ans = -1;
            for (int i = 0; i < choices.length; i++) {
                if (choices[i] != -1) {
                    ans = choices[i];
                    break;
                }
            }
            if (ans == k) {
                System.out.println("YES");
            } else {
                System.out.println("NO");
            }
        }
    }
}
