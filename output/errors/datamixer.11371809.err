import random

def poisson_distribution(lambda_value):
    return random.poisson(lambda_value)

def uniform_distribution(min_value, max_value):
    return random.uniform(min_value, max_value)

def calculate_average_population(villages):
    total_population = sum(villages)
    return total_population / len(villages)

def determine_distribution(villages):
    average_population = calculate_average_population(villages)
    calculated_lambda = average_population

    observed_lambda = []
    for village in villages:
        if village < 1 or village > 1000:
            raise ValueError("Invalid village population")
        observed_lambda.append(village)

    if all(abs(observed_lambda[i] - calculated_lambda) < 1 for i in range(len(observed_lambda))):
        return "poisson"
    else:
        return "uniform"

def main():
    villages = [random.randint(1, 1000) for _ in range(10)]

    print("Villages' distributions:")
    for village in villages:
        print(f"Village {village}: {determine_distribution([village])}")

if __name__ == "__main__":
    main()
```
</code>

